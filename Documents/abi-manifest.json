{
  "schema": 1,
  "description": "The binary interfaces of Tala: what one build of the compiler promises another program or another stage, by name and by number. `go run ./helpers/cmd/verify-abi` compares every entry with the sources.",
  "frontend_library": {
    "abi_version": 2,
    "header": "Talac/Headers/Progmasoft/Tala/Frontend.h",
    "libraries": {
      "windows": "tala-frontend.dll",
      "macos": "libtala-frontend.dylib",
      "linux": "libtala-frontend.so"
    },
    "symbols": [
      "tala_frontend_abi_version",
      "tala_frontend_compile_source",
      "tala_frontend_execute",
      "tala_frontend_fuzz_compile",
      "tala_frontend_fuzz_syntax",
      "tala_frontend_initialize",
      "tala_frontend_shutdown"
    ],
    "output_kinds": {
      "TALA_FRONTEND_CORE_WIRE": 0,
      "TALA_FRONTEND_PROJECT_SOURCE_LIST": 1,
      "TALA_FRONTEND_DIAGNOSTIC_WIRE": 2,
      "TALA_FRONTEND_ERROR_TEXT": 3,
      "TALA_FRONTEND_COREPREP_WIRE": 4,
      "TALA_FRONTEND_WARNING_TEXT": 5
    },
    "statuses": {
      "TALA_FRONTEND_OK": 0,
      "TALA_FRONTEND_DIAGNOSTICS": 1,
      "TALA_FRONTEND_INVALID_REQUEST": 2,
      "TALA_FRONTEND_INTERNAL_ERROR": 3,
      "TALA_FRONTEND_OUTPUT_REJECTED": 4
    }
  },
  "runtime": {
    "ownership": {
      "abi_version": 2,
      "header": "Talac/Headers/Progmasoft/Tala/Runtime/AARC.h",
      "symbols": [
        "tala_aarc_abi_version",
        "tala_aarc_allocate",
        "tala_aarc_copy_unowned",
        "tala_aarc_copy_weak",
        "tala_aarc_is_exact_type",
        "tala_aarc_load_unowned",
        "tala_aarc_lock_weak",
        "tala_aarc_make_unowned",
        "tala_aarc_make_weak",
        "tala_aarc_release_strong",
        "tala_aarc_release_unowned",
        "tala_aarc_release_weak",
        "tala_aarc_retain_strong",
        "tala_aarc_string_literal"
      ],
      "type_metadata": [
        "abiVersion",
        "flags",
        "typeIdentity",
        "instanceSize",
        "instanceAlignment",
        "destructor",
        "typeName"
      ]
    },
    "text": {
      "header": "Talac/Headers/Progmasoft/Tala/Runtime/Text.h",
      "symbols": [
        "tala_console_write",
        "tala_text_concat",
        "tala_text_equals",
        "tala_text_format_char",
        "tala_text_format_floating",
        "tala_text_format_signed",
        "tala_text_format_string",
        "tala_text_format_unsigned",
        "tala_text_from_bool",
        "tala_text_from_char",
        "tala_text_from_signed",
        "tala_text_from_unsigned",
        "tala_text_newline"
      ],
      "constants": {
        "TALA_TEXT_FLAG_LEFT": 1,
        "TALA_TEXT_FLAG_ZERO": 2,
        "TALA_TEXT_FLAG_PLUS": 4,
        "TALA_TEXT_FLAG_SPACE": 8,
        "TALA_TEXT_FLAG_ALTERNATE": 16,
        "TALA_TEXT_FLAG_GROUP": 32,
        "TALA_TEXT_FLAG_HEXADECIMAL": 64,
        "TALA_TEXT_ABSENT": -1,
        "TALA_CONSOLE_OUTPUT": 0,
        "TALA_CONSOLE_OUTPUT_LINE": 1,
        "TALA_CONSOLE_ERROR": 2,
        "TALA_CONSOLE_ERROR_LINE": 3
      }
    }
  },
  "wire_formats": [
    { "name": "Core", "magic": "TACR", "version": 10 },
    { "name": "CorePrep", "magic": "TACP", "version": 8 },
    { "name": "Xpp", "magic": "TAPP", "version": 7 },
    { "name": "Xmm", "magic": "TAMM", "version": 7 }
  ],
  "executable": {
    "extensions": {
      "windows": ".exe",
      "linux": "",
      "macos": ""
    },
    "source_entry": "a parameterless `public static void Main()`",
    "entry_symbols": {
      "windows": "mainCRTStartup",
      "linux": "main",
      "macos": "main"
    },
    "object_formats": {
      "windows": "COFF",
      "linux": "ELF",
      "macos": "Mach-O"
    },
    "native_linking": {
      "windows": {
        "linker": "lld-link",
        "runtime_library": "tala-runtime.lib",
        "system_imports": {
          "KERNEL32.dll": [
            "GetConsoleMode",
            "GetProcessHeap",
            "GetStdHandle",
            "HeapAlloc",
            "HeapFree",
            "WriteConsoleW",
            "WriteFile"
          ]
        }
      },
      "linux": {
        "linker": "cc",
        "runtime_library": "libtala-runtime.a"
      },
      "macos": {
        "linker": "cc",
        "runtime_library": "libtala-runtime.a"
      }
    }
  }
}
