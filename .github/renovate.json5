// Renovate proposes the version updates of this repository. Dependabot keeps
// its alerts and its security updates, which are repository settings; its
// version updates are off, so that two bots do not open the same pull
// request.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],

  timezone: "Europe/Istanbul",
  // Once a week, before the working day.
  schedule: ["before 6am on monday"],

  // A release is taken a week after it is published: one that turns out to
  // be broken or malicious is usually withdrawn within days.
  minimumReleaseAge: "7 days",

  // A pull request is rebased when it conflicts, not whenever the default
  // branch moves. Every rebase runs the whole test matrix again, and
  // rebasing every open update after every merge filled the runner queue.
  rebaseWhen: "conflicted",
  prConcurrentLimit: 2,
  prHourlyLimit: 2,

  // One issue lists what is pending, so an update need not be a pull request
  // to be seen.
  dependencyDashboard: true,

  // Security fixes come from Dependabot security updates. Renovate does not
  // open its own for the same advisory.
  vulnerabilityAlerts: { enabled: false },

  // The vendored test framework has its own repository and its own updates.
  ignorePaths: ["third_party/**", "**/node_modules/**"],

  // What Dependabot watched here, and nothing more for now. The Haskell
  // packages bound each other and the compiler on purpose and are updated by
  // hand.
  enabledManagers: ["github-actions", "bazel-module", "gomod"],

  packageRules: [
    // One pull request for each kind of dependency.
    { matchManagers: ["github-actions"], groupName: "GitHub Actions" },
    { matchManagers: ["bazel-module"], groupName: "Bazel modules" },
    { matchManagers: ["gomod"], groupName: "Go helpers" },
  ],
}
