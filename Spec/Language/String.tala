-- Tala language design examples: Strings and Comments
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 2. Single-line normal comment
-- Demonstrates: Example:

-- normal comment
int value = 10;

-- ============================================================================
-- Example 2: 3. Single-line documentation comment
-- Demonstrates: Example:

--| User record.
data User {
    String Name,
}

-- ============================================================================
-- Example 3: 3. Single-line documentation comment
-- Demonstrates: Conceptually:

--| yorum

-- ============================================================================
-- Example 4: 3. Single-line documentation comment
-- Demonstrates: corresponds to documentation attribute text equivalent to:

[Document("yorum")]

-- ============================================================================
-- Example 5: 4. Single-line namespace documentation comment
-- Demonstrates: Example:

--! Application model namespace.

-- ============================================================================
-- Example 6: 4. Single-line namespace documentation comment
-- Demonstrates: Conceptually:

--! yorum

-- ============================================================================
-- Example 7: 4. Single-line namespace documentation comment
-- Demonstrates: corresponds to documentation attribute text equivalent to:

#[Document("yorum")]

-- ============================================================================
-- Example 8: 5. Long normal comment
-- Demonstrates: A long normal comment uses long-bracket syntax:

--[[
normal
long comment
]]

-- ============================================================================
-- Example 9: 6. Long documentation comment
-- Demonstrates: Example:

--[[|
User record.
Used by the application model.
]]
data User {
    String Name,
}

-- ============================================================================
-- Example 10: 6. Long documentation comment
-- Demonstrates: Conceptually:

--[[|
yorum
yorum
]]

-- ============================================================================
-- Example 11: 6. Long documentation comment
-- Demonstrates: corresponds to documentation text equivalent to:

[Document("yorum%nyorum")]

-- ============================================================================
-- Example 12: 7. Long namespace documentation comment
-- Demonstrates: Example:

--[[!
Application models.
Public model declarations live here.
]]

-- ============================================================================
-- Example 13: 7. Long namespace documentation comment
-- Demonstrates: Conceptually:

--[[!
yorum
yorum
]]

-- ============================================================================
-- Example 14: 7. Long namespace documentation comment
-- Demonstrates: corresponds to documentation text equivalent to:

#[Document("yorum%nyorum")]

-- ============================================================================
-- Example 15: 8. Lua-style long delimiters
-- Demonstrates: Examples:

--[=[
normal comment containing ]]
]=]

-- ============================================================================
-- Example 16: 8. Lua-style long delimiters
-- Demonstrates: Examples:

--[==[
normal comment containing ]]
and ]=]
]==]

-- ============================================================================
-- Example 17: 8. Lua-style long delimiters
-- Demonstrates: Example:

--[=[|
documentation
]=]

-- ============================================================================
-- Example 18: 8. Lua-style long delimiters
-- Demonstrates: Namespace documentation:

--[=[!
namespace documentation
]=]

-- ============================================================================
-- Example 19: 9. Matching delimiter rule
-- Demonstrates: Example:

String text = [==[
This ]=] is ordinary content.
This ]] is ordinary content.
]==];

-- ============================================================================
-- Example 20: 10. No nested comments
-- Demonstrates: Example:

--[[
outer

--[[
inner-looking text
]]

remaining source

-- ============================================================================
-- Example 21: 10. No nested comments
-- Demonstrates: Example:

--[=[
This text may contain ]]
without ending the comment.
]=]

-- ============================================================================
-- Example 22: 12. Multiline raw strings
-- Demonstrates: The basic form is:

String sql = [[
SELECT id, name
FROM users
WHERE active = true
]];

-- ============================================================================
-- Example 23: 13. Raw-string semantics
-- Demonstrates: Example:

String text = [[
\tHello\n
]];

-- ============================================================================
-- Example 24: 15. Multiline content
-- Demonstrates: Example:

String sql = [[
SELECT id, name
FROM users
WHERE active = true
]];

-- ============================================================================
-- Example 25: 16. First boundary newline
-- Demonstrates: Example:

String text = [[
Hello
World
]];

-- ============================================================================
-- Example 26: 17. Final boundary newline
-- Demonstrates: Example:

String text = [[
Hello
World
]];

-- ============================================================================
-- Example 27: 18. Content beginning on the opener line
-- Demonstrates: Example:

String text = [[Hello
World]];

-- ============================================================================
-- Example 28: 19. No automatic dedent
-- Demonstrates: Example:

String text = [[
    Hello
      World
]];

-- ============================================================================
-- Example 29: 20. Higher-level raw-string delimiters
-- Demonstrates: Example:

String text = [=[
This text contains ]] as ordinary content.
]=];

-- ============================================================================
-- Example 30: 20. Higher-level raw-string delimiters
-- Demonstrates: another level may be used:

String text = [==[
This text contains ]]
and also ]=]
as ordinary content.
]==];

-- ============================================================================
-- Example 31: 21. Raw string examples
-- Demonstrates: SQL:

String sql = [[
SELECT id, name
FROM users
WHERE active = true
]];

-- ============================================================================
-- Example 32: 21. Raw string examples
-- Demonstrates: Filesystem-style content:

String path = [[
C:\Users\Ada\file.txt
]];

-- ============================================================================
-- Example 33: 21. Raw string examples
-- Demonstrates: Literal escape-looking text:

String text = [[
\n
\t
\\
]];

-- ============================================================================
-- Example 34: 23. Documentation comment desugaring reference
-- Demonstrates: Declaration documentation:

--| yorum

-- ============================================================================
-- Example 35: 23. Documentation comment desugaring reference
-- Demonstrates: corresponds conceptually to:

[Document("yorum")]

-- ============================================================================
-- Example 36: 23. Documentation comment desugaring reference
-- Demonstrates: Long declaration documentation:

--[[|
yorum
yorum
]]

-- ============================================================================
-- Example 37: 23. Documentation comment desugaring reference
-- Demonstrates: corresponds conceptually to:

[Document("yorum%nyorum")]

-- ============================================================================
-- Example 38: 23. Documentation comment desugaring reference
-- Demonstrates: Namespace documentation:

--! yorum

-- ============================================================================
-- Example 39: 23. Documentation comment desugaring reference
-- Demonstrates: corresponds conceptually to:

#[Document("yorum")]

-- ============================================================================
-- Example 40: 23. Documentation comment desugaring reference
-- Demonstrates: Long namespace documentation:

--[[!
yorum
yorum
]]

-- ============================================================================
-- Example 41: 23. Documentation comment desugaring reference
-- Demonstrates: corresponds conceptually to:

#[Document("yorum%nyorum")]

-- ============================================================================
-- Example 42: 24. VALID examples
-- Demonstrates: Normal single-line comment:

-- comment
int x = 10;

-- ============================================================================
-- Example 43: 24. VALID examples
-- Demonstrates: Declaration documentation:

--| Counter value.
int count = 0;

-- ============================================================================
-- Example 44: 24. VALID examples
-- Demonstrates: Namespace documentation:

--! Networking utilities.

-- ============================================================================
-- Example 45: 24. VALID examples
-- Demonstrates: Normal long comment:

--[[
multiple
lines
]]

-- ============================================================================
-- Example 46: 24. VALID examples
-- Demonstrates: Higher-level long comment:

--[=[
contains ]]
]=]

-- ============================================================================
-- Example 47: 24. VALID examples
-- Demonstrates: Raw multiline string:

String sql = [[
SELECT *
FROM users
]];

-- ============================================================================
-- Example 48: 24. VALID examples
-- Demonstrates: Higher-level raw multiline string:

String text = [=[
contains ]]
]=];

-- ============================================================================
-- Example 49: 25. INVALID / unsupported model examples
-- Demonstrates: The following must not be interpreted as two nested comment levels:

--[[
outer
--[[
inner
]]
]]
