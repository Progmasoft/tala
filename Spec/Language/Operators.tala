-- Tala language design examples: Operators
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 2.1 Power Before Prefix
-- Demonstrates: User-defined precedence groups do not exist.

-2 ** 2

-- ============================================================================
-- Example 2: 2.1 Power Before Prefix
-- Demonstrates: is parsed as:

-(2 ** 2)

-- ============================================================================
-- Example 3: 2.1 Power Before Prefix
-- Demonstrates: Power is right-associative:

2 ** 3 ** 2

-- ============================================================================
-- Example 4: 2.1 Power Before Prefix
-- Demonstrates: is parsed as:

2 ** (3 ** 2)

-- ============================================================================
-- Example 5: 2.2 Range Placement
-- Demonstrates: is parsed as:

start + 1 ..< end - 1

-- ============================================================================
-- Example 6: 2.2 Range Placement
-- Demonstrates: is parsed as:

(start + 1) ..< (end - 1)

-- ============================================================================
-- Example 7: 2.2 Range Placement
-- Demonstrates: by binds more weakly than the range-forming operators:

1 ..< count by 2

-- ============================================================================
-- Example 8: 2.2 Range Placement
-- Demonstrates: is parsed as:

(1 ..< count) by 2

-- ============================================================================
-- Example 9: 2.3 Coalescing and Conditional Placement
-- Demonstrates: ?? binds more strongly than ?: and ? :.

a ?? b ? x : y

-- ============================================================================
-- Example 10: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

(a ?? b) ? x : y

-- ============================================================================
-- Example 11: 2.3 Coalescing and Conditional Placement
-- Demonstrates: All coalescing and conditional forms are right-associative within their groups.

a ?? b ?? c

-- ============================================================================
-- Example 12: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

a ?? (b ?? c)

-- ============================================================================
-- Example 13: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

a ?: b ?: c

-- ============================================================================
-- Example 14: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

a ?: (b ?: c)

-- ============================================================================
-- Example 15: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

a ? b : c ? d : e

-- ============================================================================
-- Example 16: 2.3 Coalescing and Conditional Placement
-- Demonstrates: is parsed as:

a ? b : (c ? d : e)

-- ============================================================================
-- Example 87: 4. Addition and String Concatenation +
-- Demonstrates: + joins two Strings. When one operand is a String and the other is not, the other is written
--   as text first and the result is a String: an integer in decimal, a bool as true or false, a char as the
--   character itself. + associates to the left.

"Hello from " + language + "!"   -- one String
"Age: " + age                    -- Age: 36
"" + true                        -- true
"a" + 1 + 2                      -- a12
1 + 2 + "a"                      -- 3a

-- ============================================================================
-- Example 88: 4. Addition and String Concatenation +
-- Demonstrates: += appends to a String variable, with the same rule for a value that is not a String.

String line = "x";

line += "y";
line += 3;   -- xy3

-- ============================================================================
-- Example 89: 4. Addition and String Concatenation +
-- Demonstrates: A String has no other arithmetic operator and no ordering operator.
-- Expected result: compile-time rejection; the INVALID marker is normative.

"a" - "b"   -- INVALID
"a" * 2     -- INVALID
"a" < "b"   -- INVALID

-- ============================================================================
-- Example 17: 5. Rounded Integer Division //
-- Demonstrates: Its result is always an integer.

7 // 2      -- 4
6 // 2      -- 3
5 // 2      -- 3
-7 // 2     -- -4
-5 // 2     -- -3

-- ============================================================================
-- Example 18: 5. Rounded Integer Division //
-- Demonstrates: Exact half values round away from zero.

1 // 2      -- 1
-1 // 2     -- -1

-- ============================================================================
-- Example 19: 5. Rounded Integer Division //
-- Demonstrates: When both operands are integer values, normal integer promotion determines the integer
--   result type.

long left = 7;
long right = 2;
auto result = left // right; -- long

-- ============================================================================
-- Example 20: 5. Rounded Integer Division //
-- Demonstrates: When floating-point operands participate, the result is still an integer. The default
--   result type is int.

auto result = 7.8 // 2.0; -- int

-- ============================================================================
-- Example 21: 6. Remainder %
-- Demonstrates: For signed values, the sign of a non-zero remainder follows the left operand.

7 % 3       -- 1
-7 % 3      -- -1
7 % -3      -- 1

-- ============================================================================
-- Example 22: 7. Power
-- Demonstrates: performs exponentiation.

2 ** 8        -- 256
2.0 ** 3      -- 8.0
9.0 ** 0.5    -- 3.0

-- ============================================================================
-- Example 23: 7. Power
-- Demonstrates: Integer exponentiation does not accept a negative exponent.
-- Expected result: compile-time rejection; the INVALID marker is normative.

2 ** -3 -- INVALID for integer exponentiation

-- ============================================================================
-- Example 24: 7. Power
-- Demonstrates: Use floating-point operands when a negative or fractional exponent is required.

2.0 ** -3 -- 0.125

-- ============================================================================
-- Example 25: 8. Increment
-- Demonstrates: The operand must be an assignable mutable numeric storage expression.
--   Tala has no decrement operator: `--` always starts a comment. Write `value -= 1`.
-- Expected result: compile-time rejection; the INVALID marker is normative.

++value;      -- VALID
items[i]++;   -- VALID

++10;         -- INVALID
(a + b)++;    -- INVALID

-- ============================================================================
-- Example 26: 8. Increment
-- Demonstrates: Prefix increment modifies the operand first and yields the new value.

int a = 10;
int b = ++a;

-- a == 11
-- b == 11

-- ============================================================================
-- Example 27: 8. Increment
-- Demonstrates: Postfix increment yields the previous value and then modifies the operand.

int a = 10;
int b = a++;

-- b == 10
-- a == 11

-- ============================================================================
-- Example 28: 9. Bitwise Operators
-- Demonstrates: ! is bitwise NOT and operates within the operand type's width.

!mask

ubyte emptyMask = 0;
ubyte fullMask = !emptyMask; -- 255

-- ============================================================================
-- Example 29: 9. Bitwise Operators
-- Demonstrates: ! is not logical NOT.
-- Expected result: compile-time rejection; the INVALID marker is normative.

!true     -- INVALID
not true  -- VALID

-- ============================================================================
-- Example 30: 11. Relational Operators
-- Demonstrates: The Relational group has associativity none.
-- Expected result: compile-time rejection; the INVALID marker is normative.

a < b < c -- INVALID

-- ============================================================================
-- Example 31: 11. Relational Operators
-- Demonstrates: Write the relationship explicitly:
-- Expected result: accepted when the referenced declarations are available.

a < b && b < c -- VALID

-- ============================================================================
-- Example 32: 12. Equality Operators
-- Demonstrates: The Equality group has associativity none.
-- Expected result: compile-time rejection; the INVALID marker is normative.

a == b == c -- INVALID

-- ============================================================================
-- Example 86: 12. Equality Operators
-- Demonstrates: Two Strings are equal when they hold the same characters in the same order. Where each is
--   kept does not matter: a String is compared by what it holds.

String first = "ab";
String second = "a" + "b";

first == second   -- true
first \= second   -- false
"a" == "ab"       -- false

-- ============================================================================
-- Example 33: 14. Null Coalescing ??
-- Demonstrates: ?? evaluates and returns its right operand only when the left operand is null.

left ?? right

-- ============================================================================
-- Example 34: 15. Truthy Coalescing ?:
-- Demonstrates: ?: evaluates and returns fallback only when left is false in Boolean context.

left ?: fallback

-- ============================================================================
-- Example 35: 16. Ternary Conditional ? :
-- Demonstrates: Exactly one result arm is evaluated after condition is tested in Boolean context.

condition ? first : second

-- ============================================================================
-- Example 36: 17.1 Simple Assignment
-- Demonstrates: Assignment is right-associative.

a = b = 10;

-- ============================================================================
-- Example 37: 17.1 Simple Assignment
-- Demonstrates: is grouped as:

a = (b = 10);

-- ============================================================================
-- Example 38: 17.2 Compound Assignment
-- Demonstrates: A direct compound-assignment operator declaration is invalid.
-- Expected result: compile-time rejection; the INVALID marker is normative.

Operator<+=> -- INVALID

-- ============================================================================
-- Example 39: 17.2 Compound Assignment
-- Demonstrates: The left-hand storage expression is evaluated exactly once.

int result = (value += 5);

-- ============================================================================
-- Example 40: 17.3 Null-Coalescing Assignment ??=
-- Demonstrates: result receives the new value of value.

target ??= fallback;

-- ============================================================================
-- Example 41: 17.3 Null-Coalescing Assignment ??=
-- Demonstrates: ??= is right-associative.

a ??= b ??= c;

-- ============================================================================
-- Example 42: 17.3 Null-Coalescing Assignment ??=
-- Demonstrates: is grouped as:

a ??= (b ??= c);

-- ============================================================================
-- Example 43: 18. Discard Statement
-- Demonstrates: is grouped as:

_ = Expr();

-- ============================================================================
-- Example 44: 18. Discard Statement
-- Demonstrates: is a special discard statement, not an ordinary assignment expression.
-- Expected result: compile-time rejection; the INVALID marker is normative.

int value = (_ = Save()); -- INVALID

-- ============================================================================
-- Example 45: 19.1 Closed Range ...
-- Demonstrates: ... forms a range that includes both boundaries.

1 ... 5

-- ============================================================================
-- Example 46: 19.2 Half-Open Range ..<
-- Demonstrates: ..< forms a range that excludes its end; this expression yields 1, 2, 3, 4.

1 ..< 5

-- ============================================================================
-- Example 47: 19.3 Descending Ranges
-- Demonstrates: If by is omitted, the default step direction is inferred from the boundaries.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

1 ... 5
-- implicit by 1

-- ============================================================================
-- Example 48: 19.3 Descending Ranges
-- Demonstrates: If by is omitted, the default step direction is inferred from the boundaries.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

5 ... 1
-- implicit by -1

-- ============================================================================
-- Example 49: 19.3 Descending Ranges
-- Demonstrates: If by is omitted, the default step direction is inferred from the boundaries.

5 ..< 1
-- 5, 4, 3, 2

-- ============================================================================
-- Example 50: 19.4 Range Type
-- Demonstrates: The declaration uses Tala template syntax:

namespace System.Ranges;

template<typename T>
public data Range {
    T Start,
    T End,
    T Step,
    bool IncludesEnd,

    public op bool Contains(_ T value);
    public op bool IsAscending();
    public op bool IsDescending();
    public op bool IsEmpty();
}

-- ============================================================================
-- Example 51: 19.4 Range Type
-- Demonstrates: Accepted category examples:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

Range<int> closed = 1 ... 10; -- CoW
Range<Integer> halfOpen = first ..< last; -- reference

-- ============================================================================
-- Example 52: 19.5 Range Iteration
-- Demonstrates: A range is iterable.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

for (int value : 1 ... 10 by 2) {
    ...
}

-- ============================================================================
-- Example 53: 20. Range Step by
-- Demonstrates: by applies an explicit step to a range.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

1 ... 10 by 2

-- ============================================================================
-- Example 54: 20. Range Step by
-- Demonstrates: 1, 3, 5, 7, 9
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

10 ... 1 by -2

-- ============================================================================
-- Example 55: 20. Range Step by
-- Demonstrates: by 0 is invalid.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

1 ... 10 by 0 -- INVALID

-- ============================================================================
-- Example 56: 20. Range Step by
-- Demonstrates: by has associativity none.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

1 ... 10 by 2 by 3 -- INVALID

-- ============================================================================
-- Example 57: 22. Type Test is
-- Demonstrates: is belongs to the relational precedence group and introduces a C#-style pattern.
--   The words and/or combine patterns and are not aliases for &&/|| outside an is pattern.
--   Pattern evaluation tests its subject exactly once. Combinators short-circuit from left to right.
--   A nominal type pattern is exact; it does not perform a conversion or a user-defined cast.

value is Target
value is > 0 and < 10
value is null or Target
value is not null
value is _

-- `not` negates the following pattern. `and` binds more tightly than `or`.
value is not null and Target
value is null or > 0 and < 10

-- These words do not become general-purpose Boolean expression operators.
left and right -- INVALID
left or right -- INVALID

-- ============================================================================
-- Example 58: 24.1 Member Access .
-- Demonstrates: . selects a named member from its left operand.

value.Member

-- ============================================================================
-- Example 59: 24.2 Indexing []
-- Demonstrates: [] performs indexing through the declaration's indexer contract.

value[index]

-- ============================================================================
-- Example 60: 24.3 Call ()
-- Demonstrates: () invokes a callable expression; call syntax is not an overloadable operator.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

value(...)

-- ============================================================================
-- Example 61: 24.4 Method Reference ::
-- Demonstrates: :: creates a method reference without invoking the selected method.

auto append = values::Append;
auto parse = Int::Parse;

-- ============================================================================
-- Example 62: 24.4 Method Reference ::
-- Demonstrates: It is distinct from normal call syntax.

values.Append(42); -- call
values::Append     -- method reference

-- ============================================================================
-- Example 63: 25. No Null-Safe Access Operators
-- Demonstrates: ?. ?[]
-- Expected result: compile-time rejection; the INVALID marker is normative.

user?.Name;    -- INVALID
items?[index]; -- INVALID

-- ============================================================================
-- Example 64: 26. Operator Declarations
-- Demonstrates: Built-in and user-defined overloadable operators use Operator<...> declarations.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public static Vector Operator<+>(
    _ Vector left,
    _ Vector right
) noexcept {
    ...
}

-- ============================================================================
-- Example 65: 27. Prefix and Postfix Operator Declarations
-- Demonstrates: Prefix and postfix forms are distinct where the operator is overloadable.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public static Counter Operator<++ prefix>(
    _ Counter value
) {
    ...
}

-- ============================================================================
-- Example 66: 27. Prefix and Postfix Operator Declarations
-- Demonstrates: Prefix and postfix forms are distinct where the operator is overloadable.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public static Counter Operator<++ postfix>(
    _ Counter value
) {
    ...
}

-- ============================================================================
-- Example 67: 31. Custom Operator Precedence
-- Demonstrates: A new binary custom operator must specify one existing precedence group and one
--   associativity.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public static Result Operator<%%>(
    _ Value left,
    _ Value right
) precedence Multiplicative associativity left {
    ...
}

-- ============================================================================
-- Example 68: 32. Operator Result Rules
-- Demonstrates: Assignments yield the value stored by the assignment.

int result = (value *= 2);

-- ============================================================================
-- Example 69: 34. -- and Comment Lexing
-- Demonstrates: Outside a String, -- starts a comment that runs to the end of the line, wherever it
--   stands. There is no decrement operator, so neither spacing nor the neighbouring token changes this.
--   The fragment below is the expression a; --b is a comment.

a --b

-- ============================================================================
-- Example 70: 34. -- and Comment Lexing
-- Demonstrates: By contrast, a space between the two signs keeps them apart: binary - followed by
--   unary -.

a - -b

-- ============================================================================
-- Example 71: 34. -- and Comment Lexing
-- Demonstrates: Parentheses do not change the rule. The comment takes the rest of the line, including
--   the closing parenthesis, so the parenthesis is never closed.
-- Expected result: compile-time rejection; the INVALID marker is normative.

(a --b) -- INVALID: the comment begins at the first --

-- The subtraction of a negated operand is written with a space:
(a - -b)

-- An attached -- is the same comment; it does not decrement:
count--; -- INVALID where a statement terminator is required: `;` is inside the comment

-- ============================================================================
-- Example 72: 35. Strings and Operator-Like Text
-- Demonstrates: Inside any String literal, -- is literal String content and never starts a comment.

String a = "-- not a comment";
String b = "a -- b";

-- ============================================================================
-- Example 73: 35. Strings and Operator-Like Text
-- Demonstrates: The same rule applies to long-bracket raw/multiline Strings.

String text = [[
a -- b
-- still string content
]];

-- ============================================================================
-- Example 74: 36.1 Power, Prefix, and Multiplication
-- Demonstrates: power binds before prefix negation, and prefix negation binds before multiplication.

-value ** 2 * scale

-- ============================================================================
-- Example 75: 36.1 Power, Prefix, and Multiplication
-- Demonstrates: groups as:

(-(value ** 2)) * scale

-- ============================================================================
-- Example 76: 36.2 Additive and Range
-- Demonstrates: groups as:

begin + 1 ..< end - 1

-- ============================================================================
-- Example 77: 36.2 Additive and Range
-- Demonstrates: groups as:

(begin + 1) ..< (end - 1)

-- ============================================================================
-- Example 78: 36.4 Logical and Null Coalescing
-- Demonstrates: groups as:

a || b ?? fallback

-- ============================================================================
-- Example 79: 36.4 Logical and Null Coalescing
-- Demonstrates: groups as:

(a || b) ?? fallback

-- ============================================================================
-- Example 80: 36.5 Null Coalescing and Ternary
-- Demonstrates: groups as:

a ?? b ? x : y

-- ============================================================================
-- Example 81: 36.5 Null Coalescing and Ternary
-- Demonstrates: groups as:

(a ?? b) ? x : y

-- ============================================================================
-- Example 82: 36.6 Assignment
-- Demonstrates: groups as:

a = b += 2;

-- ============================================================================
-- Example 83: 36.6 Assignment
-- Demonstrates: groups as:

a = (b += 2);

-- ============================================================================
-- Example 84: 38. Normative Invalid Examples
-- Demonstrates: The following forms are rejected by the normative operator rules above.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

a < b < c;             -- INVALID
a == b == c;           -- INVALID

!true;                  -- INVALID: ! is bitwise NOT

++10;                   -- INVALID
(a + b)++;              -- INVALID

2 ** -3;                -- INVALID for integer exponentiation

1 ... 10 by 0;          -- INVALID
1 ... 10 by 2 by 3;     -- INVALID

user?.Name;             -- INVALID
items?[0];              -- INVALID

Operator<+=>;           -- INVALID direct compound assignment declaration
Operator<==>;           -- INVALID equality overload

int x = (_ = Save());   -- INVALID: discard is not an expression

-- ============================================================================
-- Example 85: 39. Normative Valid Examples
-- Demonstrates: The following forms are accepted when their referenced declarations are available.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

int value = 2 ** 8;
int rounded = 7 // 2;

mask = !mask;

count++;
++index;
index -= 1;

Range<int> range = 1 ... 10 by 2;

auto append = values::Append;

user ??= CreateGuest();

int selected = condition ? 10 : 20;
int fallback = count ?: 10;
