-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public String Name {
    get {
        ...
    }

    set {
        ...
    }
}

-- ============================================================================
-- Example 142: 23. Properties
-- Demonstrates: Auto properties are supported.

public String Name { get; set; }

-- ============================================================================
-- Example 143: 23. Properties
-- Demonstrates: Auto properties may have an initializer.

public int Volume { get; set; } = 50;

