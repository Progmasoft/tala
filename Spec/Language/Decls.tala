-- Tala language design examples: Declarations
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 1.1 Case Sensitivity
-- Demonstrates: Tala name resolution is case-sensitive.

class User {}
class user {}

-- ============================================================================
-- Example 2: 1.1 Case Sensitivity
-- Demonstrates: The declarations above have different names.

void Print() {}
void print() {}

-- ============================================================================
-- Example 3: 1.2 Default Access
-- Demonstrates: There is no declaration context whose default access is private.

class User {              -- internal
    String name;          -- internal
    User(String name);    -- internal
    void Print() {}       -- internal
    class Helper {}       -- internal
}

-- ============================================================================
-- Example 4: 1.3 Access Modifiers
-- Demonstrates: protected is not a top-level access level.

public class PublicType {}
internal class NamespaceType {}
fileprivate class FileType {}

-- ============================================================================
-- Example 5: 1.3 Access Modifiers
-- Demonstrates: protected is not a top-level access level.
-- Expected result: compile-time rejection; the INVALID marker is normative.

protected class InvalidType {} -- INVALID
private class InvalidType {}   -- INVALID

-- ============================================================================
-- Example 6: 1.3 Access Modifiers
-- Demonstrates: private is declaration-scoped. An enclosing declaration does not automatically gain
--   access to a nested declaration's private members.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Outer {
    class Inner {
        private int value;
    }

    void Read(Inner inner) {
        inner.value; -- INVALID
    }
}

-- ============================================================================
-- Example 7: 1.3 Access Modifiers
-- Demonstrates: A derived AARC type may use inherited protected members.

class Base {
    protected int value;
}

class Child : Base {
    public int Read() {
        self.value
    }
}

-- ============================================================================
-- Example 8: 1.3 Access Modifiers
-- Demonstrates: A derived AARC type may use inherited protected members.

class Base {
    protected int value;
}

object Application : Base {
    public int Read() {
        self.value
    }
}

-- ============================================================================
-- Example 9: 1.4 Declaration Order
-- Demonstrates: Declaration order does not affect ordinary name visibility.

class User {
    Address address;
}

class Address {
    String city;
}

-- ============================================================================
-- Example 10: 1.4 Declaration Order
-- Demonstrates: Forward declarations do not exist.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Address; -- INVALID

-- ============================================================================
-- Example 11: 1.5 No Partial Declarations
-- Demonstrates: partial does not exist.
-- Expected result: compile-time rejection; the INVALID marker is normative.

partial class User {} -- INVALID

-- ============================================================================
-- Example 12: 1.5 No Partial Declarations
-- Demonstrates: A nominal declaration is defined in one place.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {}
class User {} -- INVALID: duplicate declaration

-- ============================================================================
-- Example 13: 3. data
-- Demonstrates: A data declaration defines a CoW value type.

data Point {
    int x;
    int y;
}

-- ============================================================================
-- Example 14: 3.1 data Inheritance
-- Demonstrates: A data declaration may inherit only from another data declaration.

data Base {
    int value;
}

data Child : Base {
    int other;
}

-- ============================================================================
-- Example 15: 3.2 final and sealed permits
-- Demonstrates: data inheritance does not create nominal subtyping and does not create dynamic

data Point final {
    int x;
    int y;
}

-- ============================================================================
-- Example 16: 3.2 final and sealed permits
-- Demonstrates: data inheritance does not create nominal subtyping and does not create dynamic

data Node sealed permits Leaf, Branch {
}

-- ============================================================================
-- Example 17: 4. data class
-- Demonstrates: A data class defines an AARC reference type with data-first declaration syntax.

data class User(String name, int age);

-- ============================================================================
-- Example 18: 4.1 Primary Constructor Properties
-- Demonstrates: Primary constructor parameters create getter-only properties.

data class User(String name, int age);

-- ============================================================================
-- Example 19: 4.1 Primary Constructor Properties
-- Demonstrates: The generated properties are public unless an access modifier is written on the

data class Session(public String id, private String token);

-- ============================================================================
-- Example 20: 4.1 Primary Constructor Properties
-- Demonstrates: Explicit final is invalid.
-- Expected result: compile-time rejection; the INVALID marker is normative.

data class User(final String name); -- INVALID

-- ============================================================================
-- Example 21: 4.3 Inheritance Control
-- Demonstrates: A data class does not automatically provide a copy member. Copying and moving are
--   language built-ins described later in this document.

data class Result(String message) final;

-- ============================================================================
-- Example 22: 4.3 Inheritance Control
-- Demonstrates: A data class does not automatically provide a copy member. Copying and moving are
--   language built-ins described later in this document.

data class Result(String message)
    sealed permits Success, Failure {
}

-- ============================================================================
-- Example 23: 5. class
-- Demonstrates: A class defines an AARC reference type.

class User {
}

-- ============================================================================
-- Example 24: 5. class
-- Demonstrates: A class may have at most one direct base class.

class Child : Base {
}

-- ============================================================================
-- Example 25: 5.1 Virtual Dispatch
-- Demonstrates: Methods are not virtual by default.

class Base {
    public virtual String Name() {
        "Base"
    }
}

-- ============================================================================
-- Example 26: 5.1 Virtual Dispatch
-- Demonstrates: An override must use override.

class Child : Base {
    public String Name() override {
        "Child"
    }
}

-- ============================================================================
-- Example 27: 5.1 Virtual Dispatch
-- Demonstrates: final override closes the override chain.

class Child : Base {
    public String Name() final override {
        "Child"
    }
}

-- ============================================================================
-- Example 28: 5.2 Type-Level final
-- Demonstrates: final follows the type name.

class User final {
}

-- ============================================================================
-- Example 29: 5.2 Type-Level final
-- Demonstrates: final follows the type name.
-- Expected result: compile-time rejection; the INVALID marker is normative.

final class User {} -- INVALID

-- ============================================================================
-- Example 30: 5.3 sealed permits
-- Demonstrates: final follows the type name.

class Shape sealed permits Circle, Rectangle : Base {
}

-- ============================================================================
-- Example 31: 5.3 sealed permits
-- Demonstrates: Only declarations listed in permits may directly derive from the sealed declaration.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Shape sealed permits Circle {
}

class Circle : Shape {}    -- VALID
class Rectangle : Shape {} -- INVALID

-- ============================================================================
-- Example 32: 5.3 sealed permits
-- Demonstrates: Duplicate entries are invalid.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Shape sealed permits Circle, Circle {} -- INVALID

-- ============================================================================
-- Example 33: 6. type
-- Demonstrates: A type declaration defines a CoW value type with literal construction.

type User {
    String name;
    int age;
}

-- ============================================================================
-- Example 34: 6.1 Literal Construction
-- Demonstrates: Explicit type form:

User user = {
    name = "Leitwolf",
    age = 26
};

-- ============================================================================
-- Example 35: 6.1 Literal Construction
-- Demonstrates: Target-explicit form:

auto user = User{
    name = "Leitwolf",
    age = 26
};

-- ============================================================================
-- Example 36: 6.1 Literal Construction
-- Demonstrates: There is no default filling of omitted fields.
-- Expected result: compile-time rejection; the INVALID marker is normative.

type User {
    String name;
    int age;
}

User user = {
    name = "Leitwolf"
}; -- INVALID: age missing

-- ============================================================================
-- Example 37: 7. Classic enum
-- Demonstrates: A classic enum is a CoW value type with payloadless numeric members.

enum Status {
    PENDING,
    APPROVED,
    REJECTED,
}

-- ============================================================================
-- Example 38: 7.1 Underlying Type
-- Demonstrates: The underlying integer type is written with =.

enum Status = byte {
    PENDING = 0,
    APPROVED = 1,
}

-- ============================================================================
-- Example 39: 7.2 Automatic Values
-- Demonstrates: The default underlying type is int.

enum Direction {
    NORTH, -- 0
    EAST,  -- 1
    SOUTH, -- 2
    WEST,  -- 3
}

-- ============================================================================
-- Example 40: 7.2 Automatic Values
-- Demonstrates: Automatic numbering continues from the previous numeric value.

enum Value = int {
    FIRST = 5,
    SECOND,   -- 6
    THIRD = 10,
    FOURTH,   -- 11
}

-- ============================================================================
-- Example 316: 7.2 Member Values
-- Demonstrates: The value of a member is a constant integer expression: integer literals and earlier members
--   of the same enum, joined by the arithmetic, shift and bitwise operators. Inside the declaration of its
--   enum the name of a member stands for its number; this is where the numbers behind the names are defined.
--   The expression is computed in the underlying type, and a member without a value follows the computed one.

enum Access = ubyte {
    READ = 1,
    WRITE = READ << 1,              -- 2
    EXECUTE = WRITE * 2,            -- 4
    ALL = READ | WRITE | EXECUTE,   -- 7
    NEXT,                           -- 8
    REST = !(EXECUTE + 1),          -- 250: the complement of 5 in ubyte
}

-- ============================================================================
-- Example 317: 7.2 Member Values
-- Demonstrates: A member value names earlier members only, of its own enum only, and is nothing but integer
--   arithmetic. Outside the declaration a member is a value of the enum and never a number.
-- Expected result: compile-time rejection; each INVALID marker is normative.

enum Order {
    FIRST = SECOND,          -- INVALID: SECOND is declared later
    SECOND = SECOND + 1,     -- INVALID: a member does not name itself
    THIRD = Access.READ,     -- INVALID: a member of another enum is not a number here
    FOURTH = Compute(),      -- INVALID: a call is not a constant
    FIFTH = 4 / 0,           -- INVALID: a constant division by zero
    SIXTH = 1 < 2,           -- INVALID: a comparison is not an integer
}

-- ============================================================================
-- Example 41: 7.3 Duplicate Numeric Values
-- Demonstrates: Different enum members may have the same numeric value.

enum Status {
    NONE = 0,
    UNKNOWN = 0,
    READY = 1,
}

-- ============================================================================
-- Example 42: 7.3 Duplicate Numeric Values
-- Demonstrates: Different enum members may have the same numeric value.

Status.NONE == Status.UNKNOWN -- true

-- ============================================================================
-- Example 43: 7.3 Duplicate Numeric Values
-- Demonstrates: In match, a second branch for the same numeric value is unreachable.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

match (status) {
    .NONE -> { ... },
    .UNKNOWN -> { ... }, -- INVALID: same runtime value as .NONE
    .READY -> { ... },
}

-- ============================================================================
-- Example 311: 7.4 Operations on Enum Values
-- Demonstrates: The values of a classic enum are compared with == and \=, with values of the same enum.
--   Two members with the same numeric value are equal.

Status.READY == status  -- bool
status \= Status.NONE   -- bool

-- ============================================================================
-- Example 312: 7.4 Operations on Enum Values
-- Demonstrates: A classic enum has no order and no arithmetic. Its members are names for values, and the
--   numeric value behind a name is not a quantity.
-- Expected result: compile-time rejection; the INVALID marker is normative.

Status.NONE < Status.READY   -- INVALID: enum values are not ordered
Status.NONE + Status.READY   -- INVALID: enum values are not added
Status.NONE == Level.LOW     -- INVALID: values of different enums

-- ============================================================================
-- Example 313: 7.5 Enums and Integers
-- Demonstrates: A classic enum is a type of its own. There is no implicit conversion between an enum and an
--   integer in either direction, whatever its underlying type is.
-- Expected result: compile-time rejection; the INVALID marker is normative.

int code = Status.READY;  -- INVALID: an enum value is not an integer
Status status = 1;        -- INVALID: an integer is not an enum value
Status.NONE == 0          -- INVALID: an enum value is not compared with an integer

-- ============================================================================
-- Example 314: 7.6 Access to Members
-- Demonstrates: The target-typed .Member spelling is the same for a classic enum as for an enum class: it
--   names a member of the enum that the context expects, in a match pattern and in an expression whose
--   target type is known.

Status first = Status.READY;
Status second = .READY;

-- ============================================================================
-- Example 315: 7.6 Access to Members
-- Demonstrates: Target-typed .Member syntax requires a known target type, for a classic enum as well.
-- Expected result: compile-time rejection; the INVALID marker is normative.

auto status = .READY; -- INVALID

-- ============================================================================
-- Example 44: 8. enum class
-- Demonstrates: An enum class is an AARC reference type whose cases are singleton instances.

enum class Status(String message) {
    case Success("Operation completed"),
    case Error("Something went wrong"),
    case Loading("Please wait"),

    public void PrintMessage() {
        Console.Println(message);
    }
}

-- ============================================================================
-- Example 45: 8. enum class
-- Demonstrates: An enum class may derive from a class or data class, but no declaration may derive
--   from the enum class itself.

class Base {
}

enum class Status() : Base {
    case Ready,
}

-- ============================================================================
-- Example 46: 8. enum class
-- Demonstrates: An enum class may derive from a class or data class, but no declaration may derive
--   from the enum class itself.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Child : Status { -- INVALID
}

-- ============================================================================
-- Example 47: 8.1 Case Rules
-- Demonstrates: case is valid only inside an enum class.

enum class Status() {
    case Ready,
    case Running,
    case Failed,
}

-- ============================================================================
-- Example 48: 8.1 Case Rules
-- Demonstrates: Case names are case-sensitive and unique within the declaration.

enum class Status() {
    case Ready,
    case READY,
}

-- ============================================================================
-- Example 49: 8.1 Case Rules
-- Demonstrates: A case name may not collide with another member name in the same enum class.
-- Expected result: compile-time rejection; the INVALID marker is normative.

enum class Status() {
    case Ready,

    public void Ready() { -- INVALID
    }
}

-- ============================================================================
-- Example 50: 8.1 Case Rules
-- Demonstrates: Cases are implicitly public and do not take access modifiers.
-- Expected result: compile-time rejection; the INVALID marker is normative.

enum class Status() {
    private case Ready, -- INVALID
}

-- ============================================================================
-- Example 51: 8.2 Case Constructor Arguments
-- Demonstrates: If the enum class has primary constructor parameters, each case supplies the required

enum class Status(String message, int code) {
    case Ready("Ready", 0),
    case Failed("Failed", 1),
}

-- ============================================================================
-- Example 52: 8.3 Empty Case Set Syntax
-- Demonstrates: A non-payload enum class still uses ().

enum class Direction() {
    case North,
    case South,
}

-- ============================================================================
-- Example 53: 8.4 Access to Cases
-- Demonstrates: A non-payload enum class still uses ().

Status first = Status.Ready;
Status second = .Ready;

-- ============================================================================
-- Example 54: 8.4 Access to Cases
-- Demonstrates: Target-typed .Case syntax requires a known target type.
-- Expected result: compile-time rejection; the INVALID marker is normative.

auto status = .Ready; -- INVALID

-- ============================================================================
-- Example 55: 8.4 Access to Cases
-- Demonstrates: Cases cannot be created with new.
-- Expected result: compile-time rejection; the INVALID marker is normative.

new Status();       -- INVALID
new Status.Ready(); -- INVALID

-- ============================================================================
-- Example 56: 8.4 Access to Cases
-- Demonstrates: The same case always yields the same AARC identity.

Status first = Status.Ready;
Status second = Status.Ready;

first == second -- true

-- ============================================================================
-- Example 57: 9. object
-- Demonstrates: An object declaration defines one named AARC singleton.

object Application {
}

-- ============================================================================
-- Example 58: 9. object
-- Demonstrates: An object derives from System.Object unless another allowed base class is specified.

class Base {
}

object Application : Base {
}

-- ============================================================================
-- Example 59: 9. object
-- Demonstrates: No declaration may derive from an object.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Child : Application { -- INVALID
}

-- ============================================================================
-- Example 60: 9. object
-- Demonstrates: An object may not contain another nested object.
-- Expected result: compile-time rejection; the INVALID marker is normative.

object Application {
    object Logger { -- INVALID
    }
}

-- ============================================================================
-- Example 61: 10. Nested Types and static class
-- Demonstrates: Real type declarations may be nested in another type where the containing declaration
--   permits nested types.

class Outer {
    class NestedClass {}
    data NestedData {}
    data class NestedDataClass(String name);
    type NestedType { int value; }

    enum Status {
        READY,
        STOPPED,
    }

    enum class Result() {
        case Success,
        case Failure,
    }

    object Logger {}

    interface Printable {
        public void Print();
    }
}

-- ============================================================================
-- Example 62: 10. Nested Types and static class
-- Demonstrates: A nested type has no implicit reference to an outer instance.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Outer {
    int value;

    class Nested {
        public int Read() {
            value -- INVALID
        }
    }
}

-- ============================================================================
-- Example 63: 10. Nested Types and static class
-- Demonstrates: Use an explicit outer reference when needed.

class Outer {
    int value;

    class Nested {
        Outer owner;

        public Nested(Outer owner);

        public int Read() {
            owner.value
        }
    }
}

-- ============================================================================
-- Example 64: 10. Nested Types and static class
-- Demonstrates: Nested types are named through the containing type.

Outer.Nested value;

-- ============================================================================
-- Example 65: 10. Nested Types and static class
-- Demonstrates: They are not named through an instance.
-- Expected result: compile-time rejection; the INVALID marker is normative.

Outer outer = new Outer();
outer.Nested value; -- INVALID

-- ============================================================================
-- Example 66: 10.1 static class
-- Demonstrates: A nested static class is allowed only inside class or data class.

class Math {
    public static class Constants {
        public static float Pi = 3.14159;
    }
}

-- ============================================================================
-- Example 67: 11. Interfaces
-- Demonstrates: An interface is a compile-time contract declaration. It is not a type.

interface Printable {
    public void Print();
}

-- ============================================================================
-- Example 68: 11.2 Interface Members
-- Demonstrates: An interface may declare method, property, and indexer contracts.

interface Collection {
    public int Size { get; }
    public String self[int index] { get; }
}

-- ============================================================================
-- Example 69: 12. concept
-- Demonstrates: A concept is a compile-time template condition.

template<typename T>
concept Value = requires(T value) {
    value.Print();
}

-- ============================================================================
-- Example 70: 12. concept
-- Demonstrates: Use a concept with requires:

template<typename T>
requires Value<T>
class Box {
}

-- ============================================================================
-- Example 71: 12.1 Requirement Forms
-- Demonstrates: Simple expression requirement:

requires(T value) {
    value.Print();
}

-- ============================================================================
-- Example 72: 12.1 Requirement Forms
-- Demonstrates: Type requirement:

requires(T value) {
    typename T.ValueType;
}

-- ============================================================================
-- Example 73: 12.1 Requirement Forms
-- Demonstrates: Exact result type requirement:

requires(T value) {
    { value.Size() } -> int;
}

-- ============================================================================
-- Example 74: 12.1 Requirement Forms
-- Demonstrates: A safe-conversion requirement is explicit:

requires(T value) {
    { value.Size() } -> convertible int;
}

-- ============================================================================
-- Example 75: 12.1 Requirement Forms
-- Demonstrates: noexcept may be required:

requires(T value) {
    { value.Size() } noexcept -> int;
}

-- ============================================================================
-- Example 76: 12.1 Requirement Forms
-- Demonstrates: Nested requirement:

requires(T value) {
    requires OtherConcept<T>;
}

-- ============================================================================
-- Example 77: 12.2 Recursive Concepts
-- Demonstrates: Direct or indirect concept recursion is invalid.
-- Expected result: compile-time rejection; the INVALID marker is normative.

template<typename T>
concept Recursive = Recursive<T>; -- INVALID

-- ============================================================================
-- Example 78: 13. typealias
-- Demonstrates: A type alias creates another name for an existing type. It does not create nominal

typealias UserId = long;
typealias Name = String;

-- ============================================================================
-- Example 79: 13. typealias
-- Demonstrates: A type alias creates another name for an existing type. It does not create nominal

UserId id = 10;
long raw = id;

-- ============================================================================
-- Example 80: 13.1 Alias Templates
-- Demonstrates: The two declarations above use the same static type.

template<typename T>
typealias ListOf = System.Array<T>;

-- ============================================================================
-- Example 81: 13.1 Alias Templates
-- Demonstrates: The two declarations above use the same static type.

template<typename... Types>
typealias VariantOf = System.Variant<Types...>;

-- ============================================================================
-- Example 82: 13.1 Alias Templates
-- Demonstrates: Alias templates may use requires.

template<typename T>
requires Numeric<T>
typealias NumericList = System.Array<T>;

-- ============================================================================
-- Example 83: 13.2 Alias Restrictions
-- Demonstrates: has no fields, methods, constructors, or other members; - cannot inherit; - cannot
--   implement interfaces; - cannot use final, sealed, or permits; - may form non-recursive alias
--   chains; - may not be directly or indirectly recursive.
-- Expected result: compile-time rejection; the INVALID marker is normative.

typealias First = Second;
typealias Second = First; -- INVALID

-- ============================================================================
-- Example 84: 13.2 Alias Restrictions
-- Demonstrates: Aliases do not create overload-distinct types.
-- Expected result: compile-time rejection; the INVALID marker is normative.

typealias UserId = long;

void Print(_ long value) {}
void Print(_ UserId value) {} -- INVALID: same type surface

-- ============================================================================
-- Example 85: 14. Extensions
-- Demonstrates: An extension adds callable/member surface to an existing target type without creating
--   a new runtime type.

extension StringExtensions : String {
    public bool IsBlank() {
        self.Length == 0
    }
}

-- ============================================================================
-- Example 86: 14.1 Generic Extensions
-- Demonstrates: self refers to the extension target value.

template<typename T>
extension ArrayExtensions : System.Array<T> {
    public T First() {
        self[0]
    }
}

-- ============================================================================
-- Example 87: 14.2 Constrained Extensions
-- Demonstrates: self refers to the extension target value.

template<typename T>
requires Printable<T>
extension PrintableArrayExtensions : System.Array<T> {
    public void PrintAll() {
        for (T value : self) {
            value.Print();
        }
    }
}

-- ============================================================================
-- Example 88: 14.4 Real Members Win
-- Demonstrates: A real member on the target type takes precedence over an extension member.

class User {
    public String Name() {
        "Real"
    }
}

extension UserExtensions : User {
    public String Name() {
        "Extension"
    }
}

user.Name(); -- calls User.Name

-- ============================================================================
-- Example 89: 14.4 Real Members Win
-- Demonstrates: If a real member with the requested name exists, extension candidates with that name
--   are not used merely because the real overload set fails.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {
    public void Print(int count) {
    }
}

extension UserExtensions : User {
    public void Print() {
    }
}

user.Print(); -- INVALID

-- ============================================================================
-- Example 90: 14.4 Real Members Win
-- Demonstrates: An extension instance member may also be invoked explicitly through the extension
--   declaration's static surface.

user.Display();
FirstExtensions.Display(user);

-- ============================================================================
-- Example 91: 15. Attributes
-- Demonstrates: Tala supports general attributes.

attribute Serializable;

-- ============================================================================
-- Example 92: 15. Attributes
-- Demonstrates: Attributes may take arguments.

attribute Range(int minimum, int maximum);

-- ============================================================================
-- Example 93: 15. Attributes
-- Demonstrates: Usage:

[Serializable]
data class User(String name, int age);

-- ============================================================================
-- Example 94: 15. Attributes
-- Demonstrates: Usage:

class Settings {
    [Range(0, 100)]
    int volume;
}

-- ============================================================================
-- Example 95: 15. Attributes
-- Demonstrates: Multiple attributes may be written separately or in one attribute list.

[Serializable]
[Exhaustive]
data class Result(String value);

-- ============================================================================
-- Example 96: 15. Attributes
-- Demonstrates: Multiple attributes may be written separately or in one attribute list.

[Serializable, Exhaustive]
data class Result(String value);

-- ============================================================================
-- Example 97: 15. Attributes
-- Demonstrates: An attribute may restrict its declaration targets.

attribute Exhaustive
    targets(data, data class, enum, enum class);

-- ============================================================================
-- Example 98: 15. Attributes
-- Demonstrates: An attribute may restrict its declaration targets.

attribute InlineHint
    targets(method, constructor);

-- ============================================================================
-- Example 99: 15. Attributes
-- Demonstrates: A repeatable attribute must opt in explicitly.

repeatable attribute Route(String path)
    targets(method);

-- ============================================================================
-- Example 100: 15. Attributes
-- Demonstrates: Attributes may have access modifiers; the default is internal.

public attribute Serializable;
internal attribute CompilerGenerated;

-- ============================================================================
-- Example 101: 15. Attributes
-- Demonstrates: Parameter attributes are written directly on the parameter.

public void SetName([NonNull] String name) {
}

-- ============================================================================
-- Example 102: 15. Attributes
-- Demonstrates: Return attributes use return:.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[return: NonNull]
public String FindName() {
    ...
}

-- ============================================================================
-- Example 103: 16.1 Field Modifier Order
-- Demonstrates: Example:

private static final int Limit = 10;

-- ============================================================================
-- Example 104: 16.2 Local Bindings
-- Demonstrates: Example:

Type name = value;

-- ============================================================================
-- Example 105: 16.2 Local Bindings
-- Demonstrates: auto requires an initializer.

auto value = Create();

-- ============================================================================
-- Example 106: 16.2 Local Bindings
-- Demonstrates: auto requires an initializer.
-- Expected result: compile-time rejection; the INVALID marker is normative.

auto value; -- INVALID

-- ============================================================================
-- Example 107: 16.2 Local Bindings
-- Demonstrates: auto requires an initializer.
-- Expected result: compile-time rejection; the INVALID marker is normative.

auto value = null; -- INVALID: no inferable target type

-- ============================================================================
-- Example 108: 16.3 final
-- Demonstrates: A final local binding must be initialized and cannot be rebound.
-- Expected result: compile-time rejection; the INVALID marker is normative.

final int count = 10;
count = 20; -- INVALID

-- ============================================================================
-- Example 109: 16.3 final
-- Demonstrates: For references, final freezes the binding, not the object.
-- Expected result: compile-time rejection; the INVALID marker is normative.

final User user = new User(name: "Ada");
user.name = "Grace"; -- VALID if the member is mutable
user = new User(name: "Other"); -- INVALID

-- ============================================================================
-- Example 110: 16.3 final
-- Demonstrates: A final field may be initialized by a field initializer or during construction.

class User {
    final String id;

    public User(String id);
}

-- ============================================================================
-- Example 111: 17. Built-in Copy(...) and Move(...)
-- Demonstrates: They are not members of a namespace, class, or instance.

User copy = Copy(user);
User moved = Move(user);

-- ============================================================================
-- Example 112: 17. Built-in Copy(...) and Move(...)
-- Demonstrates: Move(binding) consumes the source binding. The source cannot be read again until it is
-- Expected result: compile-time rejection; the INVALID marker is normative.

User first = LoadUser();
User second = Move(first);

Use(first); -- INVALID
first = LoadUser(); -- valid again

-- ============================================================================
-- Example 113: 17. Built-in Copy(...) and Move(...)
-- Demonstrates: A final binding cannot be moved.
-- Expected result: compile-time rejection; the INVALID marker is normative.

final User first = LoadUser();
User second = Move(first); -- INVALID

-- ============================================================================
-- Example 114: 18.1 General Modifier Order
-- Demonstrates: Examples:

public static inline int Calculate(_ int value) noexcept {
    value * 2
}

-- ============================================================================
-- Example 115: 18.1 General Modifier Order
-- Demonstrates: Examples:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

public String Print() final override noexcept {
    ...
}

-- ============================================================================
-- Example 116: 18.2 Parameter Labels
-- Demonstrates: By default, the parameter name is also the external argument label.

void Rename(String name) {
}

Rename(name: "Tala");

-- ============================================================================
-- Example 117: 18.2 Parameter Labels
-- Demonstrates: removes the external label.

void Print(_ String text) {
}

Print("Hello");

-- ============================================================================
-- Example 118: 18.2 Parameter Labels
-- Demonstrates: A separate external label may be written.

void Move(x: int horizontal, y: int vertical) {
}

Move(x: 10, y: 20);

-- ============================================================================
-- Example 119: 18.6 Body Requirement
-- Demonstrates: A normal method declaration requires a body.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {
    public void Print(); -- INVALID
}

-- ============================================================================
-- Example 120: 18.6 Body Requirement
-- Demonstrates: Interface methods use ; as a contract declaration.

interface Printable {
    public void Print();
}

-- ============================================================================
-- Example 121: 19. Constructors
-- Demonstrates: access inline explicit Constructor(...)

public inline explicit User(String name) {
}

-- ============================================================================
-- Example 122: 19.1 Automatic self Assignment
-- Demonstrates: In a non-explicit constructor, a parameter that is unused anywhere in the constructor
--   body is automatically assigned to a same-named compatible direct field or property.

class User {
    String name;
    int age;

    public User(String name, int age) {
    }
}

-- ============================================================================
-- Example 123: 19.1 Automatic self Assignment
-- Demonstrates: If a parameter is used anywhere in the constructor body, it is not automatically

class User {
    String name;

    public User(String name) {
        Validate(name);
    }
}

-- ============================================================================
-- Example 124: 19.2 Constructor ; Shorthand
-- Demonstrates: A constructor may use ; when it relies on automatic self assignment.

class User {
    String name;
    int age;

    public User(String name, int age);
}

-- ============================================================================
-- Example 125: 19.2 Constructor ; Shorthand
-- Demonstrates: An explicit constructor cannot use the shorthand.
-- Expected result: compile-time rejection; the INVALID marker is normative.

public explicit User(String name); -- INVALID

-- ============================================================================
-- Example 126: 19.3 self(...) Delegation
-- Demonstrates: A ; constructor requires an available parameterless base constructor because it cannot
--   explicitly call a parameterized base constructor.

class User {
    String name;
    int age;

    public User(String name) {
        self(name: name, age: 0);
    }

    public User(String name, int age);
}

-- ============================================================================
-- Example 127: 19.4 super(...)
-- Demonstrates: self(...) selects another constructor in the same declaration using normal constructor
--   overload resolution.

class Entity {
    public Entity(long id) {
    }
}

class User : Entity {
    public User(long id) {
        super(id: id);
    }
}

-- ============================================================================
-- Example 128: 19.5 Generated Default Constructor
-- Demonstrates: If no constructor is declared, the compiler generates:

public ClassName() {
    super();
}

-- ============================================================================
-- Example 129: 19.6 Constructor Overloads
-- Demonstrates: explicit, inline, and access level are not overload identity.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {
    public User(String name) {
    }

    private User(String name) { -- INVALID: same constructor surface
    }
}

-- ============================================================================
-- Example 130: 19.6 Constructor Overloads
-- Demonstrates: Default arguments may create ambiguity.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {
    public User(String name) {
    }

    public User(String name, int age = 0) {
    }
}

new User(name: "Ada"); -- INVALID: ambiguous

-- ============================================================================
-- Example 131: 19.7 Constructor Access
-- Demonstrates: new Type(...) considers only constructors accessible at the call site.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class User {
    public User(String name) {
    }

    private User(int id) {
    }
}

new User(name: "Ada"); -- VALID
new User(id: 10);       -- INVALID

-- ============================================================================
-- Example 132: 19.7 Constructor Access
-- Demonstrates: A private constructor may be called from the declaration that owns it.

class User {
    private User(int id) {
    }

    public static User FromId(int id) {
        new User(id: id)
    }
}

-- ============================================================================
-- Example 133: 20. Instance Initialization
-- Demonstrates: Initializers within one declaration run in source order.

class Example {
    int first = CreateFirst();
    int second = CreateSecond(first);
}

-- ============================================================================
-- Example 134: 20. Instance Initialization
-- Demonstrates: A later member cannot be read before its initialization point.
-- Expected result: compile-time rejection; the INVALID marker is normative.

class Example {
    int first = second; -- INVALID
    int second = 10;
}

-- ============================================================================
-- Example 135: 20. Instance Initialization
-- Demonstrates: An initializer may use self only for already initialized members.

class User {
    String firstName = "Ada";
    String displayName = self.firstName;
}

-- ============================================================================
-- Example 136: 22. Return Rules
-- Demonstrates: A value-returning function may return explicitly:

int Sum(_ int left, _ int right) {
    return left + right;
}

-- ============================================================================
-- Example 137: 22. Return Rules
-- Demonstrates: Or the final expression of the function body may supply the result:

int Sum(_ int left, _ int right) {
    left + right
}

-- ============================================================================
-- Example 138: 22. Return Rules
-- Demonstrates: Explicit returns and a final expression may coexist.

int Divide(_ int left, _ int right) {
    if (right == 0) {
        return 0;
    }

    left / right
}

-- ============================================================================
-- Example 139: 22. Return Rules
-- Demonstrates: Recursive auto return inference requires at least one independently inferable result

auto Factorial(_ int value) {
    if (value <= 1) {
        return 1;
    }

    value * Factorial(value - 1)
}

-- ============================================================================
-- Example 140: 22. Return Rules
-- Demonstrates: Recursive auto return inference requires at least one independently inferable result
-- Expected result: compile-time rejection; the INVALID marker is normative.

auto Loop() {
    Loop()
} -- INVALID: no independent result type

