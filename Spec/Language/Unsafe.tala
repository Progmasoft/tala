-- Tala language design examples: Unsafe Code
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 1. Design principle
-- Demonstrates: Tala therefore prefers:

pointer.Initialize(to: value);
pointer.Pointee();
pointer.Advanced(by: 1);
pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 2: 1. Design principle
-- Demonstrates: Tala does not define C-style raw-memory syntax such as:

*p
&p
p++
p + 1
free(p)

-- ============================================================================
-- Example 3: 2. Namespaces
-- Demonstrates: The two allocation functions are deliberately named differently:

System.Unsafe.Allocate<T>(capacity: n)

System.Unsafe.MRC.MrcAllocate<T>(capacity: n)

-- ============================================================================
-- Example 4: 3. Raw pointer types
-- Demonstrates: Scope exit does not free raw storage.

{
    auto pointer =
        System.Unsafe.Allocate<int>(capacity: 1);
}

-- the allocation is NOT automatically deallocated

-- ============================================================================
-- Example 5: 4. Constant and mutable raw pointers
-- Demonstrates: A mutable pointer may implicitly convert to the corresponding constant pointer.
-- Expected result: accepted when the referenced declarations are available.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeMutableRawPointer<int> mutable = ...;

System.Unsafe.UnsafeConstantRawPointer<int> constant =
    mutable; -- VALID

-- ============================================================================
-- Example 6: 4. Constant and mutable raw pointers
-- Demonstrates: The reverse conversion is not implicit.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeConstantRawPointer<int> constant = ...;

System.Unsafe.UnsafeMutableRawPointer<int> mutable =
    constant; -- INVALID

-- ============================================================================
-- Example 7: 5. Raw allocation
-- Demonstrates: Raw storage is allocated with:

System.Unsafe.Allocate<T>(capacity: n)

-- ============================================================================
-- Example 8: 5. Raw allocation
-- Demonstrates: Example:

System.Unsafe.UnsafeMutableRawPointer<int> pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

-- ============================================================================
-- Example 9: 5. Raw allocation
-- Demonstrates: Type inference may be used where the generic type is otherwise known.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 4);

-- ============================================================================
-- Example 10: 5. Raw allocation
-- Demonstrates: Allocation failure returns null.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1024);

if (pointer == null) {
    -- allocation failed
}

-- ============================================================================
-- Example 11: 6. Capacity
-- Demonstrates: capacity is measured in elements of T, not bytes.

System.Unsafe.Allocate<int>(capacity: 4);

-- ============================================================================
-- Example 12: 6.1 Zero capacity
-- Demonstrates: A zero-capacity allocation is valid.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 0);

-- ============================================================================
-- Example 13: 6.2 Negative capacity
-- Demonstrates: A compile-time-known negative capacity is a compile-time error.
-- Expected result: compile-time rejection; the INVALID marker is normative.

System.Unsafe.Allocate<int>(capacity: -1); -- INVALID

-- ============================================================================
-- Example 14: 7. Raw storage is initially uninitialized
-- Demonstrates: It does not begin the lifetime of T values automatically.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

-- ============================================================================
-- Example 15: 8. Initialize
-- Demonstrates: A mutable raw pointer initializes a pointee with:

pointer.Initialize(to: value);

-- ============================================================================
-- Example 16: 8. Initialize
-- Demonstrates: Example:

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

pointer.Initialize(to: 42);

-- ============================================================================
-- Example 17: 9. Pointee
-- Demonstrates: The pointee at the pointer's current position is accessed with:

pointer.Pointee()

-- ============================================================================
-- Example 18: 9. Pointee
-- Demonstrates: Example:

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

pointer.Initialize(to: 42);

Console.Println(pointer.Pointee());

-- ============================================================================
-- Example 19: 10. Deinitialize
-- Demonstrates: Initialized values are explicitly deinitialized with:

pointer.Deinitialize(count: n);

-- ============================================================================
-- Example 20: 10. Deinitialize
-- Demonstrates: Example:

pointer.Deinitialize(count: 1);

-- ============================================================================
-- Example 21: 11. Deallocate
-- Demonstrates: Raw storage is explicitly released with:

pointer.Deallocate();

-- ============================================================================
-- Example 22: 11. Deallocate
-- Demonstrates: Example:

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

pointer.Initialize(to: 42);

pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 23: 11. Deallocate
-- Demonstrates: Therefore, if an allocation contains initialized values whose lifetimes require
--   ending, those values MUST be deinitialized before the storage is deallocated.

pointer.Initialize(to: 42);

pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 24: 12. Complete raw-pointer example
-- Demonstrates: Calling Deallocate() on null is unsafe undefined behavior.

System.Unsafe.UnsafeMutableRawPointer<int> pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

if (pointer == null) {
    throw new RuntimeException("Allocation failed.");
}

pointer.Initialize(to: 42);

Console.Println(pointer.Pointee());

pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 25: 13. Pointer movement
-- Demonstrates: Pointer movement uses:

pointer.Advanced(by: offset)

-- ============================================================================
-- Example 26: 13. Pointer movement
-- Demonstrates: Example:

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 4);

auto third =
    pointer.Advanced(by: 2);

-- ============================================================================
-- Example 27: 13. Pointer movement
-- Demonstrates: Thus:

pointer.Advanced(by: 1)

-- ============================================================================
-- Example 28: 13.1 Type preservation
-- Demonstrates: A mutable raw pointer remains mutable when advanced.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeMutableRawPointer<int> p = ...;

System.Unsafe.UnsafeMutableRawPointer<int> q =
    p.Advanced(by: 2);

-- ============================================================================
-- Example 29: 13.1 Type preservation
-- Demonstrates: A constant raw pointer remains constant when advanced.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeConstantRawPointer<int> p = ...;

System.Unsafe.UnsafeConstantRawPointer<int> q =
    p.Advanced(by: 2);

-- ============================================================================
-- Example 30: 16. Constant and mutable MRC pointers
-- Demonstrates: Mutable-to-constant conversion is implicit:
-- Expected result: accepted when the referenced declarations are available.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.MRC.UnsafeMutableMrcPointer<int> mutable = ...;

System.Unsafe.MRC.UnsafeConstantMrcPointer<int> constant =
    mutable; -- VALID

-- ============================================================================
-- Example 31: 16. Constant and mutable MRC pointers
-- Demonstrates: The reverse direction is not implicit:
-- Expected result: compile-time rejection; the INVALID marker is normative.

System.Unsafe.MRC.UnsafeMutableMrcPointer<int> mutable =
    constant; -- INVALID

-- ============================================================================
-- Example 32: 17. MRC allocation
-- Demonstrates: MRC storage is allocated with:

System.Unsafe.MRC.MrcAllocate<T>(capacity: n)

-- ============================================================================
-- Example 33: 17. MRC allocation
-- Demonstrates: Example:

auto pointer =
    System.Unsafe.MRC.MrcAllocate<int>(capacity: 1);

-- ============================================================================
-- Example 34: 17. MRC allocation
-- Demonstrates: Scope exit does not automatically decrement the count.

{
    auto pointer =
        System.Unsafe.MRC.MrcAllocate<int>(capacity: 1);
}

-- no automatic Release()

-- ============================================================================
-- Example 35: 18. MRC capacity
-- Demonstrates: MRC capacity follows the same element-based model as raw allocation.

System.Unsafe.MRC.MrcAllocate<int>(capacity: 4);

-- ============================================================================
-- Example 36: 19. Retain
-- Demonstrates: An MRC pointer explicitly increments the allocation's reference count with:

pointer.Retain();

-- ============================================================================
-- Example 37: 20. Release
-- Demonstrates: An MRC pointer explicitly decrements the allocation's reference count with:

pointer.Release();

-- ============================================================================
-- Example 38: 21. Atomicity
-- Demonstrates: For example:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.MRC.UnsafeMutableMrcPointer<int> pointer = ...;

-- ============================================================================
-- Example 39: 22. MRC initialization and pointee access
-- Demonstrates: A mutable MRC pointer may initialize storage:

pointer.Initialize(to: 42);

-- ============================================================================
-- Example 40: 22. MRC initialization and pointee access
-- Demonstrates: An initialized pointee may be read with:

pointer.Pointee()

-- ============================================================================
-- Example 41: 23. MRC pointer movement
-- Demonstrates: MRC pointers support the same explicit pointer movement form:

pointer.Advanced(by: offset)

-- ============================================================================
-- Example 42: 24. Raw pointer versus MRC pointer
-- Demonstrates: Raw pointers use explicit storage deallocation:

pointer.Deallocate();

-- ============================================================================
-- Example 43: 24. Raw pointer versus MRC pointer
-- Demonstrates: MRC pointers use explicit atomic ownership accounting:

pointer.Retain();
pointer.Release();

-- ============================================================================
-- Example 44: 24. Raw pointer versus MRC pointer
-- Demonstrates: The distinction is visible at allocation time:

System.Unsafe.Allocate<int>(capacity: 1);

System.Unsafe.MRC.MrcAllocate<int>(capacity: 1);

-- ============================================================================
-- Example 45: 25. No unsafe context syntax
-- Demonstrates: Tala does not define:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

unsafe {
    ...
}

-- ============================================================================
-- Example 46: 25. No unsafe context syntax
-- Demonstrates: Unsafe APIs may be called directly.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

pointer.Initialize(to: 42);
Console.Println(pointer.Pointee());

pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 47: 29. Naming
-- Demonstrates: Named parameter labels remain ordinary parameter labels and may use their declared
--   lowercase names:

capacity:
to:
count:
by:

-- ============================================================================
-- Example 48: 30. Canonical raw example
-- Demonstrates: Named parameter labels remain ordinary parameter labels and may use their declared
--   lowercase names:

System.Unsafe.UnsafeMutableRawPointer<int> pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

if (pointer == null) {
    throw new RuntimeException("Allocation failed.");
}

pointer.Initialize(to: 42);

Console.Println(pointer.Pointee());

pointer.Deinitialize(count: 1);
pointer.Deallocate();

-- ============================================================================
-- Example 49: 31. Canonical raw array example
-- Demonstrates: Named parameter labels remain ordinary parameter labels and may use their declared
--   lowercase names:

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 4);

if (pointer == null) {
    throw new RuntimeException("Allocation failed.");
}

pointer.Advanced(by: 0).Initialize(to: 10);
pointer.Advanced(by: 1).Initialize(to: 20);
pointer.Advanced(by: 2).Initialize(to: 30);
pointer.Advanced(by: 3).Initialize(to: 40);

Console.Println(pointer.Advanced(by: 2).Pointee());

pointer.Deinitialize(count: 4);
pointer.Deallocate();

-- ============================================================================
-- Example 50: 32. Canonical constant-view example
-- Demonstrates: Named parameter labels remain ordinary parameter labels and may use their declared
--   lowercase names:
-- Expected result: accepted when the referenced declarations are available.

System.Unsafe.UnsafeMutableRawPointer<int> mutable =
    System.Unsafe.Allocate<int>(capacity: 1);

mutable.Initialize(to: 42);

System.Unsafe.UnsafeConstantRawPointer<int> constant =
    mutable;

Console.Println(constant.Pointee()); -- VALID

-- ============================================================================
-- Example 51: 33. Canonical MRC example
-- Demonstrates: The constant view does not grant mutable pointee operations.

System.Unsafe.MRC.UnsafeMutableMrcPointer<int> pointer =
    System.Unsafe.MRC.MrcAllocate<int>(capacity: 1);

if (pointer == null) {
    throw new RuntimeException("Allocation failed.");
}

pointer.Initialize(to: 42);

pointer.Retain();

Console.Println(pointer.Pointee());

pointer.Release();
pointer.Release();

-- ============================================================================
-- Example 52: VALID — raw allocation
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

-- ============================================================================
-- Example 53: VALID — allocation failure check
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.

auto pointer =
    System.Unsafe.Allocate<int>(capacity: 1);

if (pointer == null) {
    HandleAllocationFailure();
}

-- ============================================================================
-- Example 54: VALID — mutable to constant
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeMutableRawPointer<int> mutable = ...;

System.Unsafe.UnsafeConstantRawPointer<int> constant =
    mutable;

-- ============================================================================
-- Example 55: INVALID — implicit constant to mutable
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.
-- Expected result: compile-time rejection; the INVALID marker is normative.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

System.Unsafe.UnsafeConstantRawPointer<int> constant = ...;

System.Unsafe.UnsafeMutableRawPointer<int> mutable =
    constant; -- INVALID

-- ============================================================================
-- Example 56: VALID — explicit pointer movement
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.

auto next =
    pointer.Advanced(by: 1);

-- ============================================================================
-- Example 57: INVALID — negative constant capacity
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.
-- Expected result: compile-time rejection; the INVALID marker is normative.

System.Unsafe.Allocate<int>(capacity: -1); -- INVALID

-- ============================================================================
-- Example 58: VALID — MRC allocation
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.

auto pointer =
    System.Unsafe.MRC.MrcAllocate<int>(capacity: 1);

-- ============================================================================
-- Example 59: VALID — explicit MRC ownership
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.

pointer.Retain();
pointer.Release();

-- ============================================================================
-- Example 60: INVALID — unsafe-block syntax
-- Demonstrates: They do not make the pointee's contents automatically thread-safe.
-- Expected result: compile-time rejection; the INVALID marker is normative.

unsafe { -- INVALID: no such language construct
    pointer.Pointee();
}

-- ============================================================================
-- Example 61: Raw allocation
-- Demonstrates: System.Unsafe.UnsafeConstantRawPointer<T> System.Unsafe.UnsafeMutableRawPointer<T>

System.Unsafe.Allocate<T>(capacity: n)

-- ============================================================================
-- Example 62: Raw lifetime operations
-- Demonstrates: null

pointer.Initialize(to: value);
pointer.Pointee();
pointer.Deinitialize(count: n);
pointer.Deallocate();
pointer.Advanced(by: offset);

-- ============================================================================
-- Example 63: MRC allocation
-- Demonstrates: System.Unsafe.MRC.UnsafeConstantMrcPointer<T>
--   System.Unsafe.MRC.UnsafeMutableMrcPointer<T>

System.Unsafe.MRC.MrcAllocate<T>(capacity: n)

-- ============================================================================
-- Example 64: MRC ownership operations
-- Demonstrates: null

pointer.Retain();
pointer.Release();
