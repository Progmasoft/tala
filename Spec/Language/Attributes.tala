-- ============================================================================
-- Example 100: 51. Old ordinary attribute declaration form
-- Demonstrates: Equivalent:

attribute Serializable;

-- ============================================================================
-- Example 101: 52. Runtime attribute argument
-- Demonstrates: Use a real System.Attribute-derived class, data class, enum class, or object.

int maximum = ReadMaximum();

[Range(0, maximum)]
int volume;

-- ============================================================================
-- Example 102: 53. Non-repeatable duplicate
-- Demonstrates: Given:

using System.Reflection;

[AttributeUsage(
    AttributeTargets.Method,
    allowMultiple: false
)]
public data class EntryPoint() : Attribute;

-- ============================================================================
-- Example 103: 53. Non-repeatable duplicate
-- Demonstrates: this is INVALID:

[EntryPoint]
[EntryPoint]
void Run() {
}

-- ============================================================================
-- Example 104: 54. Wrong AttributeUsage target
-- Demonstrates: this is INVALID:

using System.Reflection;

[AttributeUsage(AttributeTargets.Method)]
class User {
}

-- ============================================================================
-- Example 105: 55. DllImport without extern
-- Demonstrates: INVALID because User is not an ordinary attribute type.

class Native {
    [DllImport("native.dll")]
    public static int Add(_ int left, _ int right) {
        left + right
    }
}

-- ============================================================================
-- Example 106: 56. extern with body
-- Demonstrates: INVALID.

public static extern int Add(_ int a, _ int b) {
    a + b
}

-- ============================================================================
-- Example 107: 57. Invalid NoMangle target
-- Demonstrates: Applying:

[NoMangle]
