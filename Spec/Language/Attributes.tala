-- Example 96: 47. Reflection
-- Demonstrates: Equivalent:

using System.Reflection;

Type type = TypeInfo.typeof(User);

Document first =
    type.GetCustomAttribute<Document>();

Array<Document> all =
    type.GetCustomAttributes<Document>();

