-- Tala language design examples: PostgreSQL
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 2. Namespace
-- Demonstrates: Artificial asynchronous execution through Task.Run is not the normal PostgreSQL async
--   implementation.

namespace Progmasoft.Database.PostgreSql;

-- ============================================================================
-- Example 2: 2. Namespace
-- Demonstrates: Typical use:

using Progmasoft.Database.PostgreSql;

-- ============================================================================
-- Example 3: 3. PostgreSqlConnection
-- Demonstrates: Duration is used by the connection-string builder for timeout values.

public class PostgreSqlConnection {
    public PostgreSqlConnection(String connectionString);

    public void Open();
    public Future<void> OpenAsync();

    public void Reset();
    public Future<void> ResetAsync();

    public void Close();

    public bool IsOpen();
    public bool IsBroken();

    public PostgreSqlConnectionState State { get; }

    public String Database { get; }
    public String User { get; }
    public String Host { get; }
    public String HostAddress { get; }
    public int Port { get; }

    public int ServerVersion { get; }
    public int ProtocolVersion { get; }
    public int FullProtocolVersion { get; }

    public int BackendProcessId { get; }

    public PostgreSqlTransactionState TransactionState { get; }

    public bool UsesPassword { get; }
    public bool NeedsPassword { get; }

    public bool UsesSsl { get; }

    public String SslAttribute(_ String name);
    public String ParameterStatus(_ String name);

    public PostgreSqlCommand CreateCommand(_ String sql);

    public PostgreSqlTransaction BeginTransaction();

    public PostgreSqlTransaction BeginTransaction(
        PostgreSqlIsolationLevel isolation,
        bool readOnly = false,
        bool deferrable = false
    );

    public PostgreSqlPipeline BeginPipeline();

    public void CancelCurrentCommand();
    public Future<void> CancelCurrentCommandAsync();

    public String EscapeIdentifier(_ String identifier);

    public void SetNoticeHandler(_ \PostgreSqlNotice -> handler);
    public void SetNotificationHandler(
        _ \PostgreSqlNotification -> handler
    );

    public static PostgreSqlPingStatus Ping(
        _ String connectionString
    );
}

-- ============================================================================
-- Example 4: 3.1 Construction
-- Demonstrates: It does not imply that the network connection is already open.

PostgreSqlConnection connection =
    new PostgreSqlConnection(
        "host=localhost dbname=app user=app"
    );

connection.Open();

-- ============================================================================
-- Example 5: 3.1 Construction
-- Demonstrates: Async:

PostgreSqlConnection connection =
    new PostgreSqlConnection(connectionString);

await connection.OpenAsync();

-- ============================================================================
-- Example 6: 4. Connection state
-- Demonstrates: AARC lifetime end → native resource cleanup

public enum PostgreSqlConnectionState {
    CLOSED,
    CONNECTING,
    OPEN,
    BROKEN,
}

-- ============================================================================
-- Example 7: 5. Transaction state
-- Demonstrates: AARC lifetime end → native resource cleanup

public enum PostgreSqlTransactionState {
    IDLE,
    ACTIVE,
    IN_TRANSACTION,
    IN_ERROR,
    UNKNOWN,
}

-- ============================================================================
-- Example 8: 6. Ping
-- Demonstrates: AARC lifetime end → native resource cleanup

public enum PostgreSqlPingStatus {
    OK,
    REJECTED,
    NO_RESPONSE,
    NO_ATTEMPT,
}

-- ============================================================================
-- Example 9: 6. Ping
-- Demonstrates: AARC lifetime end → native resource cleanup

PostgreSqlPingStatus status =
    PostgreSqlConnection.Ping(connectionString);

-- ============================================================================
-- Example 10: 7. Server parameters
-- Demonstrates: AARC lifetime end → native resource cleanup

String value =
    connection.ParameterStatus("TimeZone");

-- ============================================================================
-- Example 11: 7. Server parameters
-- Demonstrates: Examples:

connection.ParameterStatus("client_encoding");
connection.ParameterStatus("server_encoding");
connection.ParameterStatus("TimeZone");
connection.ParameterStatus("DateStyle");

-- ============================================================================
-- Example 12: 8. SSL information
-- Demonstrates: A dedicated property is not required for every PostgreSQL parameter.

bool ssl = connection.UsesSsl;

String protocol =
    connection.SslAttribute("protocol");

-- ============================================================================
-- Example 13: 9. Identifier escaping
-- Demonstrates: A dedicated property is not required for every PostgreSQL parameter.

public String EscapeIdentifier(_ String identifier);

-- ============================================================================
-- Example 14: 9. Identifier escaping
-- Demonstrates: Example:

String table =
    connection.EscapeIdentifier(userTable);

PostgreSqlCommand command =
    connection.CreateCommand(
        "SELECT * FROM " + table + " WHERE id = $1"
    );

command.Bind(1, 42);

-- ============================================================================
-- Example 15: 10. PostgreSqlConnectionStringBuilder
-- Demonstrates: PML does not add a high-level EscapeLiteral API as a substitute for parameters.

public class PostgreSqlConnectionStringBuilder {
    public PostgreSqlConnectionStringBuilder();

    public PostgreSqlConnectionStringBuilder Host(_ String host);
    public PostgreSqlConnectionStringBuilder HostAddress(_ String address);
    public PostgreSqlConnectionStringBuilder Port(_ int port);

    public PostgreSqlConnectionStringBuilder Database(_ String database);
    public PostgreSqlConnectionStringBuilder User(_ String user);
    public PostgreSqlConnectionStringBuilder Password(_ String password);

    public PostgreSqlConnectionStringBuilder ApplicationName(_ String name);

    public PostgreSqlConnectionStringBuilder ConnectTimeout(
        _ Duration timeout
    );

    public PostgreSqlConnectionStringBuilder Parameter(
        _ String name,
        _ String value
    );

    public String Build();
}

-- ============================================================================
-- Example 16: 10. PostgreSqlConnectionStringBuilder
-- Demonstrates: Example:

PostgreSqlConnectionStringBuilder builder =
    new PostgreSqlConnectionStringBuilder();

String connectionString =
    builder
        .Host("db.example.com")
        .Port(5432)
        .Database("app")
        .User("app")
        .ApplicationName("TalaApp")
        .Build();

-- ============================================================================
-- Example 17: 11. PostgreSqlCommand
-- Demonstrates: Parameter is the escape hatch for libpq connection keywords that do not have a
--   dedicated builder method.

public class PostgreSqlCommand {
    public String Sql { get; }

    public PostgreSqlParameter Bind(_ int index, _ auto value);

    public void ClearBindings();

    public int ParameterCount { get; }

    public void Prepare();
    public Future<void> PrepareAsync();

    public int ExecuteNonQuery();
    public Future<int> ExecuteNonQueryAsync();

    template<typename T>
    public T ExecuteScalar();

    template<typename T>
    public Future<T> ExecuteScalarAsync();

    public PostgreSqlReader ExecuteReader();
    public Future<PostgreSqlReader> ExecuteReaderAsync();

    public PostgreSqlCopyIn ExecuteCopyIn();
    public Future<PostgreSqlCopyIn> ExecuteCopyInAsync();

    public PostgreSqlCopyOut ExecuteCopyOut();
    public Future<PostgreSqlCopyOut> ExecuteCopyOutAsync();
}

-- ============================================================================
-- Example 18: 11. PostgreSqlCommand
-- Demonstrates: Commands are normally created from their connection:

PostgreSqlCommand command =
    connection.CreateCommand(
        "SELECT id, name FROM users WHERE id = $1"
    );

-- ============================================================================
-- Example 19: 12. Natural PostgreSQL parameters
-- Demonstrates: Example:

PostgreSqlCommand command =
    connection.CreateCommand(
        """
        SELECT id, name
        FROM users
        WHERE age >= $1
          AND active = $2
        """
    );

command.Bind(1, 18);
command.Bind(2, true);

-- ============================================================================
-- Example 20: 13. PostgreSqlParameter
-- Demonstrates: Required placeholders must not remain unbound at execution.

public class PostgreSqlParameter {
    public int Index { get; }

    public auto Value { get; set; }

    public bool IsNull();
}

-- ============================================================================
-- Example 21: 13. PostgreSqlParameter
-- Demonstrates: Required placeholders must not remain unbound at execution.

PostgreSqlCommand command =
    connection.CreateCommand(
        "SELECT name FROM users WHERE id = $1"
    );

PostgreSqlParameter id =
    command.Bind(1, 10);

-- ============================================================================
-- Example 22: 13. PostgreSqlParameter
-- Demonstrates: A prepared command can be reused by updating the parameter value:

command.Prepare();

String first =
    command.ExecuteScalar<String>();

id.Value = 20;

String second =
    command.ExecuteScalar<String>();

-- ============================================================================
-- Example 23: 13. PostgreSqlParameter
-- Demonstrates: SQL NULL is represented by binding null.

command.Bind(1, null);

-- ============================================================================
-- Example 24: 14. Clearing bindings
-- Demonstrates: SQL NULL is represented by binding null.

command.ClearBindings();

-- ============================================================================
-- Example 25: 15. Preparation
-- Demonstrates: This removes current parameter bindings without replacing the SQL text.

command.Prepare();

-- ============================================================================
-- Example 26: 15. Preparation
-- Demonstrates: Async:

await command.PrepareAsync();

-- ============================================================================
-- Example 27: 16. ExecuteNonQuery
-- Demonstrates: Async:

int affected =
    command.ExecuteNonQuery();

-- ============================================================================
-- Example 28: 16. ExecuteNonQuery
-- Demonstrates: Async:

int affected =
    await command.ExecuteNonQueryAsync();

-- ============================================================================
-- Example 29: 17. ExecuteScalar
-- Demonstrates: Async:

long id =
    command.ExecuteScalar<long>();

-- ============================================================================
-- Example 30: 17. ExecuteScalar
-- Demonstrates: Async:

long id =
    await command.ExecuteScalarAsync<long>();

-- ============================================================================
-- Example 31: 18. PostgreSqlReader
-- Demonstrates: The requested T follows the same conversion rules as PostgreSqlReader.Get<T>.

public class PostgreSqlReader {
    public int RowCount { get; }
    public int ColumnCount { get; }
    public bool HasRows { get; }

    public PostgreSqlResultStatus Status { get; }

    public String CommandStatus { get; }
    public long AffectedRows { get; }

    public bool Read();

    public bool IsNull(_ int index);
    public bool IsNull(_ String name);

    template<typename T>
    public T Get(_ int index);

    template<typename T>
    public T Get(_ String name);

    public []byte GetRaw(_ int index);
    public []byte GetRaw(_ String name);

    public String ColumnName(_ int index);
    public int ColumnIndex(_ String name);

    public PostgreSqlType ColumnType(_ int index);
    public uint ColumnTypeOid(_ int index);

    public PostgreSqlFormat ColumnFormat(_ int index);

    public int ColumnSize(_ int index);
    public int ColumnTypeModifier(_ int index);

    public int ValueSize(_ int index);

    public void Close();
}

-- ============================================================================
-- Example 32: 19. Reader model
-- Demonstrates: It is not defined as a network streaming primitive.

PostgreSqlReader reader =
    connection
        .CreateCommand(
            "SELECT id, name, age FROM users ORDER BY id"
        )
        .ExecuteReader();

while (reader.Read()) {
    long id = reader.Get<long>(0);
    String name = reader.Get<String>("name");
    int age = reader.Get<int>("age");
}

-- ============================================================================
-- Example 33: 20. Column indexes
-- Demonstrates: Reader column indexes are zero-based.

reader.ColumnName(0);
reader.Get<long>(0);
reader.IsNull(0);

-- ============================================================================
-- Example 34: 21. Reader lifecycle
-- Demonstrates: Normal use:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

PostgreSqlReader reader =
    command.ExecuteReader();

while (reader.Read()) {
    ...
}

-- ============================================================================
-- Example 35: 21. Reader lifecycle
-- Demonstrates: When explicit early cleanup is associated with a guarded region, Tala uses defer,
--   not finally.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

PostgreSqlReader reader =
    command.ExecuteReader();

try {
    while (reader.Read()) {
        ...
    }
}

defer reader.Close();

-- ============================================================================
-- Example 36: 22. Fundamental mappings
-- Demonstrates: Example:

short small =
    reader.Get<short>("small_value");

long normal =
    reader.Get<long>("normal_value");

int big =
    reader.Get<int>("big_value");

lfloat real =
    reader.Get<lfloat>("real_value");

float precision =
    reader.Get<float>("double_value");

-- ============================================================================
-- Example 37: 22. Fundamental mappings
-- Demonstrates: Wrapper targets are also permitted:

Integer id =
    reader.Get<Integer>("id");

Boolean enabled =
    reader.Get<Boolean>("enabled");

-- ============================================================================
-- Example 38: 23. SQL NULL
-- Demonstrates: Reference targets may receive null.

String nickname =
    reader.Get<String>("nickname");

-- ============================================================================
-- Example 39: 23. SQL NULL
-- Demonstrates: Optional<T> provides an explicit nullable value surface:

Optional<int> age =
    reader.Get<Optional<int>>("age");

-- ============================================================================
-- Example 40: 23. SQL NULL
-- Demonstrates: For a non-nullable value type:

int age =
    reader.Get<int>("age");

-- ============================================================================
-- Example 41: 23. SQL NULL
-- Demonstrates: The caller may test first:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

if (reader.IsNull("age")) {
    ...
}

-- ============================================================================
-- Example 42: 24. bytea
-- Demonstrates: The caller may test first:

[]byte payload =
    reader.Get<[]byte>("payload");

-- ============================================================================
-- Example 43: 25. String fallback for not-yet-specialized standard types
-- Demonstrates: Examples:

String amount =
    reader.Get<String>("amount");

String identifier =
    reader.Get<String>("id");

String timestamp =
    reader.Get<String>("created_at");

String json =
    reader.Get<String>("metadata");

String xml =
    reader.Get<String>("document");

-- ============================================================================
-- Example 44: 26. Raw access
-- Demonstrates: Unknown/custom PostgreSQL types have a raw escape hatch:

uint oid =
    reader.ColumnTypeOid(4);

[]byte raw =
    reader.GetRaw(4);

-- ============================================================================
-- Example 45: 27. PostgreSqlType
-- Demonstrates: GetRaw is the low-level value-byte surface.

public enum class PostgreSqlType() {
    case Bool,

    case Int2,
    case Int4,
    case Int8,

    case Float4,
    case Float8,
    case Numeric,

    case Char,
    case Varchar,
    case Text,

    case Bytea,
    case Uuid,

    case Date,
    case Time,
    case TimeTz,
    case Timestamp,
    case TimestampTz,
    case Interval,

    case Json,
    case Jsonb,
    case Xml,

    case Array,

    case Unknown,
}

-- ============================================================================
-- Example 46: 27. PostgreSqlType
-- Demonstrates: ColumnType exposes the high-level classification:

PostgreSqlType type =
    reader.ColumnType(3);

-- ============================================================================
-- Example 47: 27. PostgreSqlType
-- Demonstrates: The real OID remains available:

uint oid =
    reader.ColumnTypeOid(3);

-- ============================================================================
-- Example 48: 28. PostgreSqlFormat
-- Demonstrates: The real OID remains available:

public enum PostgreSqlFormat {
    TEXT,
    BINARY,
}

-- ============================================================================
-- Example 49: 28. PostgreSqlFormat
-- Demonstrates: Format is column-specific.

PostgreSqlFormat format =
    reader.ColumnFormat(0);

-- ============================================================================
-- Example 50: 29. Column metadata
-- Demonstrates: Format is column-specific.

String name =
    reader.ColumnName(0);

int index =
    reader.ColumnIndex("name");

int size =
    reader.ColumnSize(0);

int modifier =
    reader.ColumnTypeModifier(0);

-- ============================================================================
-- Example 51: 30. ValueSize
-- Demonstrates: ColumnTypeModifier exposes the PostgreSQL type modifier.

int bytes =
    reader.ValueSize(2);

-- ============================================================================
-- Example 52: 31. PostgreSqlResultStatus
-- Demonstrates: It is distinct from ColumnSize.

public enum PostgreSqlResultStatus {
    EMPTY_QUERY,
    COMMAND_OK,
    TUPLES_OK,

    COPY_OUT,
    COPY_IN,
    COPY_BOTH,

    BAD_RESPONSE,
    NONFATAL_ERROR,
    FATAL_ERROR,

    SINGLE_TUPLE,
    TUPLES_CHUNK,

    PIPELINE_SYNC,
    PIPELINE_ABORTED,
}

-- ============================================================================
-- Example 53: 31. PostgreSqlResultStatus
-- Demonstrates: It is distinct from ColumnSize.

PostgreSqlResultStatus status =
    reader.Status;

-- ============================================================================
-- Example 54: 32. CommandStatus and AffectedRows
-- Demonstrates: Status is metadata/diagnostic information and does not replace exception handling.

String status =
    reader.CommandStatus;

long affected =
    reader.AffectedRows;

-- ============================================================================
-- Example 55: 33. PostgreSqlTransaction
-- Demonstrates: Status is metadata/diagnostic information and does not replace exception handling.

public class PostgreSqlTransaction {
    public PostgreSqlTransactionState State { get; }

    public void Commit();
    public Future<void> CommitAsync();

    public void Rollback();
    public Future<void> RollbackAsync();

    public PostgreSqlSavepoint Savepoint(_ String name);

    public bool IsActive();
}

-- ============================================================================
-- Example 56: 33. PostgreSqlTransaction
-- Demonstrates: Start:

PostgreSqlTransaction transaction =
    connection.BeginTransaction();

-- ============================================================================
-- Example 57: 33. PostgreSqlTransaction
-- Demonstrates: Configured:

PostgreSqlTransaction transaction =
    connection.BeginTransaction(
        isolation: .SERIALIZABLE,
        readOnly: false,
        deferrable: false
    );

-- ============================================================================
-- Example 58: 34. Isolation levels
-- Demonstrates: Configured:

public enum PostgreSqlIsolationLevel {
    READ_COMMITTED,
    REPEATABLE_READ,
    SERIALIZABLE,
}

-- ============================================================================
-- Example 59: 35. Commands inside transactions
-- Demonstrates: Transaction state belongs to the connection.

PostgreSqlTransaction transaction =
    connection.BeginTransaction();

PostgreSqlCommand debit =
    connection.CreateCommand(
        """
        UPDATE accounts
        SET balance = balance - $1
        WHERE id = $2
        """
    );

debit.Bind(1, 100);
debit.Bind(2, 10);
debit.ExecuteNonQuery();

transaction.Commit();

-- ============================================================================
-- Example 60: 37. PostgreSqlSavepoint
-- Demonstrates: The destructor never silently commits an unfinished transaction.

public class PostgreSqlSavepoint {
    public String Name { get; }

    public void Rollback();
    public void Release();

    public bool IsActive();
}

-- ============================================================================
-- Example 61: 37. PostgreSqlSavepoint
-- Demonstrates: Example:

PostgreSqlTransaction transaction =
    connection.BeginTransaction();

PostgreSqlSavepoint savepoint =
    transaction.Savepoint("before_update");

command.ExecuteNonQuery();

savepoint.Rollback();

transaction.Commit();

-- ============================================================================
-- Example 62: 38. PostgreSqlException
-- Demonstrates: Using a completed/released savepoint operation again is an invalid runtime state and
--   fails with an unchecked PostgreSqlException.

public class PostgreSqlException : RuntimeException {
    public String SqlState { get; }
    public String Severity { get; }

    public String Message { get; }
    public String Detail { get; }
    public String Hint { get; }

    public String Position { get; }
    public String InternalPosition { get; }
    public String InternalQuery { get; }

    public String Schema { get; }
    public String Table { get; }
    public String Column { get; }
    public String DataType { get; }
    public String Constraint { get; }
}

-- ============================================================================
-- Example 63: 38. PostgreSqlException
-- Demonstrates: Example:

try {
    command.ExecuteNonQuery();
}
catch (PostgreSqlException exception) {
    Console.Println(exception.SqlState);
    Console.Println(exception.Message);
    Console.Println(exception.Detail);
}

-- ============================================================================
-- Example 64: 39. SQLSTATE
-- Demonstrates: Program logic should prefer SqlState over parsing server messages.

catch (PostgreSqlException exception) {
    if (exception.SqlState == "23505") {
        -- unique violation
    }
}

-- ============================================================================
-- Example 65: 40. PostgreSqlNotice
-- Demonstrates: Unavailable reference-valued properties may be null.

public data class PostgreSqlNotice(
    String SqlState,
    String Severity,
    String Message,
    String Detail,
    String Hint,
    String Schema,
    String Table,
    String Column,
    String DataType,
    String Constraint
);

-- ============================================================================
-- Example 66: 40. PostgreSqlNotice
-- Demonstrates: Handler:

connection.SetNoticeHandler(
    \PostgreSqlNotice -> notice {
        Console.Println(notice.Message);
    }
);

-- ============================================================================
-- Example 67: 40. PostgreSqlNotice
-- Demonstrates: The declaration is exactly:

public void SetNoticeHandler(
    _ \PostgreSqlNotice -> handler
);

-- ============================================================================
-- Example 68: 41. PostgreSqlNotification
-- Demonstrates: PML does not normally write libpq notices directly to stderr; applications register a
--   handler if they want notice output.

public data class PostgreSqlNotification(
    String Channel,
    String Payload,
    int BackendProcessId
);

-- ============================================================================
-- Example 69: 41. PostgreSqlNotification
-- Demonstrates: Handler:

connection.SetNotificationHandler(
    \PostgreSqlNotification -> notification {
        Console.Println(notification.Channel);
        Console.Println(notification.Payload);
    }
);

-- ============================================================================
-- Example 70: 41. PostgreSqlNotification
-- Demonstrates: The declaration is exactly:

public void SetNotificationHandler(
    _ \PostgreSqlNotification -> handler
);

-- ============================================================================
-- Example 71: 41. PostgreSqlNotification
-- Demonstrates: Listen:

connection
    .CreateCommand("LISTEN user_events")
    .ExecuteNonQuery();

-- ============================================================================
-- Example 72: 43. PostgreSqlPipeline
-- Demonstrates: It propagates according to ordinary Tala callback/exception behavior.

public class PostgreSqlPipeline {
    public bool IsActive();
    public bool IsAborted();

    public void Send(_ PostgreSqlCommand command);

    public void Sync();
    public Future<void> SyncAsync();

    public PostgreSqlReader Receive();
    public Future<PostgreSqlReader> ReceiveAsync();

    public void Close();
}

-- ============================================================================
-- Example 73: 43. PostgreSqlPipeline
-- Demonstrates: Start:

PostgreSqlPipeline pipeline =
    connection.BeginPipeline();

-- ============================================================================
-- Example 74: 44. Sending commands
-- Demonstrates: Start:

pipeline.Send(command1);
pipeline.Send(command2);
pipeline.Send(command3);

-- ============================================================================
-- Example 75: 45. Sync
-- Demonstrates: Start:

pipeline.Sync();

-- ============================================================================
-- Example 76: 45. Sync
-- Demonstrates: Async:

await pipeline.SyncAsync();

-- ============================================================================
-- Example 77: 46. Receiving results
-- Demonstrates: Async:

PostgreSqlReader first =
    pipeline.Receive();

PostgreSqlReader second =
    pipeline.Receive();

PostgreSqlReader third =
    pipeline.Receive();

-- ============================================================================
-- Example 78: 46. Receiving results
-- Demonstrates: Async:

PostgreSqlReader first =
    await pipeline.ReceiveAsync();

PostgreSqlReader second =
    await pipeline.ReceiveAsync();

-- ============================================================================
-- Example 79: 47. Pipeline errors
-- Demonstrates: If PostgreSQL aborts pipeline state:

pipeline.IsAborted(); -- true

-- ============================================================================
-- Example 80: 48. Pipeline exclusivity
-- Demonstrates: While a connection is in active pipeline mode, ordinary direct command execution on
--   the same connection is not allowed.
-- Expected result: compile-time rejection; the INVALID marker is normative.

PostgreSqlPipeline pipeline =
    connection.BeginPipeline();

pipeline.Send(command);

otherCommand.ExecuteReader(); -- INVALID while pipeline is active

-- ============================================================================
-- Example 81: 50. Current-command cancellation
-- Demonstrates: Close() is not mandatory solely for memory/resource safety.

public void CancelCurrentCommand();
public Future<void> CancelCurrentCommandAsync();

-- ============================================================================
-- Example 82: 50. Current-command cancellation
-- Demonstrates: Example:

await connection.CancelCurrentCommandAsync();

-- ============================================================================
-- Example 83: 51. Starting COPY IN
-- Demonstrates: If the server actually cancels the query, execution fails through PostgreSqlException.

PostgreSqlCommand command =
    connection.CreateCommand(
        "COPY users(name, age) FROM STDIN"
    );

PostgreSqlCopyIn copy =
    command.ExecuteCopyIn();

-- ============================================================================
-- Example 84: 51. Starting COPY IN
-- Demonstrates: Async:

PostgreSqlCopyIn copy =
    await command.ExecuteCopyInAsync();

-- ============================================================================
-- Example 85: 52. PostgreSqlCopyIn
-- Demonstrates: Async:

public class PostgreSqlCopyIn {
    public void Write(_ []byte data);
    public Future<void> WriteAsync(_ []byte data);

    public void Complete();
    public Future<void> CompleteAsync();

    public void Abort(_ String message);
    public Future<void> AbortAsync(_ String message);

    public bool IsCompleted();
}

-- ============================================================================
-- Example 86: 52. PostgreSqlCopyIn
-- Demonstrates: Example:

copy.Write(data1);
copy.Write(data2);
copy.Complete();

-- ============================================================================
-- Example 87: 53. COPY IN abort
-- Demonstrates: Example:

copy.Abort("input cancelled");

-- ============================================================================
-- Example 88: 54. Starting COPY OUT
-- Demonstrates: CopyIn lifetime end + not completed → abort COPY

PostgreSqlCopyOut copy =
    connection
        .CreateCommand(
            "COPY users TO STDOUT"
        )
        .ExecuteCopyOut();

-- ============================================================================
-- Example 89: 54. Starting COPY OUT
-- Demonstrates: Async:

PostgreSqlCopyOut copy =
    await command.ExecuteCopyOutAsync();

-- ============================================================================
-- Example 90: 55. PostgreSqlCopyOut
-- Demonstrates: Async:

public class PostgreSqlCopyOut {
    public []byte Read();
    public Future<[]byte> ReadAsync();

    public bool IsCompleted();

    public void Close();
}

-- ============================================================================
-- Example 91: 55. PostgreSqlCopyOut
-- Demonstrates: Example:

PostgreSqlCopyOut copy =
    command.ExecuteCopyOut();

while (not copy.IsCompleted()) {
    []byte data =
        copy.Read();

    Process(data);
}

-- ============================================================================
-- Example 92: 60. Basic query
-- Demonstrates: PostgreSqlNotification → LISTEN / NOTIFY event → not an operation failure

PostgreSqlConnection connection =
    new PostgreSqlConnection(connectionString);

connection.Open();

PostgreSqlCommand command =
    connection.CreateCommand(
        """
        SELECT id, name
        FROM users
        WHERE active = $1
        ORDER BY id
        """
    );

command.Bind(1, true);

PostgreSqlReader reader =
    command.ExecuteReader();

while (reader.Read()) {
    long id =
        reader.Get<long>("id");

    String name =
        reader.Get<String>("name");

    Console.Println(
        id + ": " + name
    );
}

-- ============================================================================
-- Example 93: 61. Early reader release
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlReader reader =
    command.ExecuteReader();

try {
    while (reader.Read()) {
        Process(reader);
    }
}

defer reader.Close();

-- ============================================================================
-- Example 94: 62. Prepared reuse
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlCommand command =
    connection.CreateCommand(
        "SELECT name FROM users WHERE id = $1"
    );

PostgreSqlParameter id =
    command.Bind(1, 10);

command.Prepare();

String first =
    command.ExecuteScalar<String>();

id.Value = 20;

String second =
    command.ExecuteScalar<String>();

-- ============================================================================
-- Example 95: 63. Transaction
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlTransaction transaction =
    connection.BeginTransaction(
        isolation: .SERIALIZABLE,
        readOnly: false,
        deferrable: false
    );

PostgreSqlCommand command =
    connection.CreateCommand(
        "UPDATE users SET enabled = $1 WHERE id = $2"
    );

command.Bind(1, true);
command.Bind(2, 42);

command.ExecuteNonQuery();

transaction.Commit();

-- ============================================================================
-- Example 96: 64. Savepoint
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlTransaction transaction =
    connection.BeginTransaction();

PostgreSqlSavepoint point =
    transaction.Savepoint("before_change");

command.ExecuteNonQuery();

point.Rollback();

transaction.Commit();

-- ============================================================================
-- Example 97: 65. SQLSTATE handling
-- Demonstrates: No explicit reader Close() is required.

try {
    command.ExecuteNonQuery();
}
catch (PostgreSqlException exception) {
    if (exception.SqlState == "23505") {
        HandleDuplicate();
    } else {
        throw exception;
    }
}

-- ============================================================================
-- Example 98: 66. Notice handling
-- Demonstrates: No explicit reader Close() is required.

connection.SetNoticeHandler(
    \PostgreSqlNotice -> notice {
        Console.Println(
            notice.Severity
            + ": "
            + notice.Message
        );
    }
);

-- ============================================================================
-- Example 99: 67. Notification handling
-- Demonstrates: No explicit reader Close() is required.

connection.SetNotificationHandler(
    \PostgreSqlNotification -> notification {
        Console.Println(
            notification.Channel
            + ": "
            + notification.Payload
        );
    }
);

connection
    .CreateCommand(
        "LISTEN user_events"
    )
    .ExecuteNonQuery();

-- ============================================================================
-- Example 100: 68. Pipeline
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlPipeline pipeline =
    connection.BeginPipeline();

pipeline.Send(command1);
pipeline.Send(command2);
pipeline.Send(command3);

await pipeline.SyncAsync();

PostgreSqlReader result1 =
    await pipeline.ReceiveAsync();

PostgreSqlReader result2 =
    await pipeline.ReceiveAsync();

PostgreSqlReader result3 =
    await pipeline.ReceiveAsync();

-- ============================================================================
-- Example 101: 69. COPY IN
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlCopyIn copy =
    connection
        .CreateCommand(
            "COPY users(name, age) FROM STDIN"
        )
        .ExecuteCopyIn();

copy.Write(chunk1);
copy.Write(chunk2);

copy.Complete();

-- ============================================================================
-- Example 102: 70. COPY OUT
-- Demonstrates: No explicit reader Close() is required.

PostgreSqlCopyOut copy =
    connection
        .CreateCommand(
            "COPY users TO STDOUT"
        )
        .ExecuteCopyOut();

while (not copy.IsCompleted()) {
    []byte data =
        copy.Read();

    Process(data);
}

