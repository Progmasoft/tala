-- ============================================================================
-- Example 94: 85. MySQL authentication
-- Demonstrates: A public-key file can be supplied:

String connectionString =
    new MySqlConnectionStringBuilder()
        .Host("mysql.example.com")
        .User("app")
        .Password(secret)
        .ServerPublicKeyFile(
            "/etc/app/mysql-public-key.pem"
        )
        .Build();

-- ============================================================================
-- Example 95: 85. MySQL authentication
-- Demonstrates: A default client authentication plugin may be selected explicitly when required:

.DefaultAuthenticationPlugin(
    "caching_sha2_password"
)

-- ============================================================================
-- Example 96: 86. MySqlCommand
-- Demonstrates: TLS remains the preferred normal transport for password confidentiality.

public class MySqlCommand {
    public String Sql { get; }

    public MySqlParameter Bind(
        _ int index,
        _ auto value
    );

    public void ClearBindings();

    public int ParameterCount { get; }

    public void Prepare();
    public Future<void> PrepareAsync();

    public int ExecuteNonQuery();
    public Future<int> ExecuteNonQueryAsync();

    template<typename T>
    public T ExecuteScalar();

    template<typename T>
    public Future<T> ExecuteScalarAsync();

    public MySqlReader ExecuteReader();
    public Future<MySqlReader> ExecuteReaderAsync();

    public MySqlResults ExecuteResults();
    public Future<MySqlResults> ExecuteResultsAsync();

    public MySqlBatch CreateBatch();

    public int AffectedRows { get; }
    public uint LastInsertId { get; }

    public int WarningCount { get; }
    public [MySqlWarning] Warnings();
}

-- ============================================================================
-- Example 97: 87. MySqlParameter
-- Demonstrates: Indexes remain 0-based.

public class MySqlParameter {
    public int Index { get; }

    public auto Value {
        get;
        set;
    }

    public bool IsNull();
}

-- ============================================================================
-- Example 98: 88. Query attributes boundary
-- Demonstrates: Therefore there is no misleading overload such as:

command.Bind("traceparent", value); -- not a SQL named parameter

-- ============================================================================
-- Example 99: 89. MySqlReader
-- Demonstrates: Future support, if added, must use an explicitly named query-attribute API and must
--   not change placeholder semantics.

public class MySqlReader {
    public int RowCount { get; }
    public int ColumnCount { get; }
    public bool HasRows { get; }

    public bool Read();

    public bool IsNull(_ int index);
    public bool IsNull(_ String name);

    template<typename T>
    public T Get(_ int index);

    template<typename T>
    public T Get(_ String name);

    public []byte GetRaw(_ int index);
    public []byte GetRaw(_ String name);

    public String ColumnName(_ int index);
    public int ColumnIndex(_ String name);

    public String OriginalColumnName(_ int index);
    public String TableName(_ int index);
    public String OriginalTableName(_ int index);
    public String DatabaseName(_ int index);

    public MySqlType ColumnType(_ int index);

    public bool IsUnsigned(_ int index);
    public bool IsNullable(_ int index);
    public bool IsPrimaryKey(_ int index);

    public int ColumnSize(_ int index);
    public int ColumnPrecision(_ int index);
    public int ColumnScale(_ int index);

    public int ValueSize(_ int index);

    public void Close();
}

