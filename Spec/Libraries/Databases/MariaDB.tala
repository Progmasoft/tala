    );

    public int ExecuteNonQuery();
    public Future<int> ExecuteNonQueryAsync();

    public void Clear();
}

-- ============================================================================
-- Example 104: 96. MySqlIsolationLevel
-- Demonstrates: If the native combination cannot provide the defined native-batch contract, the
--   operation fails rather than silently changing into a high-level per-row replay loop.

public enum MySqlIsolationLevel {
    READ_UNCOMMITTED,
    READ_COMMITTED,
    REPEATABLE_READ,
    SERIALIZABLE,
}

-- ============================================================================
-- Example 105: 97. MySqlTransaction
-- Demonstrates: If the native combination cannot provide the defined native-batch contract, the
--   operation fails rather than silently changing into a high-level per-row replay loop.

public class MySqlTransaction {
    public MySqlTransactionState State { get; }

    public MySqlIsolationLevel IsolationLevel { get; }
    public bool IsReadOnly { get; }

    public void Commit();
    public Future<void> CommitAsync();

    public void Rollback();
    public Future<void> RollbackAsync();

    public MySqlSavepoint Savepoint(
        _ String name
    );

    public bool IsActive();
}

-- ============================================================================
-- Example 106: 97. MySqlTransaction
-- Demonstrates: If the native combination cannot provide the defined native-batch contract, the
--   operation fails rather than silently changing into a high-level per-row replay loop.

public enum MySqlTransactionState {
    ACTIVE,
    COMMITTED,
    ROLLED_BACK,
    FAILED,
}

