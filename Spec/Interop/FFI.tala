-- Tala language design examples: Foreign Function Interface
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.
-- System.Worlds.* names are compiler-known special interop surfaces. They are not built-in language types or ordinary
-- library namespaces; the compiler supplies their meaning for the selected foreign ABI and imported platform metadata.

-- ============================================================================
-- Example 1: 2. Direction rule
-- Demonstrates: Example:

class Native {
    [DllImport("native.dll")]
    public static extern CInt Add(_ CInt a, _ CInt b);
}

-- ============================================================================
-- Example 2: 2. Direction rule
-- Demonstrates: Example:

[C]
[NoMangle]
public static int Add(_ int left, _ int right) {
    left + right
}

-- ============================================================================
-- Example 3: 3. extern
-- Demonstrates: Example:

public static extern CInt Add(_ CInt a, _ CInt b);

-- ============================================================================
-- Example 4: 3. extern
-- Demonstrates: INVALID:

public static extern CInt Add(_ CInt a, _ CInt b) {
    a + b
}

-- ============================================================================
-- Example 5: 4. DllImport
-- Demonstrates: Example:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

class Native {
    [DllImport("user32.dll")]
    public static extern CInt MessageBox(...);
}

-- ============================================================================
-- Example 6: 4. DllImport
-- Demonstrates: Example:

[DllImport("native.dll")]
public static extern CInt Add(_ CInt a, _ CInt b);

-- ============================================================================
-- Example 7: 5. Explicit DllImport symbol name
-- Demonstrates: Example:

[DllImport(
    "native.dll",
    symbol: "native_add"
)]
public static extern CInt Add(_ CInt a, _ CInt b);

-- ============================================================================
-- Example 8: 6. DylibImport
-- Demonstrates: Example:

class Native {
    [DylibImport("libExample.dylib")]
    public static extern CInt Calculate(_ CInt value);
}

-- ============================================================================
-- Example 9: 7. Explicit DylibImport symbol name
-- Demonstrates: Example:

[DylibImport(
    "libnative.dylib",
    symbol: "native_add"
)]
public static extern CInt Add(_ CInt a, _ CInt b);

-- ============================================================================
-- Example 10: 8. NoMangle
-- Demonstrates: Example:

[C]
[NoMangle]
public static int Add(_ int left, _ int right) {
    left + right
}

-- ============================================================================
-- Example 11: 9. C import direction
-- Demonstrates: Tala imports the module with:

using MyLibrary;

-- ============================================================================
-- Example 12: 10. C module layout
-- Demonstrates: Tala source:

using MyLibrary;

-- ============================================================================
-- Example 13: 11. C export direction
-- Demonstrates: Example callable export:

class Math {
    [C]
    public static int Add(_ int left, _ int right) {
        left + right
    }
}

-- ============================================================================
-- Example 14: 11. C export direction
-- Demonstrates: Example:

[C]
data Point {
    int x;
    int y;
}

-- ============================================================================
-- Example 15: 12. C symbol export
-- Demonstrates: A stable unmangled C symbol may be requested explicitly:

[C]
[NoMangle]
public static int Add(_ int left, _ int right) {
    left + right
}

-- ============================================================================
-- Example 16: 19. CRawPtr<T>
-- Demonstrates: Example:

using System.Worlds.C;

CRawPtr<CInt> ptr;

-- ============================================================================
-- Example 17: 21. Memory.alloc
-- Demonstrates: C/native memory is allocated explicitly with:

using System.Worlds.C;

CRawPtr<CInt> ptr =
    Memory.alloc(CSize.Of(CInt) * 4);

-- ============================================================================
-- Example 18: 22. CSize.Of(T)
-- Demonstrates: Example:

CSize size = CSize.Of(CInt);

-- ============================================================================
-- Example 19: 22. CSize.Of(T)
-- Demonstrates: Four C integers:

CSize.Of(CInt) * 4

-- ============================================================================
-- Example 20: 23. Memory.free
-- Demonstrates: Native memory is released explicitly:

Memory.free(ptr);

-- ============================================================================
-- Example 21: 23. Memory.free
-- Demonstrates: Therefore the following are distinct operations:

Memory.free(ptr);
ptr = cnullptr;

-- ============================================================================
-- Example 22: 24. Complete C allocation example
-- Demonstrates: This mirrors the explicit lifetime model of C.

using System.Worlds.C;

CRawPtr<CInt> ptr =
    Memory.alloc(CSize.Of(CInt) * 4);

Memory.free(ptr);
ptr = cnullptr;

-- ============================================================================
-- Example 23: 26. Objective-C export direction
-- Demonstrates: Example:

[ObjectiveC]
class User {
}

-- ============================================================================
-- Example 24: 27. Objective-C member exposure
-- Demonstrates: Example:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[ObjectiveC]
class User {
    [ObjectiveC]
    public void Print() {
        ...
    }

    public void InternalWork() {
        ...
    }
}

-- ============================================================================
-- Example 25: 28. Objective-C import direction
-- Demonstrates: Tala:

using MyFramework;

-- ============================================================================
-- Example 26: 30. Objective-C interop types
-- Demonstrates: Example:

using System.Worlds.ObjectiveC;

NSString name;
NSURL url;
NSProcessInfo processInfo;

-- ============================================================================
-- Example 27: 31. Swift export direction
-- Demonstrates: Example:

[Swift]
data class User(String name, int age);

-- ============================================================================
-- Example 28: 31. Swift export direction
-- Demonstrates: Members may also be explicitly exposed:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

class User {
    [Swift]
    public SwiftString Name() {
        ...
    }
}

-- ============================================================================
-- Example 29: 32. Swift import direction
-- Demonstrates: Tala imports the package/module with:

using MyLibrary;

-- ============================================================================
-- Example 30: 33. Swift interop namespace
-- Demonstrates: Example:

using System.Worlds.Swift;

SwiftInt count;
SwiftString name;
SwiftBool enabled;

-- ============================================================================
-- Example 31: 35. using imported foreign modules
-- Demonstrates: C:

using MyCLibrary;

-- ============================================================================
-- Example 32: 35. using imported foreign modules
-- Demonstrates: Objective-C:

using MyFramework;

-- ============================================================================
-- Example 33: 35. using imported foreign modules
-- Demonstrates: Swift:

using MySwiftPackage;

-- ============================================================================
-- Example 34: 42. C module import
-- Demonstrates: Tala:

using MyLibrary;

-- ============================================================================
-- Example 35: 43. Objective-C module import
-- Demonstrates: module MyFramework { header "MyFramework.h" export }

using MyFramework;

-- ============================================================================
-- Example 36: 44. Swift package import
-- Demonstrates: Tala:

using MyLibrary;

-- ============================================================================
-- Example 37: 45. Explicit DLL import
-- Demonstrates: Tala:

class Native {
    [DllImport("native.dll")]
    public static extern CInt Add(_ CInt a, _ CInt b);
}

-- ============================================================================
-- Example 38: 46. Explicit native symbol
-- Demonstrates: Tala:

class Native {
    [DllImport(
        "native.dll",
        symbol: "native_add"
    )]
    public static extern CInt Add(_ CInt a, _ CInt b);
}

-- ============================================================================
-- Example 39: 47. Dylib import
-- Demonstrates: Tala:

class Native {
    [DylibImport(
        "libnative.dylib",
        symbol: "native_add"
    )]
    public static extern CInt Add(_ CInt a, _ CInt b);
}

-- ============================================================================
-- Example 40: 48. C export
-- Demonstrates: Tala:

[C]
[NoMangle]
public static int Add(_ int left, _ int right) {
    left + right
}

-- ============================================================================
-- Example 41: 49. Objective-C export
-- Demonstrates: Tala:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[ObjectiveC]
class User {
    [ObjectiveC]
    public void Print() {
        ...
    }
}

-- ============================================================================
-- Example 42: 50. Swift export
-- Demonstrates: Tala:

[Swift]
data class User(String name, int age);

-- ============================================================================
-- Example 43: 51. Native C memory
-- Demonstrates: Tala:

using System.Worlds.C;

CRawPtr<CInt> ptr =
    Memory.alloc(CSize.Of(CInt) * 4);

Memory.free(ptr);
ptr = cnullptr;

-- ============================================================================
-- Example 44: 52. Imported native implementation with body
-- Demonstrates: Tala:

[DllImport("native.dll")]
public static extern CInt Add(_ CInt a, _ CInt b) {
    a + b
}

-- ============================================================================
-- Example 45: 53. DllImport without extern
-- Demonstrates: INVALID because extern cannot have a Tala body.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[DllImport("native.dll")]
public static CInt Add(_ CInt a, _ CInt b) {
    ...
}

-- ============================================================================
-- Example 46: 54. DylibImport without extern
-- Demonstrates: INVALID.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[DylibImport("libnative.dylib")]
public static CInt Add(_ CInt a, _ CInt b) {
    ...
}

-- ============================================================================
-- Example 47: 56. Automatic pointer nulling after free
-- Demonstrates: This behavior is not implied:

Memory.free(ptr);

-- ============================================================================
-- Example 48: 56. Automatic pointer nulling after free
-- Demonstrates: does not automatically perform:

ptr = cnullptr;
