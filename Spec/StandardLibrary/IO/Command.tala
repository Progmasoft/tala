-- Tala language design examples: Command Execution
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: Tala — Command
-- Demonstrates: Typical import:

using System.Diagnostics;

-- ============================================================================
-- Example 2: 2. Basic command creation
-- Demonstrates: Stdio selects how stdin, stdout, and stderr are connected.

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array(
                "commit",
                "-m",
                "'Initial commit'"
            )
        )
        .Stdin(Stdio.NULL)
        .Stdout(Stdio.INHERIT)
        .Stderr(Stdio.INHERIT)
        .Start();

-- ============================================================================
-- Example 3: 3. Builder state
-- Demonstrates: The command may be changed:

CommandBuilder builder =
        new CommandBuilder(
            command: "git",
            arguments: new Array("status")
        );

builder.command = "other-program";

-- ============================================================================
-- Example 4: 3. Builder state
-- Demonstrates: The arguments array may be modified directly:

CommandBuilder command =
        new CommandBuilder(
            command: "git",
            arguments: new Array(
                "commit"
            )
        );

command.arguments.Append("-m");
command.arguments.Append("'Initial commit'");

CommandHandle handle =
        command.Start();

-- ============================================================================
-- Example 5: 4. Argument construction
-- Demonstrates: Example:

new CommandBuilder(
    command: "git",
    arguments: new Array(
        "commit",
        "-m",
        "'Initial commit'"
    )
)
.Start();

-- ============================================================================
-- Example 6: 5. Explicit quoting and escaping
-- Demonstrates: For example:

arguments: new Array(
    "-m",
    "'Initial commit'"
)

-- ============================================================================
-- Example 7: 5. Explicit quoting and escaping
-- Demonstrates: and:

arguments: new Array(
    "-m",
    "\"Initial commit\""
)

-- ============================================================================
-- Example 8: 5. Explicit quoting and escaping
-- Demonstrates: For example, both:

"\"Initial commit\""

-- ============================================================================
-- Example 9: 5. Explicit quoting and escaping
-- Demonstrates: and:

'"Initial commit"'

-- ============================================================================
-- Example 10: 6. No implicit shell
-- Demonstrates: Example:

new CommandBuilder(
    command: "sh",
    arguments: new Array(
        "-c",
        "\"printf '%s\n' *.txt\""
    )
)
.Start();

-- ============================================================================
-- Example 11: 7. Standard I/O
-- Demonstrates: Each channel is configured independently:

builder
    .Stdin(Stdio.NULL)
    .Stdout(Stdio.PIPE)
    .Stderr(Stdio.PIPE);

-- ============================================================================
-- Example 12: 8. Default standard I/O
-- Demonstrates: Therefore:

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array("status")
        )
        .Start();

-- ============================================================================
-- Example 13: 8. Default standard I/O
-- Demonstrates: is equivalent in stdio configuration to:

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array("status")
        )
        .Stdin(Stdio.NULL)
        .Stdout(Stdio.PIPE)
        .Stderr(Stdio.PIPE)
        .Start();

-- ============================================================================
-- Example 14: 10. Stdio.INHERIT
-- Demonstrates: Example:

new CommandBuilder(
    command: "git",
    arguments: new Array("status")
)
.Stdout(Stdio.INHERIT)
.Stderr(Stdio.INHERIT)
.Start();

-- ============================================================================
-- Example 15: 11. Stdio.PIPE
-- Demonstrates: Stdio.PIPE creates a pipe exposed through the returned CommandHandle.

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array("status")
        )
        .Stdout(Stdio.PIPE)
        .Stderr(Stdio.PIPE)
        .Start();

-- ============================================================================
-- Example 16: 11. Stdio.PIPE
-- Demonstrates: Pipe accessors:

StdioInputStream stdin =
        command.Stdin();

StdioOutputStream stdout =
        command.Stdout();

StdioErrorStream stderr =
        command.Stderr();

-- ============================================================================
-- Example 17: 11. Stdio.PIPE
-- Demonstrates: INVALID:

CommandHandle command =
        new CommandBuilder(
            command: "program"
        )
        .Stdout(Stdio.INHERIT)
        .Start();

command.Stdout();

-- ============================================================================
-- Example 18: 12. InheritIO()
-- Demonstrates: InheritIO() sets all three channels to Stdio.INHERIT.

new CommandBuilder(
    command: "git",
    arguments: new Array("status")
)
.InheritIO()
.Start();

-- ============================================================================
-- Example 19: 12. InheritIO()
-- Demonstrates: is equivalent to:

.Stdin(Stdio.INHERIT)
.Stdout(Stdio.INHERIT)
.Stderr(Stdio.INHERIT)

-- ============================================================================
-- Example 20: 12. InheritIO()
-- Demonstrates: Example:

new CommandBuilder(
    command: "program"
)
.InheritIO()
.Stdout(Stdio.PIPE)
.Start();

-- ============================================================================
-- Example 21: 13. Working directory
-- Demonstrates: A child working directory may be set:

new CommandBuilder(
    command: "git",
    arguments: new Array("status")
)
.WorkingDirectory("/project")
.Start();

-- ============================================================================
-- Example 22: 14. Environment
-- Demonstrates: A variable may be set or replaced:

new CommandBuilder(
    command: "program"
)
.Environment("MODE", "release")
.Start();

-- ============================================================================
-- Example 23: 14. Environment
-- Demonstrates: Multiple updates may be chained:

new CommandBuilder(
    command: "program"
)
.Environment("A", "1")
.Environment("B", "2")
.Start();

-- ============================================================================
-- Example 24: 14. Environment
-- Demonstrates: If a variable is set repeatedly, the last value wins:

.Environment("MODE", "debug")
.Environment("MODE", "release")

-- ============================================================================
-- Example 25: 14. Environment
-- Demonstrates: An inherited variable may be removed:

.UnsetEnvironment("SECRET")

-- ============================================================================
-- Example 26: 15. Starting a process
-- Demonstrates: A child process is started with:

CommandHandle handle =
        builder.Start();

-- ============================================================================
-- Example 27: 17. Wait()
-- Demonstrates: Wait() blocks until the child exits:

handle.Wait();

-- ============================================================================
-- Example 28: 18. Wait(forExit:)
-- Demonstrates: A bounded wait is:

bool exited =
        handle.Wait(
            forExit: Duration.Of(seconds: 5)
        );

-- ============================================================================
-- Example 29: 18. Wait(forExit:)
-- Demonstrates: Example:

if (not handle.Wait(
        forExit: Duration.Of(seconds: 5)
    )) {
    handle.Terminate();
}

-- ============================================================================
-- Example 30: 18.1 Zero duration
-- Demonstrates: If the process has already exited, the method returns true immediately.

bool exited =
        handle.Wait(
            forExit: Duration.Zero
        );

-- ============================================================================
-- Example 31: 18.2 Negative duration
-- Demonstrates: A negative duration is invalid:

handle.Wait(
    forExit: Duration.Of(seconds: -1)
);

-- ============================================================================
-- Example 32: 19. Terminate()
-- Demonstrates: Terminate() requests normal/graceful process termination:

handle.Terminate();

-- ============================================================================
-- Example 33: 19. Terminate()
-- Demonstrates: To terminate and then wait:

handle.Terminate();
handle.Wait();

-- ============================================================================
-- Example 34: 20. Kill()
-- Demonstrates: Kill() forcefully terminates the process:

handle.Kill();

-- ============================================================================
-- Example 35: 20. Kill()
-- Demonstrates: To kill and then wait:

handle.Kill();
handle.Wait();

-- ============================================================================
-- Example 36: 21. ExitCode()
-- Demonstrates: The final process exit code is:

int code =
        handle.ExitCode();

-- ============================================================================
-- Example 37: 22. Process state predicates
-- Demonstrates: Running state:

bool running =
        handle.Is(running:);

-- ============================================================================
-- Example 38: 22. Process state predicates
-- Demonstrates: Successful completion:

bool successful =
        handle.Is(successful:);

-- ============================================================================
-- Example 39: 22. Process state predicates
-- Demonstrates: Failure completion:

bool failure =
        handle.Is(failure:);

-- ============================================================================
-- Example 40: 22. Process state predicates
-- Demonstrates: While the process is still running:

handle.Is(successful:); -- false
handle.Is(failure:);    -- false

-- ============================================================================
-- Example 41: 25.1 IllegalArgumentException
-- Demonstrates: Example:

handle.Wait(
    forExit: Duration.Of(seconds: -1)
);

-- ============================================================================
-- Example 42: 25.2 IOException
-- Demonstrates: It is a normal completed-process result observed through:

handle.ExitCode()
handle.Is(failure:)

-- ============================================================================
-- Example 43: 26. Complete inherited-I/O example
-- Demonstrates: It is a normal completed-process result observed through:

using System.Diagnostics;

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array(
                "commit",
                "-m",
                "'Initial commit'"
            )
        )
        .InheritIO()
        .Start();

command.Wait();

if (command.Is(successful:)) {
    Console.Println("Commit completed");
}
else {
    Console.Printfn(
        "git exited with %d",
        command.ExitCode()
    );
}

-- ============================================================================
-- Example 44: 27. Complete pipe example
-- Demonstrates: git commit -m 'Initial commit'

using System.Diagnostics;

CommandHandle command =
        new CommandBuilder(
            command: "git",
            arguments: new Array(
                "status",
                "--short"
            )
        )
        .Stdin(Stdio.NULL)
        .Stdout(Stdio.PIPE)
        .Stderr(Stdio.PIPE)
        .Start();

StdioOutputStream stdout =
        command.Stdout();

StdioErrorStream stderr =
        command.Stderr();

command.Wait();

int exitCode =
        command.ExitCode();

-- ============================================================================
-- Example 45: 28. Complete timeout example
-- Demonstrates: Concrete stream read/write operations are defined by the System.IO stream APIs.

CommandHandle command =
        new CommandBuilder(
            command: "long-running-program"
        )
        .Start();

if (not command.Wait(
        forExit: Duration.Of(seconds: 5)
    )) {
    command.Terminate();

    if (not command.Wait(
            forExit: Duration.Of(seconds: 2)
        )) {
        command.Kill();
        command.Wait();
    }
}

int code =
        command.ExitCode();

-- ============================================================================
-- Example 46: 29. Complete environment example
-- Demonstrates: Wait(forExit:) never implicitly calls Terminate() or Kill().

CommandHandle command =
        new CommandBuilder(
            command: "program",
            arguments: new Array(
                "--mode",
                "worker"
            )
        )
        .WorkingDirectory("/srv/app")
        .Environment("MODE", "production")
        .Environment("WORKERS", "4")
        .UnsetEnvironment("DEBUG_SECRET")
        .Start();

-- ============================================================================
-- Example 47: 30.1 Appending arguments
-- Demonstrates: VALID:

CommandBuilder command =
        new CommandBuilder(
            command: "git",
            arguments: new Array("commit")
        );

command.arguments.Append("-m");
command.arguments.Append("'Initial commit'");

command.Start();

-- ============================================================================
-- Example 48: 30.2 Explicit shell use
-- Demonstrates: VALID:

new CommandBuilder(
    command: "sh",
    arguments: new Array(
        "-c",
        "\"printf '%s\n' *.txt\""
    )
)
.Start();

-- ============================================================================
-- Example 49: 30.3 Negative wait duration
-- Demonstrates: INVALID:

handle.Wait(
    forExit: Duration.Of(seconds: -1)
);

-- ============================================================================
-- Example 50: 30.4 Accessing a non-piped channel
-- Demonstrates: INVALID:

CommandHandle command =
        new CommandBuilder(
            command: "program"
        )
        .Stdout(Stdio.INHERIT)
        .Start();

command.Stdout();

-- ============================================================================
-- Example 51: 30.5 Exit code while running
-- Demonstrates: INVALID:

if (handle.Is(running:)) {
    int code =
            handle.ExitCode();
}

-- ============================================================================
-- Example 52: 30.6 Nonzero child exit
-- Demonstrates: VALID:

handle.Wait();

if (handle.Is(failure:)) {
    int code =
            handle.ExitCode();
}
