-- Tala language design examples: File I/O
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: Tala — File I/O
-- Demonstrates: Typical imports:

using System.IO;
using System.IO.File;
using System.IO.Charset;
using System.IO.Buffer;

-- ============================================================================
-- Example 2: 1.1 Path creation
-- Demonstrates: Files performs filesystem operations.

Path path = Path.Of(value: "test.txt");

-- ============================================================================
-- Example 3: Parent
-- Demonstrates: Parent() FileName() GetName() Resolve(...) Normalize() IsAbsolute() ToAbsolutePath()

Path parent = path.Parent();

-- ============================================================================
-- Example 4: FileName
-- Demonstrates: Returns the parent path representation when one exists.

Path path =
    Path.Of(value: "data/users/profile.txt");

Path file = path.FileName();

-- ============================================================================
-- Example 5: GetName
-- Demonstrates: Path.Of(value: "profile.txt")

String name = path.GetName();

-- ============================================================================
-- Example 6: Resolve
-- Demonstrates: If there is no final name component, GetName() returns null.

Path base =
    Path.Of(value: "data/users");

Path file =
    base.Resolve(value: "profile.txt");

-- ============================================================================
-- Example 7: Normalize
-- Demonstrates: No filesystem access occurs.

Path normalized = path.Normalize();

-- ============================================================================
-- Example 8: IsAbsolute
-- Demonstrates: It does not resolve symbolic links and does not canonicalize through filesystem

bool absolute = path.IsAbsolute();

-- ============================================================================
-- Example 9: ToAbsolutePath
-- Demonstrates: No filesystem existence check occurs.

Path absolute = path.ToAbsolutePath();

-- ============================================================================
-- Example 10: 2. Charset
-- Demonstrates: Example:

Charset utf8 = StandardCharsets.UTF_8;

Console.Println(utf8.Name());

-- ============================================================================
-- Example 11: 3.1 ReadString
-- Demonstrates: When decoding, the BOM is consumed as encoding metadata and is not returned as String

String text = Files.ReadString(path);

-- ============================================================================
-- Example 12: 3.1 ReadString
-- Demonstrates: Explicit charset:

String text =
    Files.ReadString(
        path,
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 13: 3.2 WriteString
-- Demonstrates: If the required file does not exist, FileNotFoundException may be thrown.

Files.WriteString(
    path,
    "Hallo Tala IO!"
);

-- ============================================================================
-- Example 14: 3.2 WriteString
-- Demonstrates: Explicit charset:

Files.WriteString(
    path,
    text,
    StandardCharsets.UTF_8
);

-- ============================================================================
-- Example 15: 3.3 Append String
-- Demonstrates: Example:

Files.WriteString(
    path,
    "Sonradan eklenen yazı\n",
    StandardCharsets.UTF_8,
    StandardOpenOption.APPEND
);

-- ============================================================================
-- Example 16: 4.1 String to bytes
-- Demonstrates: APPEND writes at the end of the existing file instead of overwriting its contents.

String text = "Merhaba dünya";

Array<byte, _> bytes =
    text.GetBytes(
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 17: 4.2 Write
-- Demonstrates: The array type system is defined outside this document.

Files.Write(path, data);

-- ============================================================================
-- Example 18: 4.2 Write
-- Demonstrates: Append:

Files.Write(
    path,
    data,
    StandardOpenOption.APPEND
);

-- ============================================================================
-- Example 19: 4.3 ReadAllBytes
-- Demonstrates: It may throw checked IOException.

Array<byte, _> data =
    Files.ReadAllBytes(path);

-- ============================================================================
-- Example 20: 4.4 Bytes to String
-- Demonstrates: If the required file does not exist, FileNotFoundException may be thrown.

String text =
    String.Of(
        value: data,
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 21: 5.1 Exists
-- Demonstrates: The selected charset controls decoding.

bool exists = Files.Exists(path);

-- ============================================================================
-- Example 22: 5.2 NotExists
-- Demonstrates: A real metadata/I/O failure may throw checked IOException.

bool absent = Files.NotExists(path);

-- ============================================================================
-- Example 23: 5.2 NotExists
-- Demonstrates: It is not equivalent to:

not Files.Exists(path)

-- ============================================================================
-- Example 24: 5.3 Files.Is(...)
-- Demonstrates: Predicates use named arguments.

Files.Is(regularFile: path)
Files.Is(directory: path)
Files.Is(readable: path)
Files.Is(writable: path)
Files.Is(executable: path)
Files.Is(hidden: path)
Files.Is(symbolicLink: path)
Files.Is(sameFile: path1, path2)

-- ============================================================================
-- Example 25: 6.1 Size
-- Demonstrates: Metadata/access queries may throw checked IOException when filesystem state cannot be
--   read normally.

int size = Files.Size(path);

-- ============================================================================
-- Example 26: 6.2 Last-modified time
-- Demonstrates: The operation may throw checked IOException.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

Files.GetLastModifiedTime(path)
Files.SetLastModifiedTime(path, ...)

-- ============================================================================
-- Example 27: 6.3 Owner
-- Demonstrates: These operations may throw checked IOException.

Files.GetOwner(path)

-- ============================================================================
-- Example 28: 6.4 Unix byte permissions
-- Demonstrates: It may throw checked IOException.

Files.GetUnixBytePermission(path)

-- ============================================================================
-- Example 29: 7.1 Single directory
-- Demonstrates: If Unix permission semantics are unavailable on the platform/filesystem, the operation
--   throws checked IOException rather than fabricating them.

Path path = Path.Of(value: "data");

Files.CreateDirectory(path);

-- ============================================================================
-- Example 30: 7.2 Directory chain
-- Demonstrates: If the target already exists as a directory, this form throws checked IOException.

Path path =
    Path.Of(value: "data/users/images");

Files.CreateDirectory(all: path);

-- ============================================================================
-- Example 31: 8. Delete
-- Demonstrates: There is no separate CreateDirectories API.

Files.Delete(path);

-- ============================================================================
-- Example 32: 9.1 Copy
-- Demonstrates: StandardCopyOption.REPLACEEXISTING StandardCopyOption.ATOMICMOVE

Files.Copy(source, target);

-- ============================================================================
-- Example 33: 9.1 Copy
-- Demonstrates: Replacement:

Files.Copy(
    source,
    target,
    StandardCopyOption.REPLACE_EXISTING
);

-- ============================================================================
-- Example 34: 9.2 Move
-- Demonstrates: The core Copy API does not recursively copy a directory tree.

Files.Move(source, target);

-- ============================================================================
-- Example 35: 9.2 Move
-- Demonstrates: Example:

Path source = Path.Of(value: "old.txt");
Path target = Path.Of(value: "new.txt");

Files.Move(source, target);

-- ============================================================================
-- Example 36: 9.2 Move
-- Demonstrates: Replacement:

Files.Move(
    source,
    target,
    StandardCopyOption.REPLACE_EXISTING
);

-- ============================================================================
-- Example 37: 9.3 Atomic move
-- Demonstrates: A normal move is not required to silently emulate an unavailable move by
--   copy-and-delete.

Files.Move(
    source,
    target,
    StandardCopyOption.ATOMIC_MOVE
);

-- ============================================================================
-- Example 38: 10. Symbolic links
-- Demonstrates: Examples that normally follow links:

Files.Exists(path);
Files.Is(regularFile: path);
Files.Size(path);
Files.ReadString(path);
Files.GetLastModifiedTime(path);

-- ============================================================================
-- Example 39: 10. Symbolic links
-- Demonstrates: Examples:

Files.Is(
    regularFile: path,
    StandardLinkOption.NOFOLLOW_LINKS
);

-- ============================================================================
-- Example 40: 10. Symbolic links
-- Demonstrates: Examples:

Files.GetLastModifiedTime(
    path,
    StandardLinkOption.NOFOLLOW_LINKS
);

-- ============================================================================
-- Example 41: 11.2 Allocation
-- Demonstrates: 0 <= Position <= Limit <= Capacity

ByteBuffer buffer =
    ByteBuffer.Allocate(10);

-- ============================================================================
-- Example 42: 11.3 Append
-- Demonstrates: Creates a mutable buffer with capacity 10.

buffer.Append(StaticCast<byte>(10));

-- ============================================================================
-- Example 43: 11.4 Flip
-- Demonstrates: Writes at the current position and advances the position.

buffer.Flip();

-- ============================================================================
-- Example 44: 11.4 Flip
-- Demonstrates: Example:

ByteBuffer buffer =
    ByteBuffer.Allocate(10);

buffer.Append(StaticCast<byte>(10));
buffer.Append(StaticCast<byte>(20));
buffer.Append(StaticCast<byte>(30));

buffer.Flip();

while (buffer.HasRemaining()) {
    Console.Println(buffer.Get());
}

-- ============================================================================
-- Example 45: 11.5 Clear
-- Demonstrates: Example:

buffer.Clear();

-- ============================================================================
-- Example 46: 11.6 Rewind
-- Demonstrates: The underlying storage need not be physically cleared.

buffer.Rewind();

-- ============================================================================
-- Example 47: 11.7 Remaining
-- Demonstrates: The current limit is preserved.

int count = buffer.Remaining();
bool has = buffer.HasRemaining();

-- ============================================================================
-- Example 48: 11.8 Sequential Get
-- Demonstrates: Remaining() == Limit - Position HasRemaining() == Remaining() > 0

byte value = buffer.Get();

-- ============================================================================
-- Example 49: 11.9 Indexed Get
-- Demonstrates: It is unchecked.

byte value =
    buffer.Get(index: 2);

-- ============================================================================
-- Example 50: 11.10 Indexed Set
-- Demonstrates: IndexOutOfBoundsException

buffer.Set(
    index: 2,
    value
);

-- ============================================================================
-- Example 51: 13. Typed ByteBuffer views
-- Demonstrates: A ByteBuffer may expose typed views:

IntBuffer ints =
    bytes.AsIntBuffer();

FloatBuffer floats =
    bytes.AsFloatBuffer();

-- ============================================================================
-- Example 52: 13. Typed ByteBuffer views
-- Demonstrates: Example:

bytes.Order(
    ByteOrder.LITTLE_ENDIAN
);

IntBuffer ints =
    bytes.AsIntBuffer();

-- ============================================================================
-- Example 53: 14. FileInputStream
-- Demonstrates: Opening:

FileInputStream input =
    FileInputStream.Of(path);

-- ============================================================================
-- Example 54: 15. FileOutputStream
-- Demonstrates: Opening:

FileOutputStream output =
    FileOutputStream.Of(path);

-- ============================================================================
-- Example 55: 15. FileOutputStream
-- Demonstrates: Append:

FileOutputStream output =
    FileOutputStream.Of(
        path,
        StandardOpenOption.APPEND
    );

-- ============================================================================
-- Example 56: 16.1 Flush
-- Demonstrates: I/O operations may throw checked IOException.

output.Flush();

-- ============================================================================
-- Example 57: 16.2 Close
-- Demonstrates: Streams close explicitly:

FileInputStream input =
    FileInputStream.Of(path);

defer {
    input.Close();
}

-- ============================================================================
-- Example 58: 16.2 Close
-- Demonstrates: and:

FileOutputStream output =
    FileOutputStream.Of(path);

defer {
    output.Close();
}

-- ============================================================================
-- Example 59: 17. Stream position and seek
-- Demonstrates: Positions are byte offsets.

int position =
    input.Position();

-- ============================================================================
-- Example 60: 17. Stream position and seek
-- Demonstrates: Absolute seek:

input.Seek(offset: 0);

-- ============================================================================
-- Example 61: 17. Stream position and seek
-- Demonstrates: Example:

input.Seek(
    offset: -16,
    origin: SeekOrigin.CURRENT
);

-- ============================================================================
-- Example 62: 18. BufferedReader
-- Demonstrates: Example:

BufferedReader reader =
    BufferedReader.Of(
        FileInputStream.Of(path),
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 63: 19. BufferedWriter
-- Demonstrates: Example:

BufferedWriter writer =
    BufferedWriter.Of(
        FileOutputStream.Of(path),
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 64: 20. Buffered wrapper ownership
-- Demonstrates: Example:

FileInputStream file =
    FileInputStream.Of(path);

BufferedReader reader =
    BufferedReader.Of(
        file,
        StandardCharsets.UTF_8
    );

reader.Close();

-- file remains independently managed

-- ============================================================================
-- Example 65: 21. DataInputStream
-- Demonstrates: Example:

DataInputStream input =
    DataInputStream.Of(
        FileInputStream.Of(path)
    );

-- ============================================================================
-- Example 66: 21. DataInputStream
-- Demonstrates: Explicit byte order:

DataInputStream input =
    DataInputStream.Of(
        FileInputStream.Of(path),
        ByteOrder.BIG_ENDIAN
    );

-- ============================================================================
-- Example 67: 22. DataOutputStream
-- Demonstrates: Example:

DataOutputStream output =
    DataOutputStream.Of(
        FileOutputStream.Of(path)
    );

-- ============================================================================
-- Example 68: 22. DataOutputStream
-- Demonstrates: Explicit order:

DataOutputStream output =
    DataOutputStream.Of(
        FileOutputStream.Of(path),
        ByteOrder.BIG_ENDIAN
    );

-- ============================================================================
-- Example 69: 23.1 Raw encoded String
-- Demonstrates: String framing is explicit.

output.WriteString(
    value,
    StandardCharsets.UTF_8
);

-- ============================================================================
-- Example 70: 23.1 Raw encoded String
-- Demonstrates: Reading therefore requires an explicit byte length:

String text =
    input.ReadString(
        length: 32,
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 71: 23.2 Length-prefixed String
-- Demonstrates: Writing:

output.WriteLengthPrefixedString(
    value,
    StandardCharsets.UTF_8
);

-- ============================================================================
-- Example 72: 23.2 Length-prefixed String
-- Demonstrates: Reading:

String text =
    input.ReadLengthPrefixedString(
        StandardCharsets.UTF_8
    );

-- ============================================================================
-- Example 73: 24. Data-stream wrapper ownership
-- Demonstrates: Example:

FileInputStream file =
    FileInputStream.Of(path);

DataInputStream data =
    DataInputStream.Of(file);

data.Close();

-- file remains independently managed

-- ============================================================================
-- Example 74: 25.2 FileNotFoundException
-- Demonstrates: Thus:

public static void Main()
    throws IOException {
}

-- ============================================================================
-- Example 75: 26.1 Read a text file
-- Demonstrates: IndexOutOfBoundsException

using System.IO.File;
using System.IO;

public class Main {
    public static void Main()
        throws IOException {

        String text =
            Files.ReadString(
                Path.Of(
                    value: "example.txt"
                )
            );

        Console.Println(text);
    }
}

-- ============================================================================
-- Example 76: 26.2 Write then read
-- Demonstrates: IndexOutOfBoundsException

using System.IO.File;
using System.IO;

public class Main {
    public static void Main()
        throws IOException {

        Path path =
            Path.Of(value: "test.txt");

        Files.WriteString(
            path,
            "Hallo Tala IO!"
        );

        String content =
            Files.ReadString(path);

        Console.Println(content);
    }
}

-- ============================================================================
-- Example 77: 26.3 Explicit UTF-8 binary/text workflow
-- Demonstrates: UTF32LE

Path path =
    Path.Of(value: "test.txt");

Array<byte, _> data =
    "Merhaba Tala IO\n"
        .GetBytes(
            StandardCharsets.UTF_8
        );

Files.Write(path, data);

Console.Printfn(
    "Regular file: %b",
    Files.Is(regularFile: path)
);

Console.Printfn(
    "Directory: %b",
    Files.Is(directory: path)
);

int size = Files.Size(path);

Console.Printfn(
    "Size: %d byte",
    size
);

Array<byte, _> readData =
    Files.ReadAllBytes(path);

String text =
    String.Of(
        value: readData,
        StandardCharsets.UTF_8
    );

Console.Println("İçerik:");
Console.Println(text);

Files.WriteString(
    path,
    "Sonradan eklenen yazı\n",
    StandardCharsets.UTF_8,
    StandardOpenOption.APPEND
);

String finalText =
    Files.ReadString(
        path,
        StandardCharsets.UTF_8
    );

Console.Println("Son hali:");
Console.Println(finalText);

-- ============================================================================
-- Example 78: 26.4 Atomic move
-- Demonstrates: UTF32LE

Path source =
    Path.Of(value: "old.txt");

Path target =
    Path.Of(value: "new.txt");

Files.Move(
    source,
    target,
    StandardCopyOption.ATOMIC_MOVE
);

-- ============================================================================
-- Example 79: 26.5 Create directory chain
-- Demonstrates: If atomicity cannot be guaranteed, checked IOException is thrown.

Path path =
    Path.Of(value: "data/users/images");

Files.CreateDirectory(all: path);

-- ============================================================================
-- Example 80: 26.6 Buffer
-- Demonstrates: If atomicity cannot be guaranteed, checked IOException is thrown.

ByteBuffer buffer =
    ByteBuffer.Allocate(10);

buffer.Append(StaticCast<byte>(10));
buffer.Append(StaticCast<byte>(20));
buffer.Append(StaticCast<byte>(30));

buffer.Flip();

while (buffer.HasRemaining()) {
    Console.Println(buffer.Get());
}

-- ============================================================================
-- Example 81: 26.7 File stream with explicit cleanup
-- Demonstrates: If atomicity cannot be guaranteed, checked IOException is thrown.

FileInputStream input =
    FileInputStream.Of(path);

defer {
    input.Close();
}

byte value =
    input.Read();

-- ============================================================================
-- Example 82: 26.8 BufferedReader ownership
-- Demonstrates: If atomicity cannot be guaranteed, checked IOException is thrown.

FileInputStream file =
    FileInputStream.Of(path);

defer {
    file.Close();
}

BufferedReader reader =
    BufferedReader.Of(
        file,
        StandardCharsets.UTF_8
    );

defer {
    reader.Close();
}

String text =
    reader.ReadToEnd();

-- ============================================================================
-- Example 83: 26.9 Typed data output
-- Demonstrates: The wrapper and underlying stream are managed independently.

FileOutputStream file =
    FileOutputStream.Of(path);

defer {
    file.Close();
}

DataOutputStream output =
    DataOutputStream.Of(
        file,
        ByteOrder.LITTLE_ENDIAN
    );

defer {
    output.Close();
}

output.WriteInt(42);
output.WriteFloat(12.5);
output.WriteBool(true);
