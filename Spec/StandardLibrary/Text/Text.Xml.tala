-- Tala language design examples: System.Text.Xml
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 1. Namespace and Core Surface
-- Demonstrates: The XML API is provided by:

using System.Text.Xml;

-- ============================================================================
-- Example 2: 2.1 Creating an ObjectMapper
-- Demonstrates: An XML ObjectMapper is created through XmlMapper.Builder().

ObjectMapper mapper = XmlMapper.Builder()
        .Build();

-- ============================================================================
-- Example 3: 2.1 Creating an ObjectMapper
-- Demonstrates: Example:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardCComments(true)
        .XmlCDataEnabled(true)
        .Build();

-- ============================================================================
-- Example 4: 2.2 Serialization
-- Demonstrates: WriteAsString(...) serializes a value to XML text.

String xml = mapper.WriteAsString(value);

-- ============================================================================
-- Example 5: 2.3 Deserialization
-- Demonstrates: ReadValue<T>(...) parses XML text and maps it to T.

User user = mapper.ReadValue<User>(xml);

-- ============================================================================
-- Example 6: 3. Serializer Options
-- Demonstrates: XmlSerializerOptions stores XML parser/serializer behavior.

XmlSerializerOptions options = XmlSerializerOptions.NewBuilder()
        .XmlEnabledXmlns(true)
        .XmlCDataEnabled(true)
        .Build();

-- ============================================================================
-- Example 7: 4. Standard XML Comments
-- Demonstrates: The option:

.XmlNonstandardDisableXmlComments(true)

-- ============================================================================
-- Example 8: 4. Standard XML Comments
-- Demonstrates: Example:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardDisableXmlComments(true)
        .Build();

-- ============================================================================
-- Example 9: 5. XmlNonstandardCComments
-- Demonstrates: When enabled:

.XmlNonstandardCComments(true)

-- ============================================================================
-- Example 10: 5. XmlNonstandardCComments
-- Demonstrates: Example:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardCComments(true)
        .Build();

-- ============================================================================
-- Example 11: 7. Comment Option Independence
-- Demonstrates: Example:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardCComments(true)
        .XmlNonstandardDisableXmlComments(true)
        .Build();

-- ============================================================================
-- Example 12: 8. XmlNonstandardEnabledNull
-- Demonstrates: Example:

data User {
    String Name,
    Optional<String> Nickname,
}

-- ============================================================================
-- Example 13: 8. XmlNonstandardEnabledNull
-- Demonstrates: When:

.XmlNonstandardEnabledNull(false)

-- ============================================================================
-- Example 14: 10. Default data Mapping
-- Demonstrates: A Tala data declaration maps naturally to an XML element.

data User {
    String Name,
    int Age,
}

-- ============================================================================
-- Example 15: 11. [XmlAttribute]
-- Demonstrates: A mapped field may be written as an XML attribute.

data User {
    [XmlAttribute]
    int Id,

    String Name,
}

-- ============================================================================
-- Example 16: 12. [XmlElement(...)]
-- Demonstrates: [XmlElement("name")] maps a field to a child element with an explicit XML element

data User {
    [XmlElement("display-name")]
    String Name,
}

-- ============================================================================
-- Example 17: 13. [XmlAttribute(...)]
-- Demonstrates: [XmlAttribute("name")] maps a field to an XML attribute with an explicit name.

data User {
    [XmlAttribute("id")]
    int Id,

    String Name,
}

-- ============================================================================
-- Example 18: 15. [XmlRoot(...)]
-- Demonstrates: The default root element name is the data declaration name.

data User {
    String Name,
}

-- ============================================================================
-- Example 19: 15. [XmlRoot(...)]
-- Demonstrates: The root element name may be overridden:

[XmlRoot("user")]
data User {
    String Name,
}

-- ============================================================================
-- Example 20: 15. [XmlRoot(...)]
-- Demonstrates: Example:

[XmlRoot("address-document")]
data Address {
    String City,
}

data User {
    Address Address,
}

-- ============================================================================
-- Example 21: 16. Nested data Mapping
-- Demonstrates: Nested data values map to nested child elements.

data Address {
    String City,
    String Country,
}

data User {
    String Name,
    Address Address,
}

-- ============================================================================
-- Example 22: 17. Array<T> Mapping
-- Demonstrates: Array<T> maps to repeated child elements.

data User {
    String Name,
    Array<String> Roles,
}

-- ============================================================================
-- Example 23: 18. Array Element Name Override
-- Demonstrates: A repeated element name may be overridden with [XmlElement(...)].

data User {
    [XmlElement("role")]
    Array<String> Roles,
}

-- ============================================================================
-- Example 24: 18. Array Element Name Override
-- Demonstrates: Nested data arrays follow the same rule:

data Team {
    [XmlElement("member")]
    Array<User> Members,
}

-- ============================================================================
-- Example 25: 19. Optional<T> Mapping
-- Demonstrates: Optional<T> represents optional element presence.

data User {
    String Name,
    Optional<String> Nickname,
}

-- ============================================================================
-- Example 26: 20. [XmlText]
-- Demonstrates: [XmlText] maps a field to the direct text content of the containing XML element.

data Message {
    [XmlAttribute("lang")]
    String Language,

    [XmlText]
    String Content,
}

-- ============================================================================
-- Example 27: 21. XmlCDataEnabled
-- Demonstrates: When enabled:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlCDataEnabled(true)
        .Build();

-- ============================================================================
-- Example 28: 22. [XmlCData]
-- Demonstrates: [XmlCData] requests CDATA mapping for a text-compatible field.

data Script {
    [XmlCData]
    String Content,
}

-- ============================================================================
-- Example 29: 23. XmlEnabledXmlns
-- Demonstrates: When enabled:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlEnabledXmlns(true)
        .Build();

-- ============================================================================
-- Example 30: 24. DOM Namespace Access
-- Demonstrates: When standard namespace support is enabled, XmlElement exposes namespace metadata.

String name = element.Name();
Optional<String> prefix = element.Prefix();
Optional<String> namespaceUri = element.NamespaceUri();

-- ============================================================================
-- Example 31: 25. [XmlNamespace(...)]
-- Demonstrates: Example:

[XmlNamespace("urn:user")]
data User {
    String Name,
}

-- ============================================================================
-- Example 32: 25. [XmlNamespace(...)]
-- Demonstrates: A prefix may be specified:

[XmlNamespace("urn:user", prefix: "u")]
data User {
    String Name,
}

-- ============================================================================
-- Example 33: 25. [XmlNamespace(...)]
-- Demonstrates: Field-level namespace metadata may override the inherited/default namespace mapping
--   for that field.

data User {
    [XmlNamespace("urn:profile", prefix: "p")]
    String Name,
}

-- ============================================================================
-- Example 34: 27. Standard xmlns and Tala Namespace Syntax Are Independent
-- Demonstrates: Example:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlEnabledXmlns(false)
        .XmlNonstandardTalaStyleNamespaces(true)
        .Build();

-- ============================================================================
-- Example 35: 28. XmlNonstandardJavaScriptEnabled
-- Demonstrates: When enabled:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardJavaScriptEnabled(true)
        .Build();

-- ============================================================================
-- Example 36: 34. XML Declaration
-- Demonstrates: XML declaration emission is controlled by:

XmlDeclarationEnabled(true|false)

-- ============================================================================
-- Example 37: 34. XML Declaration
-- Demonstrates: When enabled:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlDeclarationEnabled(true)
        .Build();

-- ============================================================================
-- Example 38: 36. DTD Support
-- Demonstrates: When enabled:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlDtdEnabled(true)
        .Build();

-- ============================================================================
-- Example 39: 38. Unknown XML Properties
-- Demonstrates: Example model:

data User {
    String Name,
}

-- ============================================================================
-- Example 40: 39. Ignoring Unknown XML Properties
-- Demonstrates: Unknown mapped XML content may be ignored:

ObjectMapper mapper = XmlMapper.Builder()
        .Disable(
            DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES
        )
        .Build();

-- ============================================================================
-- Example 41: 40. [XmlIgnore]
-- Demonstrates: [XmlIgnore] removes a field from both serialization and deserialization.

data User {
    String Name,

    [XmlIgnore]
    String InternalToken,
}

-- ============================================================================
-- Example 42: 41. XmlDocument
-- Demonstrates: Parse:

XmlDocument document = XmlDocument.Parse(xml);

-- ============================================================================
-- Example 43: 41. XmlDocument
-- Demonstrates: Parse with options:

XmlDocument document =
        XmlDocument.Parse(xml, options);

-- ============================================================================
-- Example 44: 41. XmlDocument
-- Demonstrates: The root element is obtained with:

XmlElement root = document.RootElement();

-- ============================================================================
-- Example 45: 42. XmlElement
-- Demonstrates: Core methods include:

String name = element.Name();
String text = element.Text();

-- ============================================================================
-- Example 46: 42. XmlElement
-- Demonstrates: Attribute access:

Optional<String> id =
        element.Attribute("id");

-- ============================================================================
-- Example 47: 42. XmlElement
-- Demonstrates: Child lookup:

Optional<XmlElement> child =
        element.FirstElement("Name");

-- ============================================================================
-- Example 48: 42. XmlElement
-- Demonstrates: Repeated child lookup:

Array<XmlElement> children =
        element.Elements("Role");

-- ============================================================================
-- Example 49: 42. XmlElement
-- Demonstrates: Usage:

XmlElement root = document.RootElement();

String id = root.Attribute("id").Value();

String name =
        root.FirstElement("Name")
            .Value()
            .Text();

Array<XmlElement> roles =
        root.Elements("Role");

-- ============================================================================
-- Example 50: 43. XmlDocument Lifetime
-- Demonstrates: The document may be explicitly closed:

document.Close();

-- ============================================================================
-- Example 51: 43. XmlDocument Lifetime
-- Demonstrates: and may be used with normal Tala cleanup:

XmlDocument document = XmlDocument.Parse(xml);
defer document.Close();

-- ============================================================================
-- Example 52: 43. XmlDocument Lifetime
-- Demonstrates: After the document is closed, elements originating from that document are no longer
--   valid for DOM access.
-- Expected result: compile-time rejection; the INVALID marker is normative.

XmlDocument document = XmlDocument.Parse(xml);
XmlElement root = document.RootElement();

document.Close();

root.Text(); -- INVALID runtime state

-- ============================================================================
-- Example 53: 45. Combined Nonstandard Example
-- Demonstrates: Example configuration:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlNonstandardCComments(true)
        .XmlNonstandardHashComments(true)
        .XmlNonstandardDisableXmlComments(true)
        .XmlNonstandardEnabledNull(true)
        .XmlNonstandardTalaStyleNamespaces(true)
        .XmlNonstandardJavaScriptEnabled(true)
        .Build();

-- ============================================================================
-- Example 54: 46. Standard-Oriented Example
-- Demonstrates: Default builder:

ObjectMapper mapper = XmlMapper.Builder()
        .Build();

-- ============================================================================
-- Example 55: 47. Attribute Mapping Example
-- Demonstrates: Model:

[XmlRoot("user")]
data User {
    [XmlAttribute("id")]
    int Id,

    [XmlElement("display-name")]
    String Name,

    [XmlIgnore]
    String InternalToken,
}

-- ============================================================================
-- Example 56: 48. Optional and Repeated Example
-- Demonstrates: Model:

data User {
    String Name,

    Optional<String> Nickname,

    [XmlElement("role")]
    Array<String> Roles,
}

-- ============================================================================
-- Example 57: 49. CDATA Example
-- Demonstrates: Model:

data Script {
    [XmlCData]
    String Content,
}

-- ============================================================================
-- Example 58: 49. CDATA Example
-- Demonstrates: Mapper:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlCDataEnabled(true)
        .Build();

-- ============================================================================
-- Example 59: 50. Namespace Example
-- Demonstrates: Model:

[XmlNamespace("urn:user", prefix: "u")]
data User {
    String Name,
}

-- ============================================================================
-- Example 60: 50. Namespace Example
-- Demonstrates: Mapper:

ObjectMapper mapper = XmlMapper.Builder()
        .XmlEnabledXmlns(true)
        .Build();
