-- Tala language design examples: Time
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 1. Scope
-- Demonstrates: System.Timing.Time defines the standard Tala time-of-day, UTC-offset, instant,
--   timezone, clock, formatted zoned-time, and monotonic elapsed-time APIs.

namespace System.Timing.Time;

-- ============================================================================
-- Example 2: 2. LocalTime
-- Demonstrates: LocalTime represents a time of day only. It has no date, timezone, UTC offset, or

public data LocalTime {
    public LocalTime(
        int hour,
        int minute,
        int second = 0,
        int nanosecond = 0
    );

    public int Hour { get; }
    public int Minute { get; }
    public int Second { get; }
    public int Nanosecond { get; }

    public static LocalTime Midnight();
    public static LocalTime Noon();

    public static LocalTime Parse(_ String value);

    public String ToString();

    public int CompareTo(_ LocalTime other);

    public int NanosecondsSinceMidnight();
}

-- ============================================================================
-- Example 3: 2. LocalTime
-- Demonstrates: Valid:

LocalTime morning =
    new LocalTime(
        hour: 9,
        minute: 30
    );

LocalTime precise =
    new LocalTime(
        hour: 13,
        minute: 6,
        second: 42,
        nanosecond: 125'000'000
    );

-- ============================================================================
-- Example 4: 2. LocalTime
-- Demonstrates: Leap second values are not represented directly:
-- Expected result: compile-time rejection; the INVALID marker is normative.

LocalTime leap =
    new LocalTime(
        hour: 23,
        minute: 59,
        second: 60
    ); -- INVALID

-- ============================================================================
-- Example 5: 2. LocalTime
-- Demonstrates: Parsing:

LocalTime time =
    LocalTime.Parse(
        "18:45:30.500"
    );

-- ============================================================================
-- Example 6: 2. LocalTime
-- Demonstrates: Comparison is chronological within one abstract day:

new LocalTime(9, 0)
    <
new LocalTime(12, 0);

-- ============================================================================
-- Example 7: 2. LocalTime
-- Demonstrates: Relational operator surface:

public static bool Operator<=> (
    _ LocalTime left,
    _ LocalTime right
);

public static bool Operator<>>(
    _ LocalTime left,
    _ LocalTime right
);

public static bool Operator<<>(
    _ LocalTime left,
    _ LocalTime right
);

public static bool Operator<<=>(
    _ LocalTime left,
    _ LocalTime right
);

-- ============================================================================
-- Example 8: 3. LocalTimeShift
-- Demonstrates: Adding or subtracting Duration must not silently lose day overflow.

public data LocalTimeShift {
    LocalTime Time,
    longint DayOffset,
}

-- ============================================================================
-- Example 9: 3. LocalTimeShift
-- Demonstrates: LocalTimeShift is a CoW value type. It is not itself a civil date-time.

public static LocalTimeShift Operator<+>(
    _ LocalTime time,
    _ Duration duration
);

public static LocalTimeShift Operator<->(
    _ LocalTime time,
    _ Duration duration
);

-- ============================================================================
-- Example 10: 3. LocalTimeShift
-- Demonstrates: Two LocalTime values subtract linearly within one abstract day:

public static Duration Operator<->(
    _ LocalTime left,
    _ LocalTime right
);

-- ============================================================================
-- Example 11: 4. UtcOffset
-- Demonstrates: UtcOffset represents a fixed offset from UTC. It does not contain IANA timezone rules,
--   DST, historical transitions, or location names.

public data UtcOffset {
    public UtcOffset(
        int hours,
        int minutes = 0,
        int seconds = 0
    );

    public int Hours { get; }
    public int Minutes { get; }
    public int Seconds { get; }

    public int TotalSeconds();

    public static UtcOffset Utc();

    public static UtcOffset Parse(_ String value);

    public String ToString();

    public int CompareTo(_ UtcOffset other);
}

-- ============================================================================
-- Example 12: 4. UtcOffset
-- Demonstrates: Examples:

UtcOffset utc =
    UtcOffset.Utc();

UtcOffset turkey =
    new UtcOffset(hours: 3);

UtcOffset india =
    new UtcOffset(
        hours: 5,
        minutes: 30
    );

-- ============================================================================
-- Example 13: 4. UtcOffset
-- Demonstrates: The sign belongs to the complete offset:

new UtcOffset(
    hours: -5,
    minutes: 30
);

-- ============================================================================
-- Example 14: 4. UtcOffset
-- Demonstrates: Minutes and seconds are not independently signed:
-- Expected result: compile-time rejection; the INVALID marker is normative.

new UtcOffset(
    hours: 5,
    minutes: -30
); -- INVALID

-- ============================================================================
-- Example 15: 5. Instant
-- Demonstrates: Instant represents one exact position on the global timeline. It contains no
--   LocalTime, date, UtcOffset, TimeZone, or location.

public data Instant {
    public static Instant Epoch();

    public static Instant FromUnixSeconds(
        _ longint seconds
    );

    public static Instant FromUnixMilliseconds(
        _ longint milliseconds
    );

    public static Instant FromUnixMicroseconds(
        _ longint microseconds
    );

    public static Instant FromUnixNanoseconds(
        _ longint nanoseconds
    );

    public longint UnixNanoseconds();

    public int CompareTo(_ Instant other);
}

-- ============================================================================
-- Example 16: 5. Instant
-- Demonstrates: Epoch:

Instant epoch =
    Instant.Epoch();

-- ============================================================================
-- Example 17: 5. Instant
-- Demonstrates: Equivalent:

Instant epoch =
    Instant.FromUnixNanoseconds(0);

-- ============================================================================
-- Example 18: 5. Instant
-- Demonstrates: Arithmetic:

public static Instant Operator<+>(
    _ Instant instant,
    _ Duration duration
);

public static Instant Operator<->(
    _ Instant instant,
    _ Duration duration
);

public static Duration Operator<->(
    _ Instant left,
    _ Instant right
);

public static Instant Operator<+>(
    _ Duration duration,
    _ Instant instant
);

-- ============================================================================
-- Example 19: 6. TimeZone
-- Demonstrates: TimeZone represents an IANA-style timezone with transition rules.

public class TimeZone {
    public String Id { get; }

    public static TimeZone Utc();

    public static TimeZone Of(
        _ String id
    );

    public UtcOffset OffsetAt(
        _ Instant instant
    );

    public bool IsDaylightSavingAt(
        _ Instant instant
    );

    public op bool Equals(
        _ TimeZone other
    );
}

-- ============================================================================
-- Example 20: 6. TimeZone
-- Demonstrates: Examples:

TimeZone istanbul =
    TimeZone.Of(
        "Europe/Istanbul"
    );

TimeZone newYork =
    TimeZone.Of(
        "America/New_York"
    );

TimeZone utc =
    TimeZone.Utc();

-- ============================================================================
-- Example 21: 6. TimeZone
-- Demonstrates: Invalid zone:

TimeZone.Of(
    "Mars/Olympus"
); -- TimeException(.INVALID_TIME_ZONE)

-- ============================================================================
-- Example 22: 6. TimeZone
-- Demonstrates: Offset depends on the Instant:

UtcOffset winter =
    newYork.OffsetAt(
        winterInstant
    );

UtcOffset summer =
    newYork.OffsetAt(
        summerInstant
    );

-- ============================================================================
-- Example 23: 6. TimeZone
-- Demonstrates: The following properties do not exist:

timeZone.Offset; -- not defined
timeZone.IsDst;  -- not defined

-- ============================================================================
-- Example 24: 6. TimeZone
-- Demonstrates: Use:

timeZone.OffsetAt(instant);
timeZone.IsDaylightSavingAt(instant);

-- ============================================================================
-- Example 25: 7. Clock
-- Demonstrates: Clock is the source of wall-clock Instant values.

public class Clock {
    public static Clock System();

    public static Clock Fixed(
        _ Instant instant
    );

    public static Clock Offset(
        Clock base,
        Duration offset
    );

    public Instant Now();

    public ZonedTime NowAt(
        _ TimeZone timeZone
    );

    public ZonedTime NowAt(
        TimeZone timeZone,
        String location
    );
}

-- ============================================================================
-- Example 26: 7. Clock
-- Demonstrates: System clock:

Clock clock =
    Clock.System();

Instant now =
    clock.Now();

-- ============================================================================
-- Example 27: 7. Clock
-- Demonstrates: Fixed clock:

Instant instant =
    Instant.FromUnixSeconds(1'000);

Clock clock =
    Clock.Fixed(instant);

clock.Now() == instant; -- true
clock.Now() == instant; -- true

-- ============================================================================
-- Example 28: 8. ZonedTime
-- Demonstrates: ZonedTime is a consistent snapshot of an Instant interpreted through a timezone,
--   optionally carrying a human-facing location label.

public data class ZonedTime(
    Instant Instant,
    LocalTime LocalTime,
    UtcOffset Offset,
    TimeZone TimeZone,
    String Location
) {
    public static ZonedTime Of(
        Instant instant,
        TimeZone timeZone
    );

    public static ZonedTime Of(
        Instant instant,
        TimeZone timeZone,
        String location
    );

    public String Format(
        _ TimeFormat format
    );

    public String Format(
        _ String pattern
    );

    public String ToString();
}

-- ============================================================================
-- Example 29: 8. ZonedTime
-- Demonstrates: Current time at a location:

ZonedTime istanbul =
    Clock.System().NowAt(
        TimeZone.Of(
            "Europe/Istanbul"
        ),
        "İstanbul"
    );

-- ============================================================================
-- Example 30: 8. ZonedTime
-- Demonstrates: Convert any Instant:

ZonedTime value =
    ZonedTime.Of(
        instant,
        TimeZone.Of(
            "Europe/Istanbul"
        ),
        "İstanbul"
    );

-- ============================================================================
-- Example 31: 8. ZonedTime
-- Demonstrates: Same Instant, different timezone:

ZonedTime istanbul =
    ZonedTime.Of(
        instant,
        TimeZone.Of(
            "Europe/Istanbul"
        )
    );

ZonedTime newYork =
    ZonedTime.Of(
        instant,
        TimeZone.Of(
            "America/New_York"
        )
    );

istanbul.Instant
    ==
newYork.Instant; -- true

-- ============================================================================
-- Example 32: 9. TimeFormat
-- Demonstrates: If no location is supplied, Location is null. The library does not derive localized
--   location text from the IANA ID.

public enum class TimeFormat() {
    case Hour24,
    case Hour24Seconds,
    case Hour24Milliseconds,

    case Hour12,
    case Hour12Seconds,

    case Iso,
    case IsoOffset,

    case Long,
    case Location,
    case Full,
}

-- ============================================================================
-- Example 33: 9. TimeFormat
-- Demonstrates: Usage:

String shortTime =
    istanbul.Format(
        TimeFormat.Hour24
    );

String full =
    istanbul.Format(
        TimeFormat.Full
    );

-- ============================================================================
-- Example 34: 10. Pattern formatting
-- Demonstrates: Usage:

String text =
    istanbul.Format(
        "HH:mm:ss"
    );

-- ============================================================================
-- Example 35: 10. Pattern formatting
-- Demonstrates: Examples:

istanbul.Format("HH:mm");
-- 13:42

istanbul.Format("hh:mm a");
-- 01:42 PM

istanbul.Format("HH:mm:ss Z");
-- 13:42:18 +03:00

istanbul.Format("HH:mm L");
-- 13:42 İstanbul

istanbul.Format("HH:mm:ss Z [z]");
-- 13:42:18 +03:00 [Europe/Istanbul]

-- ============================================================================
-- Example 36: 11. TimeError
-- Demonstrates: Invalid pattern syntax produces TimeException(.INVALIDPATTERN).

public enum TimeError {
    INVALID_TIME,
    INVALID_OFFSET,
    INVALID_TIME_ZONE,
    INVALID_FORMAT,
    INVALID_PATTERN,
}

-- ============================================================================
-- Example 37: 12. TimeException
-- Demonstrates: Invalid pattern syntax produces TimeException(.INVALIDPATTERN).

public class TimeException : RuntimeException {
    public TimeError Error { get; }
}

-- ============================================================================
-- Example 38: 12. TimeException
-- Demonstrates: Examples:

LocalTime.Parse("25:10");
-- TimeException(.INVALID_TIME)

UtcOffset.Parse("+30:00");
-- TimeException(.INVALID_OFFSET)

TimeZone.Of("Mars/Olympus");
-- TimeException(.INVALID_TIME_ZONE)

zonedTime.Format("HH:mm:???");
-- TimeException(.INVALID_PATTERN)

-- ============================================================================
-- Example 39: 13. Stopwatch
-- Demonstrates: Stopwatch measures monotonic elapsed time. It does not represent civil time or an

public class Stopwatch {
    public Stopwatch();

    public void Start();
    public void Stop();

    public void Reset();
    public void Restart();

    public bool IsRunning();

    public Duration Elapsed();
}

-- ============================================================================
-- Example 40: 13. Stopwatch
-- Demonstrates: Basic use:

Stopwatch watch =
    new Stopwatch();

watch.Start();

DoWork();

watch.Stop();

Duration elapsed =
    watch.Elapsed();

-- ============================================================================
-- Example 41: 13. Stopwatch
-- Demonstrates: These APIs do not exist:

watch.Now();      -- not defined
watch.Instant();  -- not defined
watch.TimeZone;   -- not defined

-- ============================================================================
-- Example 42: 15. Current time in a location
-- Demonstrates: TimeZone → rules that determine offsets across time

Clock clock =
    Clock.System();

ZonedTime istanbul =
    clock.NowAt(
        TimeZone.Of(
            "Europe/Istanbul"
        ),
        "İstanbul"
    );

-- ============================================================================
-- Example 43: 15. Current time in a location
-- Demonstrates: Read fields:

Instant instant =
    istanbul.Instant;

LocalTime local =
    istanbul.LocalTime;

UtcOffset offset =
    istanbul.Offset;

TimeZone zone =
    istanbul.TimeZone;

String location =
    istanbul.Location;

-- ============================================================================
-- Example 44: 16. Formatting
-- Demonstrates: Read fields:

String shortTime =
    istanbul.Format(
        TimeFormat.Hour24
    );

String full =
    istanbul.Format(
        TimeFormat.Full
    );

String custom =
    istanbul.Format(
        "HH:mm L"
    );

-- ============================================================================
-- Example 45: 17. Same instant in two locations
-- Demonstrates: Read fields:

Instant instant =
    Clock.System().Now();

ZonedTime istanbul =
    ZonedTime.Of(
        instant,
        TimeZone.Of(
            "Europe/Istanbul"
        ),
        "İstanbul"
    );

ZonedTime newYork =
    ZonedTime.Of(
        instant,
        TimeZone.Of(
            "America/New_York"
        ),
        "New York"
    );

-- ============================================================================
-- Example 46: 17. Same instant in two locations
-- Demonstrates: Read fields:

istanbul.Instant
    ==
newYork.Instant; -- true

-- ============================================================================
-- Example 47: 18. Fixed clock testing
-- Demonstrates: Their local display values may differ.

Instant fixedInstant =
    Instant.FromUnixSeconds(
        10'000
    );

Clock clock =
    Clock.Fixed(
        fixedInstant
    );

ZonedTime value =
    clock.NowAt(
        TimeZone.Utc(),
        "UTC"
    );

-- ============================================================================
-- Example 48: 19. LocalTime overflow
-- Demonstrates: Repeated Now() calls remain deterministic.

LocalTime start =
    new LocalTime(
        23,
        30
    );

LocalTimeShift result =
    start + duration;

-- ============================================================================
-- Example 49: 20. Stopwatch timing
-- Demonstrates: result.Time is always a valid time of day. Any crossed day count is preserved in
--   result.DayOffset.

Stopwatch watch =
    new Stopwatch();

watch.Start();

RunOperation();

watch.Stop();

Duration elapsed =
    watch.Elapsed();
