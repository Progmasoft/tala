-- Tala language design examples: Collections
--
-- This file is a topic-oriented language design example suite.
-- Each fragment states its intent explicitly; fragments marked INVALID are expected to be rejected.
-- Examples record intended behavior; they do not claim complete compiler support.

-- ============================================================================
-- Example 1: 2. Built-in fixed-size array: []T
-- Demonstrates: []T is a built-in language type. It does not desugar to System.Array<T>.

[]int values = [1, 2];

values[0] = 10;
values[1] = 20;

-- ============================================================================
-- Example 2: 2. Built-in fixed-size array: []T
-- Demonstrates: Only existing elements may be accessed/replaced:
-- Expected result: accepted when the referenced declarations are available.

values[0] = 100; -- VALID

-- ============================================================================
-- Example 3: 3. System.Array<T> and [T]
-- Demonstrates: Example:

[int] values =
        new Array(
            1,
            2,
            3,
        );

-- ============================================================================
-- Example 4: 4. System.Array<T, N> and [T; N]
-- Demonstrates: Example:

[int; 3] values =
        new Array(
            1,
            2,
            3,
        );

-- ============================================================================
-- Example 5: 4. System.Array<T, N> and [T; N]
-- Demonstrates: The elements remain mutable:
-- Expected result: accepted when the referenced declarations are available.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[int; 3] values = ...;

values[0] = 100; -- VALID

-- ============================================================================
-- Example 6: 5. Array family distinction
-- Demonstrates: A literal may initialize any of these according to target type:

[]int builtIn = [1, 2];
[int] dynamic = [1, 2];
[int; 2] fixed = [1, 2];

-- ============================================================================
-- Example 7: 7. Append()
-- Demonstrates: They are not available on [T; N].

[int] values = [1, 2];

values.Append(3);

-- ============================================================================
-- Example 8: 8. Append(contentsOf:)
-- Demonstrates: Available only on [T].

[int] values = [1, 2];

values.Append(
    contentsOf: [3, 4]
);

-- ============================================================================
-- Example 9: 9. Insert( at:)
-- Demonstrates: Available only on [T].

[String] values = [
    "B",
    "C",
];

values.Insert(
    "A",
    at: 0
);

-- ============================================================================
-- Example 10: 10. Insert(contentsOf:at:)
-- Demonstrates: Available only on [T].

[int] values = [1, 4];

values.Insert(
    contentsOf: [2, 3],
    at: 1
);

-- ============================================================================
-- Example 11: 11. ReplaceSubrange(:with:)
-- Demonstrates: Available only on [T].

values.ReplaceSubrange(
    2..5,
    with: other
);

-- ============================================================================
-- Example 12: 12. Removal
-- Demonstrates: Remove(at:) removes and returns the indexed element:

int removed =
        values.Remove(
            at: 4
        );

-- ============================================================================
-- Example 13: 12. Removal
-- Demonstrates: RemoveFirst() removes the first element. RemoveLast() removes the last element.

values.RemoveFirst();
values.RemoveLast();

-- ============================================================================
-- Example 14: 12. Removal
-- Demonstrates: Counted removal:

values.RemoveFirst(2);
values.RemoveLast(2);

-- ============================================================================
-- Example 15: 12. Removal
-- Demonstrates: PopLast() removes and returns the last element:

int value =
        values.PopLast();

-- ============================================================================
-- Example 16: 13. RemoveAll()
-- Demonstrates: PopLast() removes and returns

values.RemoveAll();

-- ============================================================================
-- Example 17: 13. RemoveAll()
-- Demonstrates: Explicit capacity retention:

values.RemoveAll(
    keepCapacity: true
);

-- ============================================================================
-- Example 18: 13. RemoveAll()
-- Demonstrates: Predicate removal:

values.RemoveAll {
    $0.IsMultiple(of: 2)
};

-- ============================================================================
-- Example 19: 14. Capacity
-- Demonstrates: Dynamic arrays expose:

int capacity =
        values.Capacity();

-- ============================================================================
-- Example 20: 14. Capacity
-- Demonstrates: Reserve capacity:

values.ReserveCapacity(
    10'000
);

-- ============================================================================
-- Example 21: 15. Dynamic Array construction
-- Demonstrates: Repeated value:

[int] values =
        new Array(
            repeating: 0,
            count: 4
        );

-- ============================================================================
-- Example 22: 15. Dynamic Array construction
-- Demonstrates: Builder with capacity:

[int] values =
        new Array(capacity: 5) { output in
            output.Append(10);
            output.Append(20);
        };

-- ============================================================================
-- Example 23: 15. Dynamic Array construction
-- Demonstrates: Batch append with capacity hint:

values.Append(
    addingCapacity: 3
) { output in
    output.Append(3);
    output.Append(4);
};

-- ============================================================================
-- Example 24: 17. Indexing
-- Demonstrates: Both array classes support indexed access and replacement:

int x = values[0];

values[0] = 100;

-- ============================================================================
-- Example 25: 17. Indexing
-- Demonstrates: Example:

for (index() : values.Indices()) {
    Console.Println(index());
}

-- ============================================================================
-- Example 26: 18. Iteration and count
-- Demonstrates: Iterator:

auto iterator =
        values.Iterator();

-- ============================================================================
-- Example 27: 18. Iteration and count
-- Demonstrates: Count:

int count =
        values.Count();

-- ============================================================================
-- Example 28: 18. Iteration and count
-- Demonstrates: Empty check:

bool empty =
        values.IsEmpty();

-- ============================================================================
-- Example 29: 19. First(), Last(), UnderestimatedCount()
-- Demonstrates: Count() == 0

T first =
        values.First();

T last =
        values.Last();

-- ============================================================================
-- Example 30: 19. First(), Last(), UnderestimatedCount()
-- Demonstrates: For concrete arrays:

int minimum =
        values.UnderestimatedCount();

-- ============================================================================
-- Example 31: 20. Map { ... }
-- Demonstrates: Example:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[int; 4] values = ...;

[String; 4] mapped =
        values.Map {
            ...
        };

-- ============================================================================
-- Example 32: 21. Filter { ... }
-- Demonstrates: Example:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[int; 5] values = ...;

[int] large =
        values.Filter {
            $0 > 20
        };

-- ============================================================================
-- Example 33: 22. Reordering operations
-- Demonstrates: Swap:

values.Swap(
    0,
    to: 3
);

-- ============================================================================
-- Example 34: 22. Reordering operations
-- Demonstrates: In-place reverse:

values.Reverse();

-- ============================================================================
-- Example 35: 22. Reordering operations
-- Demonstrates: Non-mutating reverse:

auto result =
        values.Reversed();

-- ============================================================================
-- Example 36: 22. Reordering operations
-- Demonstrates: Partition:

values.Partition {
    $0.IsMultiple(of: 2)
};

-- ============================================================================
-- Example 37: 23. ForEach
-- Demonstrates: Swap, Reverse, Reversed, and Partition do not change cardinality and are available on
--   [T] and [T; N].

values.ForEach();

-- ============================================================================
-- Example 38: 23. ForEach
-- Demonstrates: Closure form:

values.ForEach {
    Console.Println($0);
};

-- ============================================================================
-- Example 39: 24. Search/query methods
-- Demonstrates: Membership:

values.Contains(42);

-- ============================================================================
-- Example 40: 24. Search/query methods
-- Demonstrates: Predicate membership:

values.Contains(where: {
    $0 > 100
});

-- ============================================================================
-- Example 41: 24. Search/query methods
-- Demonstrates: Count matching elements:

values.Count(where: {
    $0 > 100
});

-- ============================================================================
-- Example 42: 24. Search/query methods
-- Demonstrates: First/last match:

values.First(where: {
    $0 > 100
});

values.Last(where: {
    $0 > 100
});

-- ============================================================================
-- Example 43: 24. Search/query methods
-- Demonstrates: First/last value index:

values.FirstIndex(
    of: target
);

values.LastIndex(
    of: target
);

-- ============================================================================
-- Example 44: 25. Enumerated()
-- Demonstrates: All are available on [T] and [T; N].

for ((index(), value()) : values.Enumerated()) {
    Console.Println(
        index(),
        value()
    );
}

-- ============================================================================
-- Example 45: 27. Dictionary
-- Demonstrates: Therefore:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[String to int] scores = ...;

-- ============================================================================
-- Example 46: 27. Dictionary
-- Demonstrates: means:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

Dictionary<String, int> scores = ...;

-- ============================================================================
-- Example 47: 28. Dictionary literals
-- Demonstrates: means:

[String to int] scores = [
    "user" to 26,
];

-- ============================================================================
-- Example 48: 28. Dictionary literals
-- Demonstrates: Desugars to:

Dictionary<String, int> scores =
        new Dictionary(
            "user" to 26,
        );

-- ============================================================================
-- Example 49: 28. Dictionary literals
-- Demonstrates: Multiple entries:

[String to int] scores = [
    "Alice" to 95,
    "Bob" to 80,
    "Chris" to 70,
];

-- ============================================================================
-- Example 50: 28. Dictionary literals
-- Demonstrates: Desugars to:

Dictionary<String, int> scores =
        new Dictionary(
            "Alice" to 95,
            "Bob" to 80,
            "Chris" to 70,
        );

-- ============================================================================
-- Example 51: 28. Dictionary literals
-- Demonstrates: Empty dictionary:

[String to int] scores = [];

-- ============================================================================
-- Example 52: 30. Dictionary subscript
-- Demonstrates: Read:

int score =
        scores["Alice"];

-- ============================================================================
-- Example 53: 30. Dictionary subscript
-- Demonstrates: Write:

scores["Alice"] = 95;

-- ============================================================================
-- Example 54: 31. Default Dictionary subscript
-- Demonstrates: Read with default:

int score =
        scores[
            "Chris",
            default: 0
        ];

-- ============================================================================
-- Example 55: 31. Default Dictionary subscript
-- Demonstrates: Mutation:

scores[
    "Chris",
    default: 0
] += 10;

-- ============================================================================
-- Example 56: 32. UpdateValue(:forKey:)
-- Demonstrates: use default 0 → apply mutation → store 10

auto previous =
        scores.UpdateValue(
            95,
            forKey: "Alice"
        );

-- ============================================================================
-- Example 57: 33. RemoveValue(forKey:)
-- Demonstrates: Optional<T> is not part of this API.

auto removed =
        scores.RemoveValue(
            forKey: "Bob"
        );

-- ============================================================================
-- Example 58: 34. Dictionary utility methods
-- Demonstrates: Remove all:

scores.RemoveAll();

-- ============================================================================
-- Example 59: 34. Dictionary utility methods
-- Demonstrates: Keys:

auto keys =
        scores.Keys();

-- ============================================================================
-- Example 60: 34. Dictionary utility methods
-- Demonstrates: Values:

auto values =
        scores.Values();

-- ============================================================================
-- Example 61: 34. Dictionary utility methods
-- Demonstrates: Count:

int count =
        scores.Count();

-- ============================================================================
-- Example 62: 34. Dictionary utility methods
-- Demonstrates: Empty:

bool empty =
        scores.IsEmpty();

-- ============================================================================
-- Example 63: 35. Dictionary iteration
-- Demonstrates: Key iteration:

for (key() : scores) {
    Console.Println(
        key()
    );
}

-- ============================================================================
-- Example 64: 35. Dictionary iteration
-- Demonstrates: Key/value iteration:

for ((key(), value()) : scores) {
    Console.Println(
        key(),
        value()
    );
}

-- ============================================================================
-- Example 65: 35. Dictionary iteration
-- Demonstrates: Ignore value:

for ((key(), _) : scores) {
    Console.Println(
        key()
    );
}

-- ============================================================================
-- Example 66: 35. Dictionary iteration
-- Demonstrates: Ignore key:

for ((_, value()) : scores) {
    Console.Println(
        value()
    );
}

-- ============================================================================
-- Example 67: 36. Set
-- Demonstrates: Construction:

Set<int> set =
        new Set();

-- ============================================================================
-- Example 68: 36. Set
-- Demonstrates: or:

Set<int> set =
        new Set(
            1,
            2,
            3
        );

-- ============================================================================
-- Example 69: 38. Set element operations
-- Demonstrates: Insert:

set.Insert(10);
set.Insert(20);

-- ============================================================================
-- Example 70: 38. Set element operations
-- Demonstrates: Membership:

bool exists =
        set.Contains(10);

-- ============================================================================
-- Example 71: 38. Set element operations
-- Demonstrates: Remove:

set.Remove(10);

-- ============================================================================
-- Example 72: 38. Set element operations
-- Demonstrates: Count/empty:

int count =
        set.Count();

bool empty =
        set.IsEmpty();

-- ============================================================================
-- Example 73: 39. Set algebra
-- Demonstrates: Count/empty:

Set<int> a =
        new Set(1, 2, 3);

Set<int> b =
        new Set(3, 4, 5);

-- ============================================================================
-- Example 74: 39. Set algebra
-- Demonstrates: Union:

a.Union(b);

-- ============================================================================
-- Example 75: 39. Set algebra
-- Demonstrates: Intersection:

a.Intersection(b);

-- ============================================================================
-- Example 76: 39. Set algebra
-- Demonstrates: Difference:

a.Subtracting(b);

-- ============================================================================
-- Example 77: 39. Set algebra
-- Demonstrates: Symmetric difference:

a.SymmetricDifference(b);

-- ============================================================================
-- Example 78: 40. Set relationship checks
-- Demonstrates: Subset:

a.IsSubset(
    of: b
);

-- ============================================================================
-- Example 79: 40. Set relationship checks
-- Demonstrates: Superset:

a.IsSuperset(
    of: b
);

-- ============================================================================
-- Example 80: 40. Set relationship checks
-- Demonstrates: Disjoint:

a.IsDisjoint(
    with: b
);

-- ============================================================================
-- Example 81: 41. Method reference operator
-- Demonstrates: Example:

auto append =
        values::Append;

-- ============================================================================
-- Example 82: 41. Method reference operator
-- Demonstrates: Later:

append(42);

-- ============================================================================
-- Example 83: 41. Method reference operator
-- Demonstrates: Example:

values.Append(10);

auto f =
        values::Append;

-- ============================================================================
-- Example 84: 44. Reference semantics
-- Demonstrates: Both [T] and [T; N] are reference types.
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[int] a = ...;
[int] b = a;

-- ============================================================================
-- Example 85: 44. Reference semantics
-- Demonstrates: Likewise:
-- Context note: ellipses denote declarations intentionally omitted from this focused fragment.

[int; 4] a = ...;
[int; 4] b = a;
