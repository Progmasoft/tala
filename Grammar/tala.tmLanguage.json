{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tala",
  "scopeName": "source.tala",
  "fileTypes": [
    "talac"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#preprocessor" },
    { "include": "#attributes" },
    { "include": "#numbers" },
    { "include": "#callables" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.tala",
          "begin": "--\\[(=*)\\[\\|",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.tala" }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.tala" }
          }
        },
        {
          "name": "comment.block.documentation.namespace.tala",
          "begin": "--\\[(=*)\\[!",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.tala" }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.tala" }
          }
        },
        {
          "name": "comment.block.tala",
          "begin": "--\\[(=*)\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.tala" }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.tala" }
          }
        },
        {
          "name": "comment.line.documentation.tala",
          "match": "--\\|.*$"
        },
        {
          "name": "comment.line.documentation.namespace.tala",
          "match": "--!.*$"
        },
        {
          "name": "comment.line.double-dash.tala",
          "match": "--.*$"
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.tala",
          "begin": "(?<!--)\\[(=*)\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tala" }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tala" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tala",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tala" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tala" }
          },
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.character.tala",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tala" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tala" }
          },
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.tala",
          "match": "\\\\(?:[0abefnrtv'\"\\\\]|x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|\\r?\\n)"
        },
        {
          "name": "invalid.illegal.escape.tala",
          "match": "\\\\."
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.tala",
          "begin": "^\\s*(#)(define|setdef|undef|if|elseif|else|endif|error|warn|info|message|region|endregion)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.directive.tala" },
            "2": { "name": "keyword.control.directive.tala" }
          },
          "end": "$",
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "support.function.preprocessor.tala",
              "match": "\\b(?:os|family)(?=\\s*\\()"
            },
            {
              "name": "keyword.operator.logical.tala",
              "match": "&&|\\|\\||\\bnot\\b"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.file.tala",
          "begin": "(#)(\\[)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.annotation.tala" },
            "2": { "name": "punctuation.section.brackets.begin.tala" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.section.brackets.end.tala" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "entity.name.type.attribute.tala",
              "match": "\\b[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*\\b"
            }
          ]
        },
        {
          "name": "meta.attribute.tala",
          "begin": "\\[(?=[A-Za-z_])",
          "beginCaptures": {
            "0": { "name": "punctuation.section.brackets.begin.tala" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.section.brackets.end.tala" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "storage.modifier.attribute-target.tala",
              "match": "\\b(?:file|return|parameter)\\b(?=\\s*:)"
            },
            {
              "name": "entity.name.type.attribute.tala",
              "match": "\\b[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*\\b"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tala",
          "match": "(?<![A-Za-z0-9_])(?:[0-9](?:[0-9']*[0-9])?\\.[0-9](?:[0-9']*[0-9])?|[0-9](?:[0-9']*[0-9])?[eE][+-]?[0-9]+)(?:[eE][+-]?[0-9]+)?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.tala",
          "match": "(?<![A-Za-z0-9_])0[xX][0-9A-Fa-f](?:[0-9A-Fa-f']*[0-9A-Fa-f])?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.binary.tala",
          "match": "(?<![A-Za-z0-9_])0[bB][01](?:[01']*[01])?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.octal.tala",
          "match": "(?<![A-Za-z0-9_])0[oO][0-7](?:[0-7']*[0-7])?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.decimal.tala",
          "match": "(?<![A-Za-z0-9_])[0-9](?:[0-9']*[0-9])?(?![A-Za-z0-9_])"
        }
      ]
    },
    "callables": {
      "patterns": [
        {
          "name": "storage.modifier.capture.tala",
          "match": "\\b(?:weak|unowned)\\b(?=[^\\]]*\\]\\s*\\\\)"
        },
        {
          "name": "punctuation.definition.lambda.tala",
          "match": "\\\\(?=\\s*(?:\\(|[A-Za-z_]|->))"
        },
        {
          "name": "storage.type.function.arrow.tala",
          "match": "->"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.namespace.tala" },
            "2": { "name": "entity.name.namespace.tala" }
          }
        },
        {
          "match": "\\b(data\\s+class|enum\\s+class|class|data|type|object|interface|extension|concept|typealias|attribute)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.tala" },
            "2": { "name": "entity.name.type.tala" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.tala" }
          }
        },
        {
          "match": "\\b(Operator)(<)([^>]+)(>)",
          "captures": {
            "1": { "name": "entity.name.function.operator.tala" },
            "2": { "name": "punctuation.definition.generic.begin.tala" },
            "3": { "name": "keyword.operator.custom.tala" },
            "4": { "name": "punctuation.definition.generic.end.tala" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tala",
          "match": "\\b(?:if|else|guard|match|while|do|for|in|by|try|catch|defer|return|throw|yield|break|continue|await|new|Copy|Move)\\b"
        },
        {
          "name": "keyword.declaration.tala",
          "match": "\\b(?:namespace|using|selected|alias|data|class|case|enum|type|object|interface|extension|concept|typealias|attribute|template|typename|requires|targets|permits|throws)\\b"
        },
        {
          "name": "storage.modifier.tala",
          "match": "\\b(?:public|internal|fileprivate|protected|private|static|final|sealed|abstract|inline|extern|virtual|override|op|async|explicit|repeatable|noexcept|convertible|weak|unowned|precedence|associativity|prefix|postfix|left|right)\\b"
        },
        {
          "name": "variable.language.tala",
          "match": "\\b(?:self|Self|super)\\b"
        },
        {
          "name": "keyword.operator.word.tala",
          "match": "\\b(?:and|or|not|is|copy|move)\\b"
        },
        {
          "name": "keyword.other.accessor.tala",
          "match": "\\b(?:get|set)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.tala",
          "match": "\\b(?:void|never|bool|char|byte|short|long|int|longint|ubyte|ushort|ulong|uint|ulongint|sfloat|lfloat|float|double|String|auto)\\b"
        },
        {
          "name": "support.type.tala",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tala",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tala",
          "match": "(?<![!<>=\\\\])(?:<<|>>|\\?\\?|[+\\-*/%&|^])?=(?!=)"
        },
        {
          "name": "keyword.operator.range.tala",
          "match": "\\.\\.<|\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.tala",
          "match": "\\*\\*|//|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.tala",
          "match": "==|!=|\\\\=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tala",
          "match": "&&|\\|\\||\\?\\?"
        },
        {
          "name": "keyword.operator.conditional.tala",
          "match": "\\?:|\\?|:"
        },
        {
          "name": "keyword.operator.bitwise.tala",
          "match": "<<|>>|[&|^!]"
        },
        {
          "name": "keyword.operator.increment.tala",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.method-reference.tala",
          "match": "::"
        }
      ]
    }
  }
}
