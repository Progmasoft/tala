namespace Examples.MatrixTranspose;

public class MatrixTranspose {
    public static void Main() {
        int rows = 2;
        int columns = 3;
        [int] matrix = [1, 2, 3, 4, 5, 6];

        -- Store row-major data in one array so the example stays representation-neutral.
        for (int outputRow = 0; outputRow < columns; outputRow++) {
            for (int outputColumn = 0; outputColumn < rows; outputColumn++) {
                int sourceIndex = outputColumn * columns + outputRow;
                Console.Printfn("%d ", matrix[sourceIndex]);
            }
            Console.Println("");
        }
    }
}
