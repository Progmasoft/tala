namespace Examples.LoopControl;

public class LoopControl {
    public static void Main() {
        int total = 0;
        int value = 0;

        -- Continue skips one value; break ends this loop before adding eight.
        while (value < 9) {
            value++;
            if (value == 2) {
                continue;
            }
            if (value == 8) {
                break;
            }
            total = total + value;
        }

        int countdown = 3;
        do {
            total = total + countdown;
            countdown--;
        } while (countdown > 0);

        for (int index = 0; index < 4; index++) {
            total = total + index;
        }

        Console.Printfn("loop total: %d", total);
    }
}
