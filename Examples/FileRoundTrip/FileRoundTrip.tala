namespace Examples.FileRoundTrip;

using System.IO.File;
using System.IO;

public class FileRoundTrip {
    public static void Main()
        throws IOException {
        Path path = Path.Of(value: "tala-example.txt");
        String expected = "Lexer -> Parser -> Core -> Xpp -> Xmm";

        Files.WriteString(path, expected);
        String actual = Files.ReadString(path);

        Console.Println(actual);
        Console.Printfn("Round trip preserved content: %b", actual == expected);
    }
}
