namespace Examples.WordFrequency;

public class WordFrequency {
    public static void Main() {
        [String] words = [
            "visual",
            "tala",
            "visual",
            "compiler",
            "tala",
            "visual",
        ];
        [String to int] counts = [
            "visual" to 0,
            "tala" to 0,
            "compiler" to 0,
        ];

        for (String word : words) {
            counts[word] = counts[word] + 1;
        }

        for (String word : ["visual", "tala", "compiler"]) {
            Console.Printfn("%s: %d", word, counts[word]);
        }
    }
}
