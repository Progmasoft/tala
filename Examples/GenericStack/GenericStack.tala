namespace Examples.GenericStack;

template<typename T>
public class Stack {
    private [T] items = [];

    public void Push(T value) {
        self.items.Append(value);
    }

    public T Peek() {
        self.items.Last()
    }

    public T Pop() {
        self.items.PopLast()
    }

    public int Count() {
        self.items.Count()
    }
}

public class GenericStack {
    public static void Main() {
        Stack<String> names = new Stack();
        names.Push(value: "Lexer");
        names.Push(value: "Parser");
        names.Push(value: "Core");

        Console.Println(names.Peek());
        while (names.Count() > 0) {
            Console.Println(names.Pop());
        }
    }
}
