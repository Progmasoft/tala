namespace Examples.FizzBuzz;

public class FizzBuzz {
    public static void Main() {
        for (int number : 1 ... 30) {
            if (number % 15 == 0) {
                Console.Println("FizzBuzz");
            }
            else if (number % 3 == 0) {
                Console.Println("Fizz");
            }
            else if (number % 5 == 0) {
                Console.Println("Buzz");
            }
            else {
                Console.Println(number);
            }
        }
    }
}
