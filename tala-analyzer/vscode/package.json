{
  "name": "tala-analyzer",
  "displayName": "Tala Analyzer",
  "description": "Compiler-backed diagnostics for Tala through tala-analyzer LSP.",
  "version": "0.1.0",
  "private": true,
  "publisher": "progmasoft",
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:tala"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tala",
        "aliases": ["Tala", "Tala"],
        "extensions": [".tala"]
      }
    ],
    "configuration": {
      "title": "Tala Analyzer",
      "properties": {
        "tala.analyzer.path": {
          "type": "string",
          "default": "tala-analyzer",
          "description": "Path or command name of the tala-analyzer LSP executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc --noEmit -p .",
    "test": "npm run check"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/vscode": "1.100.0",
    "typescript": "7.0.2"
  }
}
