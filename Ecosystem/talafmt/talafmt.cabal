cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: talafmt
version: 0.2.0
synopsis: Syntax-aware source formatter for Tala
description:
    Provides safe source layout normalization and the talafmt command-line tool
    on top of the canonical Tala compiler frontend.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Progmasoft.Talafmt
        Progmasoft.Talafmt.CommandLine
        Progmasoft.Talafmt.Encoding
        Progmasoft.Talafmt.Report
    other-modules:
        Progmasoft.Talafmt.Layout
        Progmasoft.Talafmt.Options
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.3,
        tala-compiler >=0.6.0 && <0.7
    default-language: GHC2024

executable talafmt
    main-is: Progmasoft/Talafmt/Main.hs
    other-modules:
        Paths_talafmt
        Progmasoft.Talafmt
        Progmasoft.Talafmt.CommandLine
        Progmasoft.Talafmt.Encoding
        Progmasoft.Talafmt.Layout
        Progmasoft.Talafmt.Options
        Progmasoft.Talafmt.Report
    autogen-modules:
        Paths_talafmt
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        process >=1.6 && <1.7,
        text >=2.1 && <2.3,
        talafmt,
        tala-compiler
    default-language: GHC2024

test-suite talafmt-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    other-modules:
        CommandLineTests
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.13,
        talafmt,
        tala-compiler
    default-language: GHC2024
