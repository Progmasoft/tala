cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: talalint
version: 0.2.0
synopsis: Compiler-backed static analysis for Tala
description:
    Provides compiler diagnostics, source hygiene checks, safe fixes, and the
    talalint command-line tool for Tala source files.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Progmasoft.Talalint
        Progmasoft.Talalint.CommandLine
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        talafmt >=0.2 && <0.3,
        tala-tooling >=0.6.0 && <0.7
    default-language: GHC2024

executable talalint
    main-is: Progmasoft/Talalint/Main.hs
    other-modules:
        Paths_talalint
        Progmasoft.Talalint
        Progmasoft.Talalint.CommandLine
    autogen-modules:
        Paths_talalint
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        text >=2.1 && <2.3,
        talafmt,
        talalint,
        tala-tooling
    default-language: GHC2024

test-suite talalint-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    other-modules:
        CommandLineTests
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        talafmt,
        talalint,
        tala-tooling
    default-language: GHC2024
