cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: talalint
version: 0.1.1
synopsis: Compiler-backed static analysis for Tala
description:
    Provides compiler diagnostics, source hygiene checks, safe fixes, and the
    talalint command-line tool for Tala source files.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Progmasoft.Talalint
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        talafmt >=0.1 && <0.2,
        tala-compiler >=0.5.0 && <0.6
    default-language: GHC2024

executable talalint
    main-is: Talalint/Main.hs
    other-modules:
        Progmasoft.Talalint
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        text >=2.1 && <2.3,
        talafmt,
        talalint,
        tala-compiler
    default-language: GHC2024

test-suite talalint-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        talafmt,
        talalint,
        tala-compiler
    default-language: GHC2024
