<idea-plugin>
    <id>com.progmasoft.tala.analyzer</id>
    <name>Tala Analyzer</name>
    <vendor email="support@progmasoft.com">Progmasoft</vendor>
    <description>Compiler-backed Tala diagnostics through the tala-analyzer LSP server.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider
            implementation="com.progmasoft.tala.analyzer.intellij.TalaLspIntegrationProvider"/>
    </extensions>
</idea-plugin>
