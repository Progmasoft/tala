{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "vscode"],
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "sources",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": false
  },
  "include": ["sources/**/*.ts"]
}
