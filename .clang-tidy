---
# Naming checks are intentionally absent. Tala retains its established
# PascalCase functions/types/namespaces and camelCase local-variable contract.
#
# Two checks are disabled because they contradict a repository convention:
# - portability-avoid-pragma-once: every first-party header uses `#pragma once`,
#   which Clang, GCC and MSVC all implement.
# - readability-redundant-member-init: aggregate members keep an explicit `{}`
#   so brace initialization that omits trailing fields stays clean under
#   -Wmissing-field-initializers, which the build treats as an error.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  concurrency-*,
  performance-*,
  portability-*,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-redundant-void-arg,
  modernize-type-traits,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  misc-throw-by-value-catch-by-reference,
  readability-duplicate-include,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-redundant-access-specifiers,
  readability-redundant-casting,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-function-ptr-dereference,
  readability-redundant-inline-specifier,
  readability-redundant-member-init,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-redundant-typename,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  readability-uniqueptr-delete-release,
  -bugprone-easily-swappable-parameters,
  -portability-avoid-pragma-once,
  -readability-redundant-member-init,
  -bugprone-exception-escape,
  -bugprone-unhandled-code-paths,
  -modernize-use-auto,
  -modernize-use-emplace,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -readability-function-size,
  -readability-magic-numbers,
  -readability-qualified-auto

WarningsAsErrors: '*'
HeaderFileExtensions:
  - h
  - hh
  - hpp
ImplementationFileExtensions:
  - c
  - cpp
# Bazel exposes the public headers under bazel-out/<config>/bin/_virtual_includes,
# so that tree must be analyzed too. Fetched repositories live under an
# external/ directory in both the source and the output tree and stay excluded.
HeaderFilterRegex: '(^|.*/)(Talac|Interactive|Benchmarks|Ecosystem|_virtual_includes)/.*'
ExcludeHeaderFilterRegex: '(^|.*/)(build|vendor|third_party|external|subprojects)/.*'
SystemHeaders: false
FormatStyle: file
InheritParentConfig: false
UseColor: true

CheckOptions:
  readability-implicit-bool-conversion.AllowPointerConditions: false
  readability-implicit-bool-conversion.AllowIntegerConditions: false
  modernize-use-using.IgnoreExternC: true
  modernize-use-using.IgnoreMacros: true
  modernize-loop-convert.MinConfidence: reasonable
...
