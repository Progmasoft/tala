load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "tala_runtime",
    srcs = ["Hosted.cpp"],
    # The library is linked into executables that carry no C++ runtime: no
    # type information, which lives there, and no guard for a static local,
    # which is a call into it. It is linked into position-independent
    # executables, which is what the systems' linkers make by default.
    copts = [
        "-fno-rtti",
        "-fno-threadsafe-statics",
        "-fPIC",
    ],
    linkstatic = True,
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    textual_hdrs = [
        "//Talac/Runtime/AARC:sources",
        "//Talac/Runtime/Text:sources",
    ],
    deps = [
        "//Talac/Headers/Progmasoft/Tala/Runtime:aarc_api",
        "//Talac/Headers/Progmasoft/Tala/Runtime:text_api",
    ],
)

# The sources the shared library of TalaRT compiles as this archive does.
exports_files(["Hosted.cpp"])

cc_library(
    name = "textual_sources",
    textual_hdrs = [
        "//Talac/Runtime/AARC:sources",
        "//Talac/Runtime/Text:sources",
    ],
    deps = [
        "//Talac/Headers/Progmasoft/Tala/Runtime:aarc_api",
        "//Talac/Headers/Progmasoft/Tala/Runtime:text_api",
    ],
)
