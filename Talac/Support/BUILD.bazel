load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The thread the compiler runs on. Creating it needs the platform's own
# thread interface: the stack must be reserved, not committed.
cc_library(
    name = "compiler_stack",
    srcs = ["CompilerStack.cpp"],
    deps = [
        "//Talac/Headers/Progmasoft/Tala/Support:compiler_stack_api",
        "@llvm//:llvm",
    ],
)
