load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Kotlin project evaluation remains an implementation detail of talac. This
# bridge is a testable library boundary, never a second compiler executable.
cc_library(
    name = "project_driver",
    srcs = ["ProjectDriver.cpp"],
    hdrs = ["ProjectDriver.hpp"],
    deps = [
        "//Talac/Cli/Arguments:arguments",
        "@fmt//:fmt",
    ],
)
