namespace Fuzz; class Program { public static int Evaluate() { int value = 3; int low = 0 - value; int a = match (low) { -3 -> 10, -2 -> 20, - 1 -> 30, 0 -> 40, _ -> 50 }; byte small = 1; int b = match (small) { -128 -> 1, 127 -> 2, _ -> 3 }; int c = match (low), (value) { (-3), (3) -> 1, (_), (_) -> 0 }; return a + b + c; } }
