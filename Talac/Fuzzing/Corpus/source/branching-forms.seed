namespace Fuzz; class Program { public static int Kind(_ int n, _ bool flag) { guard (n >= 0) else { return 0 - 1; } int kind = match (n), (flag) { (0), (_) -> 10, (1), (true) -> 20, (int low), (_) if low < 5 -> low * 2, (_), (_) -> { int rest = n - 5; rest + 30 } }; int total = 0; for (int index = 0; index < n; index++) { match (index % 3) { 0 -> { continue; }, 1 -> { total += 10; }, _ -> { total += index; } } guard (total < 40) else { break; } } return if (kind > total) { kind - total } else { total - kind }; } public static int Evaluate() { return Kind(7, true) + Kind(1, false); } }
