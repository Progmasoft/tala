namespace Fuzz; class Program { public static int Evaluate() { int value = 3; int total = 0; for (int i = 0; i < 8; i += 1) { total += match (i) { 2 -> { continue; }, 6 -> { break; }, int n -> { if (n == value) { continue; } else { n } } }; } int r = if (total > 100) { return 0 - 1; } else { total }; guard (r > 0) else { match (r == 0) { true -> { return 1; }, false -> { return 2; } } } guard (r < 100) else { while (true) { } } return r; } }
