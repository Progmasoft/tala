cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: tala-frontend-host
version: 0.6.0
synopsis: The Haskell frontend as the native Tala compiler loads it
description:
    The shared library tala-frontend that talac loads in its own process, its
    C ABI, and the coverage-guided fuzzer of the frontend. This package
    belongs to the compiler repository and is not published; tools build on
    tala-tooling instead.
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
category: Language
build-type: Simple
extra-source-files:
    ffi/tala-frontend.def

foreign-library tala-frontend
    type: native-shared
    other-modules:
        Progmasoft.Tala.Driver.FFI
    hs-source-dirs: src
    cxx-sources: ffi/FrontendRuntime.cpp
    cxx-options: -std=c++20 -fno-exceptions
    if os(windows)
        options: standalone
        mod-def-file: ffi/tala-frontend.def
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        text >=2.1 && <2.3,
        tala-compiler >=0.6.0 && <0.7
    default-language: GHC2024

executable frontend-fuzz
    main-is: Main.hs
    other-modules: Feedback Mutation
    hs-source-dirs: Fuzzing
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        containers >=0.7 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hpc >=0.7 && <0.8,
        text >=2.1 && <2.3,
        tala-compiler >=0.6.0 && <0.7
    ghc-options: -rtsopts "-with-rtsopts=-M512m -K8m"
    default-language: GHC2024

test-suite fuzz-feedback-tests
    type: exitcode-stdio-1.0
    main-is: Tests.hs
    other-modules: Feedback Mutation
    hs-source-dirs: Fuzzing
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        containers >=0.7 && <0.9,
        hpc >=0.7 && <0.8
    default-language: GHC2024
