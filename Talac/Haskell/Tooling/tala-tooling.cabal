name: tala-tooling
version: 0.6.0
synopsis: The part of the Tala compiler that tools build on
description:
    The modules of the Tala compiler that a formatter, a linter or a
    language server needs: the source text and its positions, the tokens,
    the syntax tree, the diagnostics, the frontend and the compiler entry
    that runs every check. Tools depend on this package alone; the other
    compiler packages are its implementation and may change in any release.
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
category: Language
build-type: Simple

library
    reexported-modules:
        tala-syntax:Progmasoft.Tala.AST,
        tala-syntax:Progmasoft.Tala.Diagnostic,
        tala-syntax:Progmasoft.Tala.Parser,
        tala-syntax:Progmasoft.Tala.SourceText,
        tala-frontend:Progmasoft.Tala.Frontend,
        tala-compiler:Progmasoft.Tala.Compiler
    build-depends:
        tala-compiler >=0.6.0 && <0.7,
        tala-frontend >=0.6.0 && <0.7,
        tala-syntax >=0.6.0 && <0.7
    default-language: GHC2024
