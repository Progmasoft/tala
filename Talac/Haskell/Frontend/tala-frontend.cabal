name: tala-frontend
version: 0.5.2
synopsis: Tala resolution and type-checking frontend
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Progmasoft.Tala.Closure.Analysis
        Progmasoft.Tala.ConstantEvaluation
        Progmasoft.Tala.BuiltinTypes
        Progmasoft.Tala.Frontend
        Progmasoft.Tala.IntegerEvaluation
        Progmasoft.Tala.NumericSemantics
        Progmasoft.Tala.Resolver.NameResolution
        Progmasoft.Tala.Resolver.Renamer
        Progmasoft.Tala.SourceSet
        Progmasoft.Tala.TemplateValue
        Progmasoft.Tala.Template.Application
        Progmasoft.Tala.Template.Discovery
        Progmasoft.Tala.Template.Freshen
        Progmasoft.Tala.Template.Instantiation
        Progmasoft.Tala.Template.Mangling
        Progmasoft.Tala.Template.MemberReachability
        Progmasoft.Tala.Template.Specialization
        Progmasoft.Tala.Template.Specialization.Verifier
        Progmasoft.Tala.Template.Verifier
        Progmasoft.Tala.TypeClassification
        Progmasoft.Tala.TypeChecker
        Progmasoft.Tala.TypeChecker.Branching
        Progmasoft.Tala.TypeChecker.Console
        Progmasoft.Tala.TypeChecker.Context
        Progmasoft.Tala.TypeChecker.Enums
        Progmasoft.Tala.TypeChecker.Format
        Progmasoft.Tala.TypeChecker.Literals
        Progmasoft.Tala.TypeChecker.Loops
        Progmasoft.Tala.TypeChecker.Returns
    hs-source-dirs: src
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        containers >=0.7 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        text >=2.1 && <2.3,
        tala-syntax
    default-language: GHC2024
