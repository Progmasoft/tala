fn wide_ops(left: Int, right: Int) -> Int {
  return (left / right) & (left % right) & (left | right) & (left ^ right) & ((left << right) >> right);
}

fn wide_compare(left: Int, right: Int) -> Bool {
  return left >= right;
}

fn main() -> Long {
  return 7;
}
