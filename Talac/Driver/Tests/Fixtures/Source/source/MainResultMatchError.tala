fn Produce() -> Result<Long, Long>
{
  return Error(9);
}

fn Read(input: Result<Long, Long>) -> Long
{
  return match (input)
  {
    Ok(value) -> { value },
    Error(error) -> { error },
  };
}

fn main() -> Long
{
  return Read(Produce());
}
