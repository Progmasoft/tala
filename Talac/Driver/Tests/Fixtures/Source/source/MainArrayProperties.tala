fn main() -> Long
{
  values: [Long; 3] = [4, 7, 7];
  if (values.count == 3 &&
      values.capacity == 3 &&
      !values.is_empty &&
      values.start_index == 0 &&
      values.end_index == 3)
  {
    return values.first + values.last;
  }
  return 0;
}
