data Point {
    x: Long;
    y: Long;

    Point(x: Long, y: Long) {
        self.x = x;
        self.y = y;
    }

    Point(value: Long) {
        self.x = value;
        self.y = value;
    }
}

fn make_point(value: Long) -> Point {
    return new Point(value);
}

fn total(point: Point) -> Long {
    return point.x + point.y;
}

fn main() -> Long {
    return total(new Point(2, 3)) + make_point(4).x;
}
