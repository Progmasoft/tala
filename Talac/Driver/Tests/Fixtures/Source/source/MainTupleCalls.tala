fn make_pair(left: Long, right: Long) -> (Long, Long)
{
  return (left, right);
}

fn select_right(pair: (Long, Long)) -> Long
{
  return pair.1;
}

fn main() -> Long
{
  return select_right(make_pair(2, 5)) + make_pair(1, 2).1;
}
