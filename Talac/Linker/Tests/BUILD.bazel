load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "link_plan_tests",
    srcs = ["LinkPlanTests.cpp"],
    deps = [
        "//Talac/Linker:link_plan",
        "@catch3//:catch3_main",
        "@catch3//:catch3",
    ],
)

# LLD runs inside this test as it does inside talac. It links a Windows
# executable from an object LLVM generates, so every host links one, and a
# Windows host also runs it.
cc_binary(
    name = "lld_tests",
    srcs = ["LldTests.cpp"],
    deps = [
        "//Talac/Linker:lld",
        "@catch3//:catch3_main",
        "@catch3//:catch3",
        "@llvm//:llvm",
    ],
)
