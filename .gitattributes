* text=auto eol=crlf

# Cross-platform build metadata and Go repository automation are consumed
# directly on Windows and macOS. Keep their repository and checkout bytes LF so
# generated lock digests, YAML parsing, and source-file execution do not depend
# on the developer's core.autocrlf setting.
/.bazelrc text eol=lf
/.bazelversion text eol=lf
/.gitattributes text eol=lf
/MODULE.bazel text eol=lf
/MODULE.bazel.lock text eol=lf
*.bazel text eol=lf
*.bzl text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
go.work text eol=lf
go.work.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-native launchers remain comfortable in cmd.exe and PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The seeds of the fuzz targets that do not read source text are bytes: lists
# of arguments and records separated by NUL, and selector bytes. A line-ending
# conversion would turn one input into another.
/Compiler/Fuzzing/Corpus/cli/** binary
/Compiler/Fuzzing/Corpus/differential/** binary
/Compiler/Fuzzing/Corpus/ownership/** binary
/Compiler/Fuzzing/Corpus/project/** binary
/Compiler/Fuzzing/Corpus/repl/** binary
