module(
    name = "tala",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "fmt", version = "12.1.0")
bazel_dep(name = "catch3", version = "0.2.0")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "indicators", version = "2.3.0")
bazel_dep(name = "tabulate", version = "1.5.0")
# LLVM's release for Windows was built with zlib and zstd but does not ship
# them, nor libxml2; LLD, which talac links in, compresses with zlib and
# zstd and merges Windows manifests with libxml2.
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")
bazel_dep(name = "zstd", version = "1.5.7.bcr.3")

# Neither header-only CLI library is currently published in the Bazel Central
# Registry. Their upstream repositories are pinned as submodules beneath a
# small module wrapper, so normal builds remain local and reproducible.
local_path_override(
    module_name = "indicators",
    path = "third_party/indicators",
)
local_path_override(
    module_name = "tabulate",
    path = "third_party/tabulate",
)

# Catch3 is pinned as a submodule: the Progmasoft test framework is not a
# registry dependency, and the local override keeps native tests reproducible.
local_path_override(
    module_name = "catch3",
    path = "third_party/catch3",
)

# rules_cc 0.2.22 forgets to populate DUMPBIN in its clang-cl branch but reads
# the key unconditionally. Keep the workaround isolated and removable when the
# upstream module ships the same one-line fix.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 0,
    patches = ["//Talac/Build/Bazel:rules_cc_clangcl_dumpbin.patch"],
    version = "0.2.22",
)

# rules_swift reaches the graph through protobuf and rules_apple. Up to 3.4.1
# its Windows autoconfiguration, which runs whenever swiftc.exe is on PATH,
# writes a toolchain that indexes APPLE_PLATFORMS_CONSTRAINTS with an
# undefined name, and every build on such a host fails during analysis.
# 3.4.2 is the first fixed release with the same compatibility level and no
# newer protobuf.
single_version_override(
    module_name = "rules_swift",
    version = "3.4.2",
)

# LLVM is a machine toolchain, not a source dependency. The extension discovers
# it through LLVM_ROOT or llvm-config on PATH and exposes only the components the
# native backend owns.
llvm = use_extension("//Talac/Build/Bazel:llvm.bzl", "llvm")
use_repo(llvm, "llvm")
