load("//Talac/Runtime:host.bzl", "RUNTIME_HOST_DEPS", "RUNTIME_HOST_LINKOPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "interactive_runtime",
    srcs = ["Runtime/History.cpp", "Runtime/ReplInput.cpp", "Runtime/Session.cpp", "Runtime/Source.cpp", "Runtime/Value.cpp"],
    hdrs = ["Runtime/Source.hpp", "Runtime/Value.hpp"],
    # A cell is compiled and run in this process, which therefore holds the
    # runtime its code calls.
    linkopts = RUNTIME_HOST_LINKOPTS,
    deps = [
        "//Talac/Backend/LLVM:llvm_backend",
        "//Talac/Cli/Commands:frontend",
        "//Talac/Driver:pipeline",
        "//Interactive/Headers/Progmasoft/Tala/Interactive:session",
        "//Interactive/Headers/Progmasoft/Tala/Interactive:repl_input",
        "//Talac/Headers/Progmasoft/Tala/Core:scalar",
        "@fmt//:fmt",
    ] + RUNTIME_HOST_DEPS,
)

cc_library(
    name = "interactive_arguments",
    srcs = ["Arguments.cpp"],
    deps = [
        "//Interactive/Headers/Progmasoft/Tala/Interactive:arguments",
        "@fmt//:fmt",
    ],
)

cc_binary(
    name = "tali",
    srcs = ["Main.cpp"],
    deps = [
        ":interactive_arguments",
        ":interactive_runtime",
        "//Talac/Support:compiler_stack",
        "@fmt//:fmt",
    ],
)
